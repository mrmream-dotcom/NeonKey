---
// Shared Articles listing with All | News | Insights | Reviews tabs.
// Tabs are plain links to static pages, so filtering works without JavaScript.
// Layout: newest dated article as a featured story, then the rest grouped by month as a card grid.
// Dates, reading times and images all come from src/data/articles.ts and the article pages themselves.
import { url } from '../config';
import Base from '../layouts/Base.astro';
import FeaturedArticle from './FeaturedArticle.astro';
import ArticleCard from './ArticleCard.astro';
import { articlesIn, sortByDate, dateParts, CATEGORY_LABELS, type Article, type ArticleCategory } from '../data/articles';
interface Props { category?: ArticleCategory }
const { category } = Astro.props;
const list = sortByDate(articlesIn(category));
const tabs: { href: string; label: string; key?: ArticleCategory }[] = [
  { href: '/articles/', label: 'All' },
  { href: '/articles/news/', label: CATEGORY_LABELS.news, key: 'news' },
  { href: '/articles/insights/', label: CATEGORY_LABELS.insights, key: 'insights' },
  { href: '/articles/reviews/', label: CATEGORY_LABELS.reviews, key: 'reviews' },
];
const counts = Object.fromEntries(tabs.map((t) => [t.key ?? 'all', articlesIn(t.key).length]));
const title = category ? `${CATEGORY_LABELS[category]} · Articles` : 'Articles';
const description = category === 'news'
  ? 'NeonKey news: short takes on what changed in automation, AI and small-office tech, with links to the original source.'
  : category === 'insights'
    ? 'NeonKey insights: clear explainers, honest takes and practical advice on automation, AI and small-office tech.'
    : category === 'reviews'
      ? 'NeonKey reviews: honest takes on laptops and other gear for everyday work, with who it suits, the downsides and a plain verdict.'
      : 'NeonKey articles: clear explainers, honest takes and practical advice on automation, AI and small-office tech, whatever your level.';
const intro = category === 'news'
  ? 'Short takes on what changed this week, with a link to the original source.'
  : category === 'insights'
    ? 'Explainers and honest takes on automation, AI and everyday tech.'
    : category === 'reviews'
      ? 'Gear I use or would consider for everyday work: who it suits, the downsides and a verdict.'
      : 'News, explainers and reviews: honest takes on automation, AI and everyday tech, whatever your level.';
const empty = list.length === 0;
const emptyText = category ? `${CATEGORY_LABELS[category]} posts are coming soon.` : 'Articles are coming soon.';


// Featured: the newest dated article. Everything else is grouped by month, newest first; undated posts come last.
const featured = list.find((a) => a.date);
const rest = list.filter((a) => a !== featured);
const groups: { key: string; label: string; items: Article[] }[] = [];
for (const a of rest) {
  const key = a.date ? dateParts(a.date).monthKey : 'undated';
  let g = groups.find((x) => x.key === key);
  if (!g) groups.push((g = { key, label: a.date ? dateParts(a.date).monthYear : 'More articles', items: [] }));
  g.items.push(a);
}
const latest = featured?.date ? dateParts(featured.date) : undefined;
---
<Base title={title} description={description} noindex={empty}>
  <div class="container page-head articles-head">
    <span class="kicker">Articles{category && ` · ${CATEGORY_LABELS[category]}`}</span>
    <h1>{category ? CATEGORY_LABELS[category] : 'Articles'}</h1>
    <p>{intro}</p>
    {!empty && (
      <p class="articles-stats">
        <span><strong>{list.length}</strong> {list.length === 1 ? 'post' : 'posts'}</span>
        {latest && featured && <span>Latest: <time datetime={featured.date}>{latest.long}</time></span>}
      </p>
    )}
  </div>
  <div class="container">
    <nav class="article-tabs" aria-label="Filter articles by category">
      <ul>
        {tabs.map((t) => {
          const active = t.key === category;
          return (
            <li><a class={`article-tab${t.key ? ` tab-${t.key}` : ' tab-all'}`} href={url(t.href)} aria-current={active ? 'page' : undefined}>{t.label} <span class="tab-count">{counts[t.key ?? 'all']}</span></a></li>
          );
        })}
      </ul>
    </nav>
    {empty ? (
      <div class="article-empty">
        <p>{emptyText}</p>
        <a href={url('/articles/')}>See all articles</a>
      </div>
    ) : (
      <div class="articles-body">
        {featured && (
          <section class="article-featured" aria-labelledby="featured-heading">
            <h2 id="featured-heading" class="section-label"><span class="pulse" aria-hidden="true"></span>Latest</h2>
            <FeaturedArticle article={featured} />
          </section>
        )}
        {groups.map((g) => (
          <section class="article-month" aria-labelledby={`month-${g.key}`}>
            <h2 id={`month-${g.key}`} class="month-heading">
              <span>{g.label}</span>
              <span class="month-count">{g.items.length} {g.items.length === 1 ? 'post' : 'posts'}</span>
            </h2>
            <ul class="article-grid">
              {g.items.map((a) => <ArticleCard article={a} />)}
            </ul>
          </section>
        ))}
      </div>
    )}
  </div>
</Base>
