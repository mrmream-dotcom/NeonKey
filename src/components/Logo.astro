---
interface Props { size?: number; withText?: boolean }
const { size = 36, withText = true } = Astro.props;
---
<span class="logo">
  <svg width={size} height={size} viewBox="0 0 64 64" role="img" aria-label="NeonKey logo" class="logo-mark">
    <defs>
      <linearGradient id="nk-grad" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#22d3ee" />
        <stop offset="0.55" stop-color="#a78bfa" />
        <stop offset="1" stop-color="#f472b6" />
      </linearGradient>
    </defs>
    <g fill="none" stroke="url(#nk-grad)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="22" cy="32" r="11" />
      <path d="M33 32h22M47 32v9M54 32v6" />
    </g>
    <circle cx="22" cy="32" r="3.5" fill="#f472b6" />
  </svg>
  {withText && <span class="logo-text">Neon<span>Key</span></span>}
</span>
