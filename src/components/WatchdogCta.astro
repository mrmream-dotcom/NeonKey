---
// "Watch it for me" entry point to Founder Watchdog (src/pages/founders/watchdog/index.astro), a paid product since
// Nov 13 2026. Renders nothing when PUBLIC_WATCHDOG is "off" (src/config.ts). `from` names the touchpoint (WD_FROM in
// src/data/watchdog.ts) and rides along as ?from= for Umami. Inside a DomainCheck "next" slot, DomainCheck adds the
// checked domain to the link (data-wd-link); the sales page ignores it, so it only shows up in analytics.
import { url, WATCHDOG } from '../config';
import { watchdog, type WdFrom } from '../data/watchdog';
import { usd } from '../data/services';
interface Props { from: WdFrom; variant?: 'line' | 'panel'; lead?: string }
const { from, variant = 'line', lead = 'Passing today?' } = Astro.props;
const href = url(`/founders/watchdog/?from=${from}`);
const price = `${usd(watchdog.monthly)}/mo`;
---
{WATCHDOG !== 'off' && <Fragment><style is:inline>   .wd-cta { display: flex; flex-direction: column; gap: .45rem; }   .wd-cta-h { font-size: 1.15rem; margin: 0; }   .wd-cta p, .wd-cta-line { margin: .4rem 0; }   .wd-cta .btn { align-self: flex-start; } </style></Fragment>}
{WATCHDOG !== 'off' && (variant === 'panel' ? (
  <div class="panel topline wd-cta" data-wd-cta>
    <span class="kicker">{watchdog.name} · {price}</span>
    <h2 class="wd-cta-h">Watch it for me</h2>
    <p class="muted">Records change. {watchdog.name} checks your domain every day and emails you when something breaks: email records, mail servers, homepage and renewal date. Cancel anytime.</p>
    <a class="btn btn-ghost btn-sm" href={href} data-wd-link data-umami-event="watchdog-cta" data-umami-event-from={from} data-umami-event-track="founders">See how it works</a>
  </div>
) : (
  <p class="wd-cta-line" data-wd-cta><strong>{lead}</strong> Records change after setup. <a href={href} data-wd-link data-umami-event="watchdog-cta" data-umami-event-from={from} data-umami-event-track="founders">Watch it for me</a>: {watchdog.name} checks your domain daily and emails you if something breaks ({price}, cancel anytime).</p>
))}
