---
// Honest empty state for a section with no published posts yet.
import { url } from '../config';
interface Props { what?: string; location?: string }
const { what = 'posts', location = 'empty-state' } = Astro.props;
---
<div class="empty-state">
  <span class="kicker">Nothing published yet</span>
  <h2>First {what} are on the way</h2>
  <p>Get them in Unlock the Week, the free NeonKey email every Wednesday: one short fix for your tech or your customer follow-up, plus a free guide from Learn.</p>
  <a class="btn btn-primary" href={url('/newsletter/')} data-umami-event="newsletter-cta" data-umami-event-location={location}>Get Unlock the Week</a>
</div>
