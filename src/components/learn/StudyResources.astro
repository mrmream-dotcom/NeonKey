---
// Official link + one-line fine-print disclaimer. The link comes from track.json so an affiliate URL can be swapped in later
// without touching pages. When isAffiliate is true it adds rel="sponsored" and a disclosure line.
import { url } from '../../config';
import track from '../../data/security-plus/track.json';
const l = track.officialLink;
const href = l.isAffiliate && l.affiliateUrl ? l.affiliateUrl : l.url;
const rel = l.isAffiliate ? 'sponsored noopener' : 'noopener';
---
<div class="study-resources">
  <p>Official exam details, objectives and pricing:
    <a href={href} rel={rel} data-umami-event="outbound-click" data-umami-event-item="comptia-security-plus">{l.label}</a>.
    {l.isAffiliate && <span class="muted">(Affiliate link; see our <a href={url('/disclosure/')}>disclosure</a>.)</span>}
  </p>
  <p class="fine-print">NeonKey isn't affiliated with or endorsed by CompTIA. Security+ is a trademark of CompTIA. No pass guarantees — check CompTIA for current exam details.</p>
</div>
<style>
  .study-resources { margin-top: 2.5rem; padding-top: 1rem; border-top: 1px solid var(--line); }
  .study-resources p { margin: 0 0 .5rem; }
  .study-resources .fine-print { font-size: .74rem; line-height: 1.5; color: var(--muted); margin: .25rem 0 0; }
</style>
