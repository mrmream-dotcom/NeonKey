---
// Byline block for an article page: calendar date badge, weekday + full date, author, reading time,
// category badge + topic tag, and (for news) the source link.
import CategoryBadge from './CategoryBadge.astro';
import ArticleDate from './ArticleDate.astro';
import { sourceLabel, dateParts, type Article } from '../data/articles';
import { articleMinutes } from '../lib/reading';
interface Props { article: Article }
const { article } = Astro.props;
const source = sourceLabel(article);
const mins = articleMinutes(article.slug);
const p = article.date ? dateParts(article.date) : undefined;
---
<div class="meta article-byline">
  {article.date && <ArticleDate date={article.date} size="md" />}
  <div class="byline-text">
    <span class="byline-main">
      <span>By <strong>{article.author ?? 'NeonKey'}</strong></span>
      {p && <time datetime={article.date}>{p.weekday}, {p.long}</time>}
      {mins && <span>{mins} min read</span>}
    </span>
    <span class="byline-tags">
      <CategoryBadge category={article.category} />
      {article.topic && <span class="tag">{article.topic}</span>}
      {source && (
        <span class="article-source">Source: <a href={article.sourceUrl} rel="noopener noreferrer" target="_blank" data-umami-event="outbound-click" data-umami-event-item={source}>{source}</a></span>
      )}
    </span>
  </div>
</div>
