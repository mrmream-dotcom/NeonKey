---
// Small, understated row of social icons (Instagram, YouTube, Facebook). Each link has an accessible name.
import { SOCIALS } from '../config';
interface Props { location: string; size?: number; class?: string }
const { location, size = 20, class: cls } = Astro.props;
---
<ul class:list={['social-links', cls]} aria-label="NeonKey on social media">
  {SOCIALS.map((s) => (
    <li>
      <a href={s.url} rel="me noopener" target="_blank" aria-label={`NeonKey on ${s.label}`} title={s.label} data-umami-event="outbound-click" data-umami-event-item={s.id} data-umami-event-location={location}>
        <svg viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" focusable="false">
          {s.id === 'instagram' && <g fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4.2" /><circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none" /></g>}
          {s.id === 'youtube' && <><rect x="2" y="5" width="20" height="14" rx="4.5" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M10 9.2v5.6l4.8-2.8z" fill="currentColor" /></>}
          {s.id === 'facebook' && <path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4a21 21 0 0 0-2.3-.1c-2.3 0-3.9 1.4-3.9 4v2.2H8v3h2.4V21z" fill="currentColor" />}
        </svg>
      </a>
    </li>
  ))}
</ul>
