---
// Article card / featured thumbnail: the article's hero image when it has one, otherwise a branded fallback.
// Thin wrapper around the general MediaThumb component.
import MediaThumb from './MediaThumb.astro';
import { CATEGORY_LABELS, type Article } from '../data/articles';
interface Props { article: Article; eager?: boolean; sizes?: string }
const { article: a, eager = false } = Astro.props;
---
<MediaThumb class={`thumb-${a.category}`} image={a.image} alt={a.imageAlt} width={a.imageWidth} height={a.imageHeight}
  label={a.topic ?? CATEGORY_LABELS[a.category]} eager={eager}><slot /></MediaThumb>
