---
// $49 Email Lockdown entry offer: buy online, no call. The $49 is credited toward any larger package or setup
// (Michael, Nov 4 2026 8:19 PM AKST: "we'll take the 49 off any package"). Shown on the homepage and services page.
import { url } from '../config';
import { emailLockdown, lockdownCredit, usd } from '../data/services';
interface Props { location: string }
const { location } = Astro.props;
---
<aside class="card topline accent-magenta lockdown-strip" aria-label="Email Lockdown">
  <div class="ls-text">
    <span class="kicker">Start small · buy online · no call</span>
    <p class="ls-title"><strong>{emailLockdown.name}, {usd(emailLockdown.from)} flat.</strong> Make it harder for scammers to send email pretending to be you.</p>
    <p class="muted ls-note">{lockdownCredit}</p>
  </div>
  <div class="btn-row ls-btns">
    <a class="btn btn-primary btn-sm" href={emailLockdown.buyUrl} rel="noopener" data-umami-event="buy-click" data-umami-event-offer={emailLockdown.name} data-umami-event-location={location}>Buy now · {usd(emailLockdown.from)}</a>
    <a class="btn btn-ghost btn-sm" href={url('/services/email-lockdown/')} data-umami-event="services-cta" data-umami-event-offer={emailLockdown.name} data-umami-event-location={location}>Details</a>
  </div>
</aside>

<style>
  .lockdown-strip { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 1.25rem; }
  .ls-text { flex: 1 1 22rem; min-width: 0; }
  .ls-title { margin: .25rem 0; color: var(--text); }
  .ls-note { margin: 0; font-size: .9rem; }
  .ls-btns { flex: 0 0 auto; margin: 0; }
</style>
