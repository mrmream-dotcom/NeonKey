---
// Static redirect page (GitHub Pages has no server-side redirects): meta refresh + canonical, always noindex.
import { url, absoluteUrl } from '../config';
interface Props { to: string }
const { to } = Astro.props;
const target = url(to);
const canonical = absoluteUrl(to, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Moved | NeonKey</title>
    <link rel="canonical" href={canonical} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <p>This page has moved to <a href={target}>{canonical}</a>.</p>
  </body>
</html>
