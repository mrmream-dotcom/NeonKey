---
import { url, CONTACT_EMAIL, INSTAGRAM_URL, FREE_KIT_FILE } from '../../config';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
---
<Base title="Check your inbox" description="Thanks for subscribing to Unlock the Week. Download your free Starter IT Kit and confirm your email to start receiving it." noindex>
  <PageHeader width="narrow" align="center" eyebrow="Unlock the Week · Step 1 of 2" crumbs={[{ href: '/', label: 'Home' }, { href: '/newsletter/', label: 'Newsletter' }, { label: 'Check your inbox' }]} class="status-head">
    <span class="status-mark" slot="title-before"><Icon name="mail" /></span>
    <Fragment slot="title">Almost there. Check your inbox.</Fragment>
    <p class="lede">Thanks for subscribing. We just sent a confirmation email. Open it and click <strong>Confirm my subscription</strong> to start getting Unlock the Week.</p>
  </PageHeader>
  <div class="narrow status-body">
    <div class="panel topline accent-cyan">
      <h2 class="panel-title">Your free Starter IT Kit is ready</h2>
      <p>As a thank-you for signing up, here's the NeonKey Starter IT Kit, our free IT setup guide. One spreadsheet: a short "Start here" guide with five quick wins, a list of every account your business signs into, and a 10-minute monthly checkup. Works in Excel and Google Sheets.</p>
      <p style="margin-bottom:0"><a class="btn btn-primary" href={url(FREE_KIT_FILE)} download data-umami-event="nl-thanks-kit">Download the free IT kit</a> <a class="btn btn-ghost" href={url('/free-it-kit/')} data-umami-event="nl-thanks-kit-more">What's inside</a></p>
    </div>
    <div class="panel topline">
      <h2 class="panel-title">Don't see the confirmation email?</h2>
      <ul class="status-steps">
        <li>Give it a minute or two, then check your Spam or Promotions folder.</li>
        <li>Make sure the address you entered was spelled correctly. If not, just <a href={url('/newsletter/')}>sign up again</a>.</li>
        <li>Still nothing? Email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> and we'll sort it out.</li>
      </ul>
    </div>
    <p class="status-actions"><a class="btn btn-ghost" href={url('/')} data-umami-event="nl-thanks-home">Back to NeonKey</a> <a class="btn btn-ghost" href={INSTAGRAM_URL} rel="me noopener" target="_blank" data-umami-event="outbound-click" data-umami-event-item="instagram" data-umami-event-location="nl-thanks">Follow us on Instagram</a></p>
  </div>
  <!-- Google Ads "Sign-up" conversion (newsletter signup), only after a real submit in this tab. External file: no inline scripts. -->
  <script is:inline src={url('/js/conv-newsletter.js')}></script>
  <!-- Meta and Reddit pixels: Lead / SignUp event for the newsletter ad test. -->
  <script is:inline src={url('/js/ad-pixels.js')}></script>
</Base>
