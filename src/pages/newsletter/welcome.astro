---
import { url, CONTACT_EMAIL, FREE_KIT_FILE } from '../../config';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
---
<Base title="You're in" description="Your Unlock the Week subscription is confirmed." noindex>
  <PageHeader width="narrow" align="center" eyebrow="Unlock the Week · Confirmed" crumbs={[{ href: '/', label: 'Home' }, { href: '/newsletter/', label: 'Newsletter' }, { label: 'Welcome' }]} class="status-head">
    <span class="status-mark" slot="title-before"><Icon name="check" /></span>
    <Fragment slot="title">You're in. Welcome to Unlock the Week.</Fragment>
    <p class="lede">Your subscription is confirmed. Thanks for joining.</p>
  </PageHeader>
  <div class="narrow status-body">
    <div class="panel topline">
      <h2 class="panel-title">What to expect</h2>
      <ul class="status-steps">
        <li><strong>One email every Wednesday</strong>, about a one-minute read.</li>
        <li><strong>One fix</strong> you can do in a few minutes: keep your tech secure, or catch more of the customers who reach out.</li>
        <li><strong>A free guide from Learn</strong> when it fits the topic.</li>
        <li><strong>A P.S. with a question.</strong> Hit reply anytime; every reply gets read.</li>
      </ul>
      <p style="margin-bottom:0">No spam, and you can unsubscribe anytime from the link at the bottom of any email.</p>
    </div>
    <div class="panel topline accent-cyan">
      <h2 class="panel-title">Your free Starter IT Kit</h2>
      <p>If you didn't grab it when you signed up, here it is: our free IT setup guide in one spreadsheet, with five quick wins, an accounts list and a 10-minute monthly checkup. Excel or Google Sheets.</p>
      <p style="margin-bottom:0"><a class="btn btn-primary" href={url(FREE_KIT_FILE)} download data-umami-event="nl-welcome-kit">Download the free IT kit</a></p>
    </div>
    <div class="panel topline accent-magenta">
      <h2 class="panel-title">Another bonus: the One-Minute Fix List</h2>
      <p style="margin-bottom:0">Watch for the welcome email from NeonKey and reply "yes" to it. We'll send the One-Minute Fix List: 12 small fixes for your business tech and customer follow-up, on one page. Or email <a href={`mailto:${CONTACT_EMAIL}?subject=Yes%2C%20send%20the%20Fix%20List&body=Yes`} data-umami-event="nl-welcome-reply">{CONTACT_EMAIL}</a> with "yes".</p>
      <p class="muted" style="margin-top:.75rem;margin-bottom:0">NeonKey</p>
    </div>
    <p class="status-actions"><a class="btn btn-ghost" href={url('/')}>Explore NeonKey</a></p>
  </div>
</Base>
