---
import { url } from '../config';
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FeaturedArticle from '../components/FeaturedArticle.astro';
import ArticleCard from '../components/ArticleCard.astro';
import LabCard from '../components/LabCard.astro';
import { articlesIn, sortByDate } from '../data/articles';
import NewsletterForm from '../components/NewsletterForm.astro';
import { publishedLabProjects } from '../data/lab';
import { remoteIt, remoteSupportPlan, automationOffers, frontOfficePackage as fop, introPricing, usd } from '../data/services';
import { absoluteUrl, CONTACT_EMAIL, INSTAGRAM_URL, INSTAGRAM_HANDLE, YOUTUBE_URL, SOCIALS } from '../config';
const latestArticles = sortByDate(articlesIn());
const leadStory = latestArticles.find((a) => a.date);
const moreStories = latestArticles.filter((a) => a !== leadStory).slice(0, 3);
const quickWin = automationOffers.find((o) => o.slug === 'quick-win')!;
const aiFaq = automationOffers.find((o) => o.slug === 'ai-faq')!;
const pillars = [
  { cls: 'c', title: 'Unlock AI', href: '/services/', link: 'See services', text: 'Practical automations and remote small-office IT setup for small businesses. Clear setup and handoff.',
    icon: '<path d="M12 3v3M12 18v3M3 12h3M18 12h3M6 6l2 2M16 16l2 2M6 18l2-2M16 8l2-2"/><circle cx="12" cy="12" r="3"/>' },
  { cls: 'm', title: 'Unlock Deals', href: '/reviews/', link: 'Read reviews', text: 'Honest takes on gear and software worth your money, with pros, cons and a plain verdict.',
    icon: '<path d="M20 12l-8 8-9-9V3h8z"/><circle cx="7.5" cy="7.5" r="1.5"/>' },
  { cls: 'v', title: 'Unlock Skills', href: '/learn/', link: 'Start learning', text: 'Plain-language guides for learning tech, starting with a free CompTIA Security+ study guide. Beginner-friendly, no gatekeeping.',
    icon: '<path d="M4 19V5a2 2 0 0 1 2-2h12v16H6a2 2 0 0 0-2 2z"/><path d="M8 7h6M8 11h6"/>' },
  { cls: 'y', title: 'Unlock the Week', href: '/newsletter/', link: 'Get the newsletter', text: 'A weekly email with one tech story explained simply, a skill tip, gear picks and something to learn.',
    icon: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>' },
];
// JSON-LD structured data (one @graph). Prices and service text come from src/data/services.ts.
const abs = (p: string) => absoluteUrl(p, Astro.site);
const home = abs('/');
const orgId = `${home}#organization`;
const usArea = { '@type': 'Country', name: 'United States' };
const serviceNode = (o: typeof remoteIt, offerPath: string, monthly = false) => ({
  '@type': 'Service',
  '@id': `${home}#service-${o.slug}`,
  name: o.name,
  description: o.for,
  url: abs(offerPath),
  provider: { '@id': orgId },
  areaServed: usArea,
  offers: {
    '@type': 'Offer',
    url: abs(offerPath),
    price: o.from,
    priceCurrency: 'USD',
    priceSpecification: {
      '@type': monthly ? 'UnitPriceSpecification' : 'PriceSpecification',
      price: o.from,
      minPrice: o.from,
      priceCurrency: 'USD',
      ...(monthly ? { unitCode: 'MON', unitText: 'month' } : {}),
      description: monthly ? 'Starting monthly price; final price agreed before you start' : 'Starting price; fixed quote after a scoping call',
    },
  },
});
const leadRouting = automationOffers.find((o) => o.slug === 'lead-routing')!;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${home}#website`,
      url: home,
      name: 'NeonKey',
      description: 'Practical AI automations, honest gear picks, hands-on tutorials, Lab builds and a weekly tech email for beginners and builders.',
      inLanguage: 'en',
      publisher: { '@id': orgId },
    },
    {
      '@type': 'Organization',
      '@id': orgId,
      name: 'NeonKey',
      url: home,
      logo: abs('/icon-512.png'),
      email: CONTACT_EMAIL,
      sameAs: SOCIALS.map((s) => s.url),
      description: 'NeonKey helps beginners and builders get more out of tech through practical AI automations, remote small-office IT services, honest gear picks, hands-on tutorials and a weekly email.',
      founder: { '@type': 'Person', name: 'Michael Ream', url: abs('/about/') },
      areaServed: usArea,
      knowsAbout: ['AI automation', 'Small-office IT setup', 'Cybersecurity basics', 'Technology tutorials', 'Computer hardware and software'],
    },
    {
      '@type': 'WebPage',
      '@id': `${home}#webpage`,
      url: home,
      name: 'NeonKey: Office IT Setup and AI Automation for Small Businesses',
      headline: 'Office IT and practical AI for small businesses.',
      description: 'Office IT setup, security basics and practical AI automation for small businesses, on-site in Fairbanks and North Pole, Alaska and remote across the US. Plus free guides, Lab demos and a weekly email.',
      inLanguage: 'en',
      isPartOf: { '@id': `${home}#website` },
      about: { '@id': orgId },
      publisher: { '@id': orgId },
      mainEntity: { '@id': `${home}#sections` },
      potentialAction: [
        { '@type': 'SubscribeAction', target: abs('/newsletter/'), object: { '@id': `${home}#unlock-the-week` } },
      ],
    },
    {
      '@type': 'ItemList',
      '@id': `${home}#sections`,
      name: 'NeonKey content and services',
      itemListElement: pillars.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.title, url: abs(p.href) })),
    },
    {
      '@type': 'CreativeWorkSeries',
      '@id': `${home}#unlock-the-week`,
      name: 'Unlock the Week',
      url: abs('/newsletter/'),
      description: 'A free weekly email with one tech story explained simply, a skill tip, gear picks and something to learn.',
      inLanguage: 'en',
      publisher: { '@id': orgId },
      isAccessibleForFree: true,
    },
    serviceNode(remoteIt, '/services/remote-it/'),
    serviceNode(remoteSupportPlan, '/services/remote-it/#support-plan', true),
    serviceNode(quickWin, '/services/#quick-win'),
    serviceNode(aiFaq, '/services/#ai-faq'),
    serviceNode(leadRouting, '/services/#lead-routing'),
    {
      '@type': 'SoftwareApplication',
      '@id': `${home}#ai-inquiry-triage`,
      name: 'AI Inquiry Triage (demo)',
      url: abs('/lab/ai-inquiry-triage/'),
      description: 'A working AI demo that sorts a customer message, flags urgency, pulls out key details and drafts a reply for a human to review.',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web browser',
      creator: { '@id': orgId },
      offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD' },
    },
  ],
};
const jsonLdHtml = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
// Tutorials and reviews have no published posts yet (drafts live in src/_drafts/, see LAUNCH.md),
// so the home page shows one short teaser instead of empty grids. The Lab section returns on its own once a project is published.
---
<Base title="Home" description="Office IT setup, security basics and practical AI automation for small businesses, on-site in Fairbanks and North Pole, Alaska and remote across the US. Plus free guides, Lab demos and a weekly email.">
  <script type="application/ld+json" is:inline set:html={jsonLdHtml}></script>
  <section class="hero hero-bg">
    <div class="hero-art" aria-hidden="true">
      <svg viewBox="0 0 320 320" width="320" height="320" focusable="false">
        <defs>
          <linearGradient id="hg" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#22d3ee"/><stop offset=".55" stop-color="#a78bfa"/><stop offset="1" stop-color="#f472b6"/>
          </linearGradient>
        </defs>
        <circle cx="160" cy="160" r="150" fill="none" stroke="#262b52" stroke-width="1.5"/>
        <circle cx="160" cy="160" r="118" fill="none" stroke="#262b52" stroke-dasharray="4 8"/>
        <g fill="none" stroke="url(#hg)" stroke-width="12" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="112" cy="160" r="40"/>
          <path d="M152 160h104M224 160v30M252 160v20"/>
        </g>
        <circle cx="112" cy="160" r="12" fill="#f472b6"/>
      </svg>
    </div>
    <div class="container hero-content">
      <span class="kicker">Unlock tech, whatever your level</span>
      <h1>Office IT and <span class="glow">practical AI</span><br /> for <span class="glow-m">small businesses.</span></h1>
      <p class="lead">Fixed-scope setups, security basics and AI intake tools, built on accounts you own. On-site in Fairbanks and North Pole, Alaska. Remote anywhere in the US.</p>
      <div class="btn-row hero-ctas">
        <a class="btn btn-primary" href={url('/contact/')} data-umami-event="contact-click" data-umami-event-location="home-hero">Get a free quote</a>
        <a class="btn btn-alt" href={url('/services/')} data-umami-event="services-cta" data-umami-event-location="home-hero">See services and prices</a>
      </div>
      <p class="hero-proof">CIAT-certified technician · Written quote before any work · You keep every login · <a href={url('/lab/')} data-umami-event="lab-cta" data-umami-event-location="home-hero">Live demos in the Lab</a></p>
      <p class="hero-sub-links">Just here to learn? <a href={url('/learn/')}>Free guides</a>, <a href={url('/lab/')}>Lab demos</a> and <a href={url('/newsletter/')} data-umami-event="newsletter-cta" data-umami-event-location="home-hero">the weekly email</a> are all free →</p>
    </div>
  </section>

  <section class="alt" aria-labelledby="svc-h">
    <div class="container">
      <SectionHeading id="svc-h" eyebrow="Services" title="Three ways to start" intro="Pick the one that matches your office. Every project is scoped on a short call and quoted in writing before any work begins." link={{ href: '/services/', label: 'All services and prices', attrs: { 'data-umami-event': 'services-cta', 'data-umami-event-location': 'home-services' } }} />
      <div class="grid grid-3 home-offers">
        <article class="card topline accent-cyan">
          <span class="kicker">On-site · Fairbanks and North Pole · $249</span>
          <h3><a href={url('/local/')} data-umami-event="services-cta" data-umami-event-location="home-local">Office Tech Tune-Up</a></h3>
          <p class="offer-outcome">We come to your office and check and fix the basics in one visit.</p>
          <p class="home-offer-sub">One visit covers:</p>
          <ul class="home-offer-list">
            <li>Wi-Fi and router: passwords, updates, a separate guest network</li>
            <li>Backups confirmed and a restore tested</li>
            <li>2-step sign-in on email and key accounts</li>
            <li>Email records fixed so scammers can't fake your address</li>
            <li>Printers and slow computers sorted out</li>
            <li>A one-page report of what we fixed and what's next</li>
          </ul>
          <p class="home-offer-note">Evening and Saturday times. In Alaska's Interior only; everyone else, see the remote setup. <a href={url('/local/')}>Full details →</a></p>
        </article>
        <article class="card offer-featured topline">
          <span class="kicker">AI and automation · Starting at {usd(quickWin.from)}</span>
          <h3><a href={url('/services/#quick-win')} data-umami-event="services-cta" data-umami-event-location="home-quick-win">{quickWin.name}</a></h3>
          <p class="offer-outcome">We take one boring, repeat task off your plate and set it up to run on its own.</p>
          <p class="home-offer-sub">Some examples of what we can automate:</p>
          <ul class="home-offer-list">
            <li>New website messages saved to a spreadsheet, with an email alert so you never miss one</li>
            <li>An instant "we got your message" reply to every new customer inquiry</li>
            <li>Incoming emails sorted and labeled, so urgent ones stand out</li>
            <li>Receipts and invoices filed in folders, with the totals added to a spreadsheet</li>
            <li>Reminder emails sent to customers the day before their appointment</li>
            <li>A weekly summary of new leads or orders sent to your inbox</li>
          </ul>
          <p class="home-offer-note">Plus a quick check of your passwords, backups and Wi-Fi, and a short to-do list of the fixes that matter most. <a href={url('/lab/')}>See working demos in the Lab →</a></p>
        </article>
        <article class="card topline accent-magenta">
          <span class="kicker">Remote · Anywhere in the US · Starting at {usd(remoteIt.from)}</span>
          <h3><a href={url('/services/remote-it/')} data-umami-event="services-cta" data-umami-event-location="home-remote-it">Remote Small-Office IT Setup</a></h3>
          <p class="offer-outcome">We get your office tech set up properly, all done remotely.</p>
          <p class="home-offer-sub">What that covers:</p>
          <ul class="home-offer-list">
            <li>A professional email address with your business name (you@yourbusiness.com)</li>
            <li>Settings that help your emails stay out of spam and stop scammers pretending to be you</li>
            <li>Safer Wi-Fi: new passwords, router updates and a separate network for guests</li>
            <li>Automatic backups of your important files, tested so you know they work</li>
            <li>A password manager for your team, plus a code on your phone for signing in to key accounts</li>
            <li>Simple checklists for setting up a new laptop or phone, and for when someone leaves</li>
          </ul>
          <p class="home-offer-note">Done over video and screen share. You keep every login, and you get notes on everything we changed. <a href={url('/services/remote-it/')}>Full details →</a></p>
        </article>
      </div>
      <article class="card topline accent-magenta fop-strip" id="front-office">
        <div>
          <span class="kicker">Best deal · All-inclusive</span>
          <h3 style="margin:.3rem 0"><a href={url('/services/#front-office-package')} data-umami-event="services-cta" data-umami-event-location="home-package">{fop.name}</a></h3>
          <p class="muted" style="margin:0">{fop.for}. AI intake and FAQ assistant, lead routing and follow-up, email lockdown and three months of the support plan, in one project.</p>
        </div>
        <div class="fop-strip-side">
          <p class="price" style="margin:0">{usd(fop.from)}<small>{usd(fop.value)}+ value · founding-client rate</small></p>
          <a class="btn btn-primary btn-sm" href={url(`/contact/?topic=${fop.slug}`)} data-umami-event="contact-click" data-umami-event-offer={fop.name} data-umami-event-location="home-package">Ask about the package</a>
        </div>
      </article>
      <p class="intro-pricing" role="note" style="margin-top:1.25rem"><strong>{introPricing.label}.</strong> {introPricing.note}</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={url('/contact/')} data-umami-event="contact-click" data-umami-event-location="home-services">Get in touch</a>
        <a class="btn btn-ghost" href={url('/services/')} data-umami-event="services-cta" data-umami-event-location="home-services-btn">See all services</a>
      </div>
      <p class="muted" style="margin-top:1rem;font-size:.92rem">Prices are starting points; every project is scoped first. More services, like a monthly support plan, an AI assistant for your FAQs and lead follow-up, are on the services page. Results depend on your business and tools.</p>
    </div>
  </section>

  <section aria-labelledby="how-h">
    <div class="container">
      <SectionHeading id="how-h" eyebrow="How it works" title="Scoped, built after hours, handed over to you" />
      <ol class="step-cards">
        <li><strong>Scope:</strong> a short call to agree on what "done" looks like. You get a written quote before any work starts.</li>
        <li><strong>Build:</strong> setup and changeovers happen after 4 PM Alaska time or on weekends, so your staff don't lose a working hour.</li>
        <li><strong>Check:</strong> we test it with you on screen: email records, sign-ins, a backup restore.</li>
        <li><strong>Hand off:</strong> every account is created in your name. You get notes and a walkthrough, and you can switch off our access.</li>
      </ol>
    </div>
  </section>

  {publishedLabProjects.length > 0 && (
  <section aria-labelledby="lab-h">
    <div class="container">
      <SectionHeading id="lab-h" eyebrow="The Lab" title="From the Lab" intro="Working demos you can try right now: what I built, why, the results and lessons, and what I'd do differently." link={{ href: '/lab/', label: 'All builds', attrs: { 'data-umami-event': 'lab-cta', 'data-umami-event-location': 'home' } }} />
      <ul class="article-grid">
        {publishedLabProjects.map((p) => <LabCard project={p} as="li" />)}
      </ul>
    </div>
  </section>
  )}

  <section class="alt" aria-labelledby="pillars-h">
    <div class="container">
      <SectionHeading id="pillars-h" eyebrow="Free from NeonKey" title="Four ways to unlock" intro="Here to learn, not to hire? This part of NeonKey is free for everyone: guides, honest reviews, Lab builds and a weekly email." />
      <div class="grid grid-4">
        {pillars.map((p, i) => (
          <article class={`card pillar topline ${p.cls}`}>
            <span class="num-eyebrow pillar-num">{String(i + 1).padStart(2, '0')}</span>
            <div class="icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={p.icon} /></div>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
            <a href={url(p.href)}>{p.link} →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  {leadStory && (
  <section class="home-latest" aria-labelledby="latest-h">
    <div class="container">
      <SectionHeading id="latest-h" eyebrow="Articles" title="Latest from NeonKey" intro="News, explainers and reviews, newest first." link={{ href: '/articles/', label: 'All articles' }} />
      <FeaturedArticle article={leadStory} eager={false} />
      {moreStories.length > 0 && (
        <ul class="article-grid">
          {moreStories.map((a) => <ArticleCard article={a} />)}
        </ul>
      )}
    </div>
  </section>
  )}

  <section class="alt" aria-labelledby="who-h">
    <div class="container">
      <article class="card who-card topline accent-violet">
        <svg class="who-mark" width="64" height="64" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
          <defs>
            <linearGradient id="who-grad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#22d3ee" /><stop offset="0.55" stop-color="#a78bfa" /><stop offset="1" stop-color="#f472b6" />
            </linearGradient>
          </defs>
          <g fill="none" stroke="url(#who-grad)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="22" cy="32" r="11" />
            <path d="M33 32h22M47 32v9M54 32v6" />
          </g>
          <circle cx="22" cy="32" r="3.5" fill="#f472b6" />
        </svg>
        <div>
          <span class="kicker eyebrow">Who does the work</span>
          <h2 id="who-h" style="font-size:1.35rem;margin:.3rem 0 .5rem">Michael Ream</h2>
          <p>NeonKey is run by me, Michael Ream, and I do the client work myself. I've spent years working hands-on in tech, setting up, maintaining and troubleshooting networks and communication systems. I hold a Computer Installation and Repair Technician certificate from the California Institute of Applied Technology, and I'm now pursuing an Applied Bachelor's Degree in Cybersecurity there, earning an associate degree in Computer Information Systems along the way. I've also worked hands-on in Microsoft Azure, building virtual machines and virtual networks and organizing resource groups.</p>
          <p style="margin-bottom:0">For clients, that means small-office setups done properly: business email that's less likely to land in spam and harder for scammers to fake, Wi-Fi, backups and passwords locked down, and small automations you fully own. <a href={url('/about/')}>More about me →</a></p>
        </div>
      </article>
    </div>
  </section>

  <section aria-labelledby="nl-h">
    <div class="container">
      <p class="home-teaser" id="first-posts">Tutorials, Lab builds, reviews and articles: <strong>more posts are on the way.</strong> Get them in <strong>Unlock the Week</strong>, the free weekly email.</p>
      <div class="nl-box topline">
        <span class="kicker eyebrow">Newsletter · Weekly</span>
        <h2 id="nl-h">Unlock the Week</h2>
        <p class="muted">One tech story in everyday language, a skill tip, gear picks and something to learn, once a week. No spam; unsubscribe anytime.</p>
        <NewsletterForm id="home-nl" />
      </div>
    </div>
  </section>

  <section aria-labelledby="lip-h">
    <div class="narrow">
      <div class="callout final-cta">
        <h2 id="lip-h" style="font-size:1.35rem">Built and documented in the open</h2>
        <p>I'm Michael Ream, and NeonKey is where I build, test and document as I go: homelab projects, AI automations and small-office IT setups. You'll see the results and lessons, including what I'd do differently. <a href={url('/about/')}>More about NeonKey →</a></p>
        <p style="margin-bottom:0">Have a tech task you'd like off your plate? Tell us what's going on and we'll send a free quote.</p>
        <div class="btn-row" style="margin-top:1rem">
          <a class="btn btn-primary" href={url('/contact/')} data-umami-event="contact-click" data-umami-event-location="home-final">Get a free quote</a>
          <a class="btn btn-ghost" href={INSTAGRAM_URL} rel="me noopener" target="_blank" data-umami-event="outbound-click" data-umami-event-item="instagram" data-umami-event-location="home-final">Follow {INSTAGRAM_HANDLE}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .home-offers .home-offer-sub { margin: .6rem 0 .3rem; font-weight: 600; color: var(--text); }
  .home-offer-list { margin: 0 0 .8rem; padding-left: 1.15rem; display: grid; gap: .35rem; }
  .home-offer-note { font-size: .95rem; margin: 0; }
  .fop-strip { margin-top: 1.25rem; display: grid; grid-template-columns: 1fr auto; gap: 1rem 2rem; align-items: center; }
  .fop-strip-side { display: grid; gap: .6rem; justify-items: start; }
  .fop-strip .price small { display: block; font-size: .85rem; }
  @media (max-width: 760px) { .fop-strip { grid-template-columns: 1fr; } }
  .hero-proof { margin: .9rem 0 0; font-size: .92rem; color: var(--muted); }
  .hero-proof a { color: inherit; text-decoration: underline; }
  .who-card { display: grid; grid-template-columns: auto 1fr; gap: 1.25rem 1.5rem; align-items: start; }
  .who-card p + p { margin-top: .75rem; }
  .who-mark { flex-shrink: 0; filter: drop-shadow(0 0 12px rgba(167,139,250,.45)); }
  @media (max-width: 640px) { .who-card { grid-template-columns: 1fr; } }
</style>
