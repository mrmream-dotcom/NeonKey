---
import { url } from '../config';
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { publishedLabProjects } from '../data/lab';
import { remoteIt, remoteSupportPlan, automationOffers, introPricing, usd } from '../data/services';
import { absoluteUrl, CONTACT_EMAIL } from '../config';
const quickWin = automationOffers.find((o) => o.slug === 'quick-win')!;
const aiFaq = automationOffers.find((o) => o.slug === 'ai-faq')!;
const pillars = [
  { cls: 'c', title: 'Unlock AI', href: '/services/', link: 'See services', text: 'Practical automations and remote small-office IT setup for small businesses. Plain-English setup and handoff.',
    icon: '<path d="M12 3v3M12 18v3M3 12h3M18 12h3M6 6l2 2M16 16l2 2M6 18l2-2M16 8l2-2"/><circle cx="12" cy="12" r="3"/>' },
  { cls: 'm', title: 'Unlock Deals', href: '/reviews/', link: 'Read reviews', text: 'Honest takes on gear and software worth your money, with pros, cons and a plain verdict.',
    icon: '<path d="M20 12l-8 8-9-9V3h8z"/><circle cx="7.5" cy="7.5" r="1.5"/>' },
  { cls: 'v', title: 'Unlock Skills', href: '/learn/', link: 'Start learning', text: 'Plain-language guides for learning tech, starting with a free CompTIA Security+ study guide. Beginner-friendly, no gatekeeping.',
    icon: '<path d="M4 19V5a2 2 0 0 1 2-2h12v16H6a2 2 0 0 0-2 2z"/><path d="M8 7h6M8 11h6"/>' },
  { cls: 'y', title: 'Unlock the Week', href: '/newsletter/', link: 'Get the newsletter', text: 'A weekly email with one tech story in plain English, a skill tip, gear picks and something to learn.',
    icon: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>' },
];
// JSON-LD structured data (one @graph). Prices and service text come from src/data/services.ts.
const abs = (p: string) => absoluteUrl(p, Astro.site);
const home = abs('/');
const orgId = `${home}#organization`;
const usArea = { '@type': 'Country', name: 'United States' };
const serviceNode = (o: typeof remoteIt, offerPath: string, monthly = false) => ({
  '@type': 'Service',
  '@id': `${home}#service-${o.slug}`,
  name: o.name,
  description: o.for,
  url: abs(offerPath),
  provider: { '@id': orgId },
  areaServed: usArea,
  offers: {
    '@type': 'Offer',
    url: abs(offerPath),
    price: o.from,
    priceCurrency: 'USD',
    priceSpecification: {
      '@type': monthly ? 'UnitPriceSpecification' : 'PriceSpecification',
      price: o.from,
      minPrice: o.from,
      priceCurrency: 'USD',
      ...(monthly ? { unitCode: 'MON', unitText: 'month' } : {}),
      description: monthly ? 'Starting monthly price; final price agreed before you start' : 'Starting price; fixed quote after a scoping call',
    },
  },
});
const leadRouting = automationOffers.find((o) => o.slug === 'lead-routing')!;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${home}#website`,
      url: home,
      name: 'NeonKey',
      description: 'Practical AI automations, honest gear picks, hands-on tutorials, Lab builds and a weekly tech email for beginners and builders.',
      inLanguage: 'en',
      publisher: { '@id': orgId },
    },
    {
      '@type': 'Organization',
      '@id': orgId,
      name: 'NeonKey',
      url: home,
      logo: abs('/icon-512.png'),
      email: CONTACT_EMAIL,
      description: 'NeonKey helps beginners and builders get more out of tech through practical AI automations, remote small-office IT services, honest gear picks, hands-on tutorials and a weekly email.',
      founder: { '@type': 'Person', name: 'Michael Ream', url: abs('/about/') },
      areaServed: usArea,
      knowsAbout: ['AI automation', 'Small-office IT setup', 'Cybersecurity basics', 'Technology tutorials', 'Computer hardware and software'],
    },
    {
      '@type': 'WebPage',
      '@id': `${home}#webpage`,
      url: home,
      name: 'NeonKey: Unlock tech, whatever your level',
      headline: 'Unlock tech, whatever your level.',
      description: 'NeonKey helps beginners and builders get more out of tech: practical AI automations, honest gear picks, hands-on tutorials, Lab builds and a weekly email.',
      inLanguage: 'en',
      isPartOf: { '@id': `${home}#website` },
      about: { '@id': orgId },
      publisher: { '@id': orgId },
      mainEntity: { '@id': `${home}#sections` },
      potentialAction: [
        { '@type': 'SubscribeAction', target: abs('/newsletter/'), object: { '@id': `${home}#unlock-the-week` } },
      ],
    },
    {
      '@type': 'ItemList',
      '@id': `${home}#sections`,
      name: 'NeonKey content and services',
      itemListElement: pillars.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.title, url: abs(p.href) })),
    },
    {
      '@type': 'CreativeWorkSeries',
      '@id': `${home}#unlock-the-week`,
      name: 'Unlock the Week',
      url: abs('/newsletter/'),
      description: 'A free weekly email with one tech story in plain English, a skill tip, gear picks and something to learn.',
      inLanguage: 'en',
      publisher: { '@id': orgId },
      isAccessibleForFree: true,
    },
    serviceNode(remoteIt, '/services/remote-it/'),
    serviceNode(remoteSupportPlan, '/services/remote-it/#support-plan', true),
    serviceNode(quickWin, '/services/#quick-win'),
    serviceNode(aiFaq, '/services/#ai-faq'),
    serviceNode(leadRouting, '/services/#lead-routing'),
    {
      '@type': 'SoftwareApplication',
      '@id': `${home}#ai-inquiry-triage`,
      name: 'AI Inquiry Triage (demo)',
      url: abs('/lab/ai-inquiry-triage/'),
      description: 'A working AI demo that sorts a customer message, flags urgency, pulls out key details and drafts a reply for a human to review.',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web browser',
      creator: { '@id': orgId },
      offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD' },
    },
  ],
};
const jsonLdHtml = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
// Tutorials and reviews have no published posts yet (drafts live in src/_drafts/, see LAUNCH.md),
// so the home page shows one short teaser instead of empty grids. The Lab section returns on its own once a project is published.
---
<Base title="Home" description="NeonKey helps beginners and builders get more out of tech: practical AI automations, honest gear picks, hands-on tutorials, Lab builds and a weekly email.">
  <script type="application/ld+json" is:inline set:html={jsonLdHtml}></script>
  <section class="hero hero-bg">
    <div class="hero-art" aria-hidden="true">
      <svg viewBox="0 0 320 320" width="320" height="320" focusable="false">
        <defs>
          <linearGradient id="hg" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#22d3ee"/><stop offset=".55" stop-color="#a78bfa"/><stop offset="1" stop-color="#f472b6"/>
          </linearGradient>
        </defs>
        <circle cx="160" cy="160" r="150" fill="none" stroke="#262b52" stroke-width="1.5"/>
        <circle cx="160" cy="160" r="118" fill="none" stroke="#262b52" stroke-dasharray="4 8"/>
        <g fill="none" stroke="url(#hg)" stroke-width="12" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="112" cy="160" r="40"/>
          <path d="M152 160h104M224 160v30M252 160v20"/>
        </g>
        <circle cx="112" cy="160" r="12" fill="#f472b6"/>
      </svg>
    </div>
    <div class="container hero-content">
      <span class="kicker">IT setup · AI automation · Free guides · Weekly</span>
      <h1>Unlock tech,<br /> <span class="glow">whatever</span> <span class="glow-m">your level.</span></h1>
      <p class="lead">Remote IT setup and practical AI automation for small businesses, plus free plain-English guides, honest reviews and a weekly email for anyone learning tech.</p>
      <div class="btn-row hero-ctas">
        <a class="btn btn-primary" href={url('/services/')} data-umami-event="services-cta" data-umami-event-location="home-hero">Services for your business</a>
        <a class="btn btn-alt" href={url('/newsletter/')} data-umami-event="newsletter-cta" data-umami-event-location="home-hero">Get the free weekly email</a>
      </div>
      <p class="hero-sub-links"><a href={url('/learn/')}>Free guides</a> · <a href={url('/reviews/')}>Reviews</a> · <a href={url('/lab/')}>Lab builds</a></p>
    </div>
  </section>

  <section class="alt" aria-labelledby="pillars-h">
    <div class="container">
      <div class="section-head"><h2 id="pillars-h">Four ways to unlock</h2><p>Pick the door that fits where you are today.</p></div>
      <div class="grid grid-4">
        {pillars.map((p) => (
          <article class={`card pillar ${p.cls}`}>
            <div class="icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={p.icon} /></div>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
            <a href={url(p.href)}>{p.link} →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  {publishedLabProjects.length > 0 && (
  <section class="alt" aria-labelledby="lab-h">
    <div class="container">
      <div class="section-head"><h2 id="lab-h">From the Lab</h2><a href={url('/lab/')} data-umami-event="lab-cta" data-umami-event-location="home">All builds →</a></div>
      <p class="muted" style="margin-top:-.75rem">Real builds, documented: what I built, why, the results and lessons, and what I'd do differently.</p>
      <div class="grid grid-3">
        {publishedLabProjects.map((p) => (
          <Card href={url(`/lab/${p.slug}/`)} title={p.title} kicker={p.tags.join(' · ')}>{p.summary}</Card>
        ))}
      </div>
    </div>
  </section>
  )}

  <section aria-labelledby="nl-h">
    <div class="container">
      <p class="home-teaser" id="first-posts">Tutorials, Lab builds, reviews and articles: <strong>more posts are on the way.</strong> Get them in <strong>Unlock the Week</strong>, the free weekly email.</p>
      <div class="nl-box">
        <span class="kicker">Newsletter · Weekly</span>
        <h2 id="nl-h">Unlock the Week</h2>
        <p class="muted">One tech story in plain English, a skill tip, gear picks and something to learn, once a week. No spam; unsubscribe anytime.</p>
        <NewsletterForm id="home-nl" />
      </div>
    </div>
  </section>

  <section class="alt" aria-labelledby="svc-h">
    <div class="container">
      <div class="section-head"><h2 id="svc-h">Services for small businesses</h2><a href={url('/services/')} data-umami-event="services-cta" data-umami-event-location="home-services">View services →</a></div>
      <div class="grid grid-3">
        <article class="card offer-featured"><span class="kicker">Featured · Starting at {usd(remoteIt.from)}</span><h3><a href={url('/services/remote-it/')} data-umami-event="services-cta" data-umami-event-location="home-featured">Remote Small-Office IT Setup</a></h3><p class="offer-outcome">{remoteIt.outcome}.</p><p>Business email, email security settings (SPF/DKIM/DMARC), Wi-Fi security, backups and password managers, fully remote.</p></article>
        <article class="card"><span class="kicker">Starting at {usd(quickWin.from)}</span><h3><a href={url('/services/#quick-win')} data-umami-event="services-cta" data-umami-event-location="home-quick-win">{quickWin.name}</a></h3><p class="offer-outcome">{quickWin.outcome}.</p><p>One repetitive task automated, plus a quick check of your tech basics and a plain-English to-do list of the top fixes.</p></article>
        <article class="card"><span class="kicker">Starting at {usd(aiFaq.from)}</span><h3><a href={url('/services/#ai-faq')} data-umami-event="services-cta" data-umami-event-location="home-ai-faq">{aiFaq.name}</a></h3><p class="offer-outcome">{aiFaq.outcome}.</p><p>Answer common questions and collect leads consistently.</p></article>
      </div>
      <p class="intro-pricing" role="note" style="margin-top:1.25rem"><strong>{introPricing.label}.</strong> {introPricing.note}</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={url('/contact/')} data-umami-event="contact-click" data-umami-event-location="home-services">Get in touch</a>
        <a class="btn btn-ghost" href={url('/services/')} data-umami-event="services-cta" data-umami-event-location="home-services-btn">See all services</a>
      </div>
      <p class="muted" style="margin-top:1rem;font-size:.92rem">Prices are starting points; every project is scoped first. More automation services are on the services page. Results depend on your business and tools.</p>
    </div>
  </section>

  <section aria-labelledby="who-h">
    <div class="container">
      <article class="card who-card">
        <svg class="who-mark" width="64" height="64" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
          <defs>
            <linearGradient id="who-grad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#22d3ee" /><stop offset="0.55" stop-color="#a78bfa" /><stop offset="1" stop-color="#f472b6" />
            </linearGradient>
          </defs>
          <g fill="none" stroke="url(#who-grad)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="22" cy="32" r="11" />
            <path d="M33 32h22M47 32v9M54 32v6" />
          </g>
          <circle cx="22" cy="32" r="3.5" fill="#f472b6" />
        </svg>
        <div>
          <span class="kicker">Who does the work</span>
          <h2 id="who-h" style="font-size:1.35rem;margin:.3rem 0 .5rem">Michael Ream</h2>
          <p>NeonKey is run by me, Michael Ream, and I do the client work myself. I've spent years working hands-on in tech, setting up, maintaining and troubleshooting networks and communication systems. I hold a Computer Installation and Repair Technician certificate from the California Institute of Applied Technology and I'm studying Computer Information Systems.</p>
          <p style="margin-bottom:0">For clients, that means small-office setups done properly: business email that's less likely to land in spam and harder for scammers to fake, Wi-Fi, backups and passwords locked down, and small automations you fully own. <a href={url('/about/')}>More about me →</a></p>
        </div>
      </article>
    </div>
  </section>

  <section aria-labelledby="lip-h">
    <div class="narrow">
      <div class="callout">
        <h2 id="lip-h" style="font-size:1.35rem">Built and documented in the open</h2>
        <p style="margin:0">I'm Michael Ream, and NeonKey is where I build, test and document as I go: homelab projects, AI automations and small-office IT setups. You'll see the results and lessons, including what I'd do differently. <a href={url('/about/')}>More about NeonKey →</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .who-card { display: grid; grid-template-columns: auto 1fr; gap: 1.25rem 1.5rem; align-items: start; }
  .who-card p + p { margin-top: .75rem; }
  .who-mark { flex-shrink: 0; filter: drop-shadow(0 0 12px rgba(167,139,250,.45)); }
  @media (max-width: 640px) { .who-card { grid-template-columns: 1fr; } }
</style>
