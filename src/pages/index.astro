---
import { url } from '../config';
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { publishedLabProjects } from '../data/lab';
import { remoteIt, automationOffers, introPricing, usd } from '../data/services';
const quickWin = automationOffers.find((o) => o.slug === 'quick-win')!;
const aiFaq = automationOffers.find((o) => o.slug === 'ai-faq')!;
// Tutorials and reviews have no published posts yet (drafts live in src/_drafts/, see LAUNCH.md),
// so the home page shows one short teaser instead of empty grids. The Lab section returns on its own once a project is published.
const pillars = [
  { cls: 'c', title: 'Unlock AI', href: '/services/', link: 'See services', text: 'Practical automations and remote small-office IT setup for small businesses. Plain-English setup and handoff.',
    icon: '<path d="M12 3v3M12 18v3M3 12h3M18 12h3M6 6l2 2M16 16l2 2M6 18l2-2M16 8l2-2"/><circle cx="12" cy="12" r="3"/>' },
  { cls: 'm', title: 'Unlock Deals', href: '/reviews/', link: 'Read reviews', text: 'Honest takes on gear and software worth your money, with pros, cons and a plain verdict.',
    icon: '<path d="M20 12l-8 8-9-9V3h8z"/><circle cx="7.5" cy="7.5" r="1.5"/>' },
  { cls: 'v', title: 'Unlock Skills', href: '/learn/', link: 'Start learning', text: 'Plain-language guides for learning tech, starting with a free CompTIA Security+ study guide. Beginner-friendly, no gatekeeping.',
    icon: '<path d="M4 19V5a2 2 0 0 1 2-2h12v16H6a2 2 0 0 0-2 2z"/><path d="M8 7h6M8 11h6"/>' },
  { cls: 'y', title: 'Unlock the Week', href: '/newsletter/', link: 'Get the newsletter', text: 'A weekly email with one AI story in plain English, a skill tip, gear picks and something to learn.',
    icon: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>' },
];
// "See it in action": real screenshots (public/images/home/), captured from a local build of each page with a result showing.
const showcase = [
  { href: '/lab/ai-inquiry-triage/', img: '/images/home/triage-demo-result', mobileLarge: '-mobile-1170.webp', event: 'lab-cta', kicker: 'Lab · Live demo', title: 'AI inquiry triage',
    text: 'Paste a customer message and get a category, urgency, key details and a draft reply for a person to review.',
    alt: 'The AI inquiry triage demo after running a made-up bakery order request. The result is labeled Sales / new project with medium urgency, followed by a summary, key details including the name, a mid-November deadline and a $300 budget, and a suggested next step.' },
  { href: '/services/quiz/', img: '/images/home/quiz-result', mobileLarge: '-mobile-1100.webp', event: 'quiz-cta', kicker: 'Services · 2-minute quiz', title: 'What service do I need?',
    text: 'Eight quick questions and an instant recommendation in your browser. No email needed.',
    alt: 'A quiz result recommending Remote Small-Office IT Setup, starting at $299, listing what the setup would cover: business email and domain, email authentication, a password manager rollout and backups.' },
];
const otherLab = publishedLabProjects.filter((p) => !showcase.some((s) => s.href === `/lab/${p.slug}/`));
---
<Base title="Home" description="NeonKey helps beginners and builders get more out of tech: practical AI automations, honest gear picks, hands-on tutorials, Lab builds and a weekly email.">
  <section class="hero hero-bg">
    <div class="hero-art" aria-hidden="true">
      <svg viewBox="0 0 320 320" width="320" height="320" focusable="false">
        <defs>
          <linearGradient id="hg" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#22d3ee"/><stop offset=".55" stop-color="#a78bfa"/><stop offset="1" stop-color="#f472b6"/>
          </linearGradient>
        </defs>
        <circle cx="160" cy="160" r="150" fill="none" stroke="#262b52" stroke-width="1.5"/>
        <circle cx="160" cy="160" r="118" fill="none" stroke="#262b52" stroke-dasharray="4 8"/>
        <g fill="none" stroke="url(#hg)" stroke-width="12" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="112" cy="160" r="40"/>
          <path d="M152 160h104M224 160v30M252 160v20"/>
        </g>
        <circle cx="112" cy="160" r="12" fill="#f472b6"/>
      </svg>
    </div>
    <div class="container hero-content">
      <span class="kicker">AI · Deals · Skills · Weekly</span>
      <h1>Unlock tech,<br /> <span class="glow">whatever</span> <span class="glow-m">your level.</span></h1>
      <p class="lead">NeonKey helps beginners and builders get more out of technology: practical AI automations, honest gear picks, hands-on tutorials and a weekly email that respects your time.</p>
      <div class="btn-row hero-ctas">
        <a class="btn btn-primary" href={url('/newsletter/')} data-umami-event="newsletter-cta" data-umami-event-location="home-hero">Get Unlock the Week</a>
        <a class="btn btn-ghost" href={url('/services/')} data-umami-event="services-cta" data-umami-event-location="home-hero">Services for your business</a>
      </div>
    </div>
  </section>

  <section class="alt" aria-labelledby="pillars-h">
    <div class="container">
      <div class="section-head"><h2 id="pillars-h">Four ways to unlock</h2><p>Pick the door that fits where you are today.</p></div>
      <div class="grid grid-4">
        {pillars.map((p) => (
          <article class={`card pillar ${p.cls}`}>
            <div class="icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={p.icon} /></div>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
            <a href={url(p.href)}>{p.link} →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="alt" aria-labelledby="action-h">
    <div class="container">
      <div class="section-head"><h2 id="action-h">See it in action</h2><a href={url('/lab/')} data-umami-event="lab-cta" data-umami-event-location="home">All Lab builds →</a></div>
      <p class="muted" style="margin-top:-.75rem">Two things you can try right now, free.</p>
      <div class="grid grid-2 showcase">
        {showcase.map((s) => (
          <a class="card showcase-card" href={url(s.href)} data-umami-event={s.event} data-umami-event-location="home-showcase">
            <picture>
              <source media="(max-width: 640px)" srcset={`${url(s.img + '-mobile-640.webp')} 640w, ${url(s.img + s.mobileLarge)} ${s.mobileLarge.match(/(\d+)\.webp$/)![1]}w`} sizes="100vw" width="640" height="400" />
              <img src={url(s.img + '-1200.webp')} srcset={`${url(s.img + '-640.webp')} 640w, ${url(s.img + '-1200.webp')} 1200w`} sizes="(max-width: 1200px) 50vw, 560px" width="1200" height="750" loading="lazy" decoding="async" alt={s.alt} />
            </picture>
            <span class="showcase-body">
              <span class="kicker">{s.kicker}</span>
              <span class="showcase-title">{s.title} →</span>
              <span class="showcase-text">{s.text}</span>
            </span>
          </a>
        ))}
      </div>
      {otherLab.length > 0 && (
        <div class="grid grid-3" style="margin-top:1.25rem">
          {otherLab.map((p) => (
            <Card href={url(`/lab/${p.slug}/`)} title={p.title} kicker={p.tags.join(' · ')}>{p.summary}</Card>
          ))}
        </div>
      )}
    </div>
  </section>

  <section aria-labelledby="nl-h">
    <div class="container">
      <p class="home-teaser" id="first-posts">Tutorials, Lab builds, reviews and articles: <strong>more posts are on the way.</strong> Get them in Unlock the Week.</p>
      <div class="nl-box">
        <span class="kicker">Newsletter · Weekly</span>
        <h2 id="nl-h">Unlock the Week</h2>
        <p class="muted">One AI story in plain English, a skill tip, gear picks and something to learn, once a week. No spam; unsubscribe anytime.</p>
        <NewsletterForm id="home-nl" />
      </div>
    </div>
  </section>

  <section class="alt" aria-labelledby="svc-h">
    <div class="container">
      <div class="section-head"><h2 id="svc-h">Services for small businesses</h2><a href={url('/services/')} data-umami-event="services-cta" data-umami-event-location="home-services">View services →</a></div>
      <div class="grid grid-3">
        <article class="card offer-featured"><span class="kicker">Featured · Starting at {usd(remoteIt.from)}</span><h3><a href={url('/services/remote-it/')} data-umami-event="services-cta" data-umami-event-location="home-featured">Remote Small-Office IT Setup</a></h3><p>Business email, SPF/DKIM/DMARC, Wi-Fi hardening, backups and password managers, fully remote.</p></article>
        <article class="card"><span class="kicker">Starting at {usd(quickWin.from)}</span><h3><a href={url('/services/#quick-win')} data-umami-event="services-cta" data-umami-event-location="home-quick-win">{quickWin.name}</a></h3><p>One repetitive task automated, plus a quick check of your tech basics and a plain-English to-do list of the top fixes.</p></article>
        <article class="card"><span class="kicker">Starting at {usd(aiFaq.from)}</span><h3>AI Intake &amp; FAQ Assistant</h3><p>Answer common questions and collect leads consistently.</p></article>
      </div>
      <p class="intro-pricing" role="note" style="margin-top:1.25rem"><strong>{introPricing.label}.</strong> {introPricing.note}</p>
      <p class="muted" style="margin-top:1rem;font-size:.92rem">Prices are starting points; every project is scoped first. More automation services are on the services page. Results depend on your business and tools.</p>
    </div>
  </section>

  <section aria-labelledby="lip-h">
    <div class="narrow">
      <div class="callout">
        <h2 id="lip-h" style="font-size:1.35rem">Learning in public</h2>
        <p style="margin:0">I'm Michael Ream, and NeonKey is where I build, test and document as I go: homelab projects, AI automations and small-office IT setups. You'll see the wins and the mistakes. <a href={url('/about/')}>More about NeonKey →</a></p>
      </div>
    </div>
  </section>
</Base>
