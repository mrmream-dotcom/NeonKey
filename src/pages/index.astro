---
import OfferTitle from '../components/OfferTitle.astro';
import OfferNameLabel from '../components/OfferNameLabel.astro';
import { url } from '../config';
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FeaturedArticle from '../components/FeaturedArticle.astro';
import ArticleCard from '../components/ArticleCard.astro';
import LabCard from '../components/LabCard.astro';
import { articlesIn, sortByDate } from '../data/articles';
import NewsletterForm from '../components/NewsletterForm.astro';
import LockdownStrip from '../components/LockdownStrip.astro';
import DeskSale from '../components/DeskSale.astro';
import { publishedLabProjects } from '../data/lab';
import { remoteIt, remoteSupportPlan, automationOffers, emailLockdown, followUpDesk, followUpDeskTrialDays, followUpDeskSaleLive, followUpDeskSale, frontOfficePackage as fop, introPricing, showPackageValue, usd } from '../data/services';
import { absoluteUrl, CONTACT_EMAIL, INSTAGRAM_URL, INSTAGRAM_HANDLE, YOUTUBE_URL, SOCIALS } from '../config';
const latestArticles = sortByDate(articlesIn());
const leadStory = latestArticles.find((a) => a.date);
const moreStories = latestArticles.filter((a) => a !== leadStory).slice(0, 3);
const quickWin = automationOffers.find((o) => o.slug === 'quick-win')!;
const pillars = [
  { cls: 'c', title: 'Unlock AI', href: '/services/', link: 'See services', text: 'Self-serve estimate follow-up and custom lead follow-up systems for small businesses, so fewer inquiries slip away.',
    icon: '<path d="M12 3v3M12 18v3M3 12h3M18 12h3M6 6l2 2M16 16l2 2M6 18l2-2M16 8l2-2"/><circle cx="12" cy="12" r="3"/>' },
  { cls: 'm', title: 'Unlock Deals', href: '/reviews/', link: 'Read reviews', text: 'Honest takes on gear and software worth your money, with pros, cons and a plain verdict.',
    icon: '<path d="M20 12l-8 8-9-9V3h8z"/><circle cx="7.5" cy="7.5" r="1.5"/>' },
  { cls: 'v', title: 'Unlock Skills', href: '/learn/', link: 'Start learning', text: 'Plain-language guides for learning tech, starting with a free CompTIA Security+ study guide. Beginner-friendly, no gatekeeping.',
    icon: '<path d="M4 19V5a2 2 0 0 1 2-2h12v16H6a2 2 0 0 0-2 2z"/><path d="M8 7h6M8 11h6"/>' },
  { cls: 'y', title: 'Unlock the Week', href: '/newsletter/', link: 'Get the newsletter', text: 'One short email every Wednesday: a one-minute fix for your tech or your customer follow-up, plus a free guide from Learn.',
    icon: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>' },
];
// JSON-LD structured data (one @graph). Prices and service text come from src/data/services.ts.
const abs = (p: string) => absoluteUrl(p, Astro.site);
const home = abs('/');
const orgId = `${home}#organization`;
const usArea = { '@type': 'Country', name: 'United States' };
const serviceNode = (o: typeof remoteIt, offerPath: string, monthly = false) => ({
  '@type': 'Service',
  '@id': `${home}#service-${o.slug}`,
  name: o.name,
  description: o.for,
  url: abs(offerPath),
  provider: { '@id': orgId },
  areaServed: usArea,
  offers: {
    '@type': 'Offer',
    url: abs(offerPath),
    price: o.from,
    priceCurrency: 'USD',
    priceSpecification: {
      '@type': monthly ? 'UnitPriceSpecification' : 'PriceSpecification',
      price: o.from,
      minPrice: o.from,
      priceCurrency: 'USD',
      ...(monthly ? { unitCode: 'MON', unitText: 'month' } : {}),
      description: monthly ? 'Starting monthly price; final price agreed before you start' : 'Starting price; fixed written quote before work starts',
    },
  },
});
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${home}#website`,
      url: home,
      name: 'NeonKey',
      description: 'Practical AI automations, honest gear picks, hands-on tutorials, Lab builds and a weekly tech email for beginners and builders.',
      inLanguage: 'en',
      publisher: { '@id': orgId },
    },
    {
      '@type': 'Organization',
      '@id': orgId,
      name: 'NeonKey',
      url: home,
      logo: abs('/icon-512.png'),
      email: CONTACT_EMAIL,
      sameAs: SOCIALS.map((s) => s.url),
      description: 'NeonKey helps beginners and builders get more out of tech through practical AI automations, remote small-office IT services, honest gear picks, hands-on tutorials and a weekly email.',
      founder: { '@type': 'Person', name: 'Michael Ream', url: abs('/about/') },
      areaServed: usArea,
      knowsAbout: ['Lead follow-up systems', 'Speed to lead', 'Customer reactivation', 'AI automation', 'Small-office IT setup', 'Cybersecurity basics', 'Technology tutorials', 'Computer hardware and software'],
    },
    {
      '@type': 'WebPage',
      '@id': `${home}#webpage`,
      url: home,
      name: 'NeonKey | Lead Follow-Up and Office IT for Small Businesses',
      headline: 'Stop losing leads to slow replies and forgotten follow-ups.',
      description: 'Lead follow-up systems and office IT for small businesses: faster replies to new inquiries, follow-up on quiet quotes, and secure business email. Done remotely anywhere in the US.',
      inLanguage: 'en',
      isPartOf: { '@id': `${home}#website` },
      about: { '@id': orgId },
      publisher: { '@id': orgId },
      mainEntity: { '@id': `${home}#sections` },
      potentialAction: [
        { '@type': 'SubscribeAction', target: abs('/newsletter/'), object: { '@id': `${home}#unlock-the-week` } },
      ],
    },
    {
      '@type': 'ItemList',
      '@id': `${home}#sections`,
      name: 'NeonKey content and services',
      itemListElement: pillars.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.title, url: abs(p.href) })),
    },
    {
      '@type': 'CreativeWorkSeries',
      '@id': `${home}#unlock-the-week`,
      name: 'Unlock the Week',
      url: abs('/newsletter/'),
      description: 'A free email every Wednesday with a one-minute fix for your tech or your customer follow-up, plus a free guide from Learn. Written with small businesses in mind and useful for anyone.',
      inLanguage: 'en',
      publisher: { '@id': orgId },
      isAccessibleForFree: true,
    },
    serviceNode(remoteIt, '/services/remote-it/'),
    serviceNode(remoteSupportPlan, '/services/remote-it/#support-plan', true),
    serviceNode(quickWin, '/services/#quick-win'),
    // AI Intake and Lead-Routing are sold inside the Front Office Package, not listed on their own (Nov 4 2026).
    serviceNode(fop, '/services/#front-office-package'),
    serviceNode(emailLockdown, '/services/email-lockdown/'),
    serviceNode(followUpDeskSaleLive ? { ...followUpDesk, from: followUpDeskSale.monthly } : followUpDesk, '/follow-up-desk/', true),
    {
      '@type': 'SoftwareApplication',
      '@id': `${home}#ai-inquiry-triage`,
      name: 'AI Inquiry Triage (demo)',
      url: abs('/lab/ai-inquiry-triage/'),
      description: 'A working AI demo that sorts a customer message, flags urgency, pulls out key details and drafts a reply for a human to review.',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web browser',
      creator: { '@id': orgId },
      offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD' },
    },
  ],
};
const jsonLdHtml = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
// Tutorials and reviews have no published posts yet (drafts live in src/_drafts/, see LAUNCH.md),
// so the home page shows one short teaser instead of empty grids. The Lab section returns on its own once a project is published.
---
<Base title="Home" description="Stop losing leads to slow replies and forgotten follow-ups. Self-serve estimate follow-up with 14 days free, or a custom follow-up system set up remotely anywhere in the US.">
  <script type="application/ld+json" is:inline set:html={jsonLdHtml}></script>
  <section class="hero hero-bg">
    <div class="hero-art" aria-hidden="true">
      <svg viewBox="0 0 320 320" width="320" height="320" focusable="false">
        <defs>
          <linearGradient id="hg" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#22d3ee"/><stop offset=".55" stop-color="#a78bfa"/><stop offset="1" stop-color="#f472b6"/>
          </linearGradient>
        </defs>
        <circle cx="160" cy="160" r="150" fill="none" stroke="#262b52" stroke-width="1.5"/>
        <circle cx="160" cy="160" r="118" fill="none" stroke="#262b52" stroke-dasharray="4 8"/>
        <g fill="none" stroke="url(#hg)" stroke-width="12" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="112" cy="160" r="40"/>
          <path d="M152 160h104M224 160v30M252 160v20"/>
        </g>
        <circle cx="112" cy="160" r="12" fill="#f472b6"/>
      </svg>
    </div>
    <div class="container hero-content">
      <a class="hero-new" href={url(followUpDesk.href)} data-umami-event="services-cta" data-umami-event-offer={followUpDesk.name} data-umami-event-location="home-hero-new"><span class="hero-new-tag">New</span> {followUpDeskSaleLive ? <Fragment>{followUpDesk.name} · <DeskSale variant="line" location="home-hero-new" /></Fragment> : `${followUpDesk.name}: estimate follow-ups that run themselves · ${followUpDeskTrialDays} days free`} →</a>
      <span class="kicker">Lead and estimate follow-up for small businesses</span>
      <h1>Stop losing customers to <span class="hl">slow replies</span> and quiet quotes.</h1>
      <p class="lead">New inquiries get answered, and estimates get followed up until the customer replies. Start the {followUpDesk.name} yourself today, or get a written quote and we build a custom system for you, remotely, anywhere in the US.</p>
      <div class="btn-row hero-ctas">
        <a class="btn btn-primary" href={url('/contact/')} data-umami-event="contact-click" data-umami-event-location="home-hero">Get a written quote</a>
        <a class="btn btn-ghost" href={url('/services/')} data-umami-event="services-cta" data-umami-event-location="home-hero">See services and prices</a>
      </div>
      <p class="hero-proof">Written quote before any work · You keep every login · <a href={url('/lab/')} data-umami-event="lab-cta" data-umami-event-location="home-hero">Live demos in the Lab</a></p>
      <p class="hero-sub-links"><strong>Not ready for a quote?</strong> <a href={url('/newsletter/')} data-umami-event="newsletter-cta" data-umami-event-location="home-hero">Get one free tech fix every Wednesday →</a> Or browse <a href={url('/learn/')}>free guides</a> and <a href={url('/lab/')}>Lab demos</a>.</p>
    </div>
  </section>

  <section class="alt" aria-labelledby="svc-h">
    <div class="container">
      <SectionHeading id="svc-h" eyebrow="Services" title="Fix the leaks that cost you customers" intro="Have it set up for you with a written quote first, or start the self-serve version today." link={{ href: '/services/', label: 'All services and prices', attrs: { 'data-umami-event': 'services-cta', 'data-umami-event-location': 'home-services' } }} />
      <div class="grid grid-2 home-offers">
        <article class="card offer-featured topline accent-magenta" id="front-office">
          <span class="kicker">Done for you · Custom setup · {usd(fop.from)}</span>
          <h3><a href={url('/services/#front-office-package')} data-umami-event="services-cta" data-umami-event-location="home-package"><OfferTitle offer={fop} /></a></h3>
          <OfferNameLabel offer={fop} />
          <p class="offer-outcome">Reply to new requests faster and stop quotes from going cold.</p>
          <ul class="home-offer-list">
            <li>Requests from your website form or shared inbox land on one list, and the right person gets an alert</li>
            <li>Follow-up reminders on day 1, 3 and 7 for quotes that go quiet, with a draft ready</li>
            <li>Reply drafts from your templates; a person sends every quote reply and follow-up</li>
            <li>Business email security set up, plus three months of support</li>
          </ul>
          <p class="price" style="margin:.4rem 0 .8rem">{showPackageValue && <s class="muted" style="font-weight:400;font-size:1rem;margin-right:.4rem">{usd(fop.value)}+ value</s>}{usd(fop.from)}<small>Setup + three months of support · {introPricing.label.toLowerCase()}</small></p>
          <div class="btn-row">
            <a class="btn btn-primary btn-sm" href={url(`/contact/?topic=${fop.slug}`)} data-umami-event="contact-click" data-umami-event-offer={fop.name} data-umami-event-location="home-package">Get a written quote</a>
            <a class="btn btn-ghost btn-sm" href={url('/lab/front-office/')} data-umami-event="demo-click" data-umami-event-offer={fop.name} data-umami-event-location="home-package">Try a sample request</a>
          </div>
        </article>
        <article class="card topline accent-violet" id="follow-up-desk">
          <span class="kicker">Do it yourself · Start today · {usd(followUpDeskSaleLive ? followUpDeskSale.monthly : followUpDesk.from)}/mo</span>
          <h3><a href={url(followUpDesk.href)} data-umami-event="services-cta" data-umami-event-offer={followUpDesk.name} data-umami-event-location="home-fud"><OfferTitle offer={followUpDesk} /></a></h3>
          <OfferNameLabel offer={followUpDesk} />
          <p class="offer-outcome">{followUpDesk.outcome}.</p>
          <ul class="home-offer-list">
            <li>Add the estimates you sent, or paste a list from QuickBooks or a spreadsheet</li>
            <li>Up to three polite follow-ups, sent under your business name on weekday mornings</li>
            <li>Stops on its own when your customer replies, and the reply comes to your inbox</li>
            <li>Set it up yourself in minutes. No setup call</li>
          </ul>
          {followUpDeskSaleLive
            ? <Fragment><DeskSale location="home-fud" />
              <div class="btn-row" style="margin-top:.6rem">
            <a class="btn btn-ghost btn-sm" href={url(followUpDesk.href)} data-umami-event="services-cta" data-umami-event-offer={followUpDesk.name} data-umami-event-location="home-fud-details">How it works</a>
              </div></Fragment>
            : <Fragment><p class="price" style="margin:.4rem 0 .8rem">{usd(followUpDesk.from)}<small>a month · {followUpDeskTrialDays} days free · card required, cancel anytime</small></p>
              <div class="btn-row">
            <a class="btn btn-primary btn-sm" href={followUpDesk.buyUrl} rel="noopener" data-umami-event="buy-click" data-umami-event-offer={followUpDesk.name} data-umami-event-location="home-fud">Start free trial</a>
            <a class="btn btn-ghost btn-sm" href={url(followUpDesk.href)} data-umami-event="services-cta" data-umami-event-offer={followUpDesk.name} data-umami-event-location="home-fud-details">How it works</a>
              </div></Fragment>}
        </article>
      </div>
      <LockdownStrip location="home-lockdown-strip" />
      <p class="intro-pricing" role="note" style="margin-top:1.25rem"><strong>{introPricing.label}.</strong> {introPricing.note}</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={url('/contact/')} data-umami-event="contact-click" data-umami-event-location="home-services">Get in touch</a>
        <a class="btn btn-ghost" href={url('/services/')} data-umami-event="services-cta" data-umami-event-location="home-services-btn">See all services</a>
      </div>
      <p class="muted" style="margin-top:1rem;font-size:.92rem">Prices are starting points; every project is scoped first. Smaller jobs, like website inquiry alerts from {usd(quickWin.from)}, office IT setup from {usd(remoteIt.from)} or a monthly support plan, are on the services page. Results depend on your business and tools.</p>
    </div>
  </section>

  <section aria-labelledby="how-h">
    <div class="container">
      <SectionHeading id="how-h" eyebrow="How it works" title="Scoped, built after hours, handed over to you" />
      <ol class="step-cards">
        <li><strong>Scope:</strong> we agree on what "done" looks like, by message or a short call. You get a written quote before any work starts.</li>
        <li><strong>Build:</strong> setup and changeovers happen after business hours or on weekends, so your staff don't lose a working hour.</li>
        <li><strong>Check:</strong> we test it with you on screen: email records, sign-ins, a backup restore.</li>
        <li><strong>Hand off:</strong> every account is created in your name. You get notes and a walkthrough, and you can switch off our access.</li>
      </ol>
    </div>
  </section>

  {publishedLabProjects.length > 0 && (
  <section aria-labelledby="lab-h">
    <div class="container">
      <SectionHeading id="lab-h" eyebrow="The Lab" title="From the Lab" intro="Working demos you can try right now: what I built, why, the results and lessons, and what I'd do differently." link={{ href: '/lab/', label: 'All builds', attrs: { 'data-umami-event': 'lab-cta', 'data-umami-event-location': 'home' } }} />
      <ul class="article-grid">
        {publishedLabProjects.map((p) => <LabCard project={p} as="li" />)}
      </ul>
    </div>
  </section>
  )}

  <section class="alt" aria-labelledby="pillars-h">
    <div class="container">
      <SectionHeading id="pillars-h" eyebrow="Free from NeonKey" title="Four ways to unlock" intro="Here to learn, not to hire? This part of NeonKey is free for everyone: guides, honest reviews, Lab builds and a weekly email." />
      <div class="grid grid-4">
        {pillars.map((p, i) => (
          <article class={`card pillar topline ${p.cls}`}>
            <span class="num-eyebrow pillar-num">{String(i + 1).padStart(2, '0')}</span>
            <div class="icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={p.icon} /></div>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
            <a href={url(p.href)}>{p.link} →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  {leadStory && (
  <section class="home-latest" aria-labelledby="latest-h">
    <div class="container">
      <SectionHeading id="latest-h" eyebrow="Articles" title="Latest from NeonKey" intro="News, explainers and reviews, newest first." link={{ href: '/articles/', label: 'All articles' }} />
      <FeaturedArticle article={leadStory} eager={false} />
      {moreStories.length > 0 && (
        <ul class="article-grid">
          {moreStories.map((a) => <ArticleCard article={a} />)}
        </ul>
      )}
    </div>
  </section>
  )}

  <section class="alt" aria-labelledby="who-h">
    <div class="container">
      <article class="card who-card topline accent-violet">
        <svg class="who-mark" width="64" height="64" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
          <defs>
            <linearGradient id="who-grad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#22d3ee" /><stop offset="0.55" stop-color="#a78bfa" /><stop offset="1" stop-color="#f472b6" />
            </linearGradient>
          </defs>
          <g fill="none" stroke="url(#who-grad)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="22" cy="32" r="11" />
            <path d="M33 32h22M47 32v9M54 32v6" />
          </g>
          <circle cx="22" cy="32" r="3.5" fill="#f472b6" />
        </svg>
        <div>
          <span class="kicker eyebrow">Who does the work</span>
          <h2 id="who-h" style="font-size:1.35rem;margin:.3rem 0 .5rem">Michael Ream</h2>
          <p>NeonKey is run by me, Michael Ream, and I do the client work myself. I've worked in the IT industry for most of my adult career, setting up, maintaining and troubleshooting networks and communication systems. I'm now pursuing an Applied Bachelor's Degree in Cybersecurity, earning an associate degree in Computer Information Systems along the way. I've also worked hands-on in Microsoft Azure, building virtual machines and virtual networks and organizing resource groups.</p>
          <p style="margin-bottom:0">For clients, that means small-office setups done properly: business email that's less likely to land in spam and harder for scammers to fake, Wi-Fi, backups and passwords locked down, and small automations you fully own. <a href={url('/about/')}>More about me →</a></p>
        </div>
      </article>
    </div>
  </section>

  <section aria-labelledby="nl-h">
    <div class="container">
      <p class="home-teaser" id="first-posts">Tutorials, Lab builds, reviews and articles: <strong>more posts are on the way.</strong> Get them in <strong>Unlock the Week</strong>, the free weekly email.</p>
      <div class="nl-box topline">
        <span class="kicker eyebrow">Newsletter · Every Wednesday</span>
        <h2 id="nl-h">Unlock the Week</h2>
        <p class="muted">One fix you can do in a few minutes, every Wednesday: keep your tech secure, or catch more of the customers who reach out. Plus a free Learn guide. For small businesses, new founders and anyone curious. No spam; unsubscribe anytime.</p>
        <NewsletterForm id="home-nl" />
      </div>
    </div>
  </section>

  <section aria-labelledby="lip-h">
    <div class="narrow">
      <div class="callout final-cta">
        <h2 id="lip-h" style="font-size:1.35rem">Built and documented in the open</h2>
        <p>I'm Michael Ream, and NeonKey is where I build, test and document as I go: homelab projects, AI automations and small-office IT setups. You'll see the results and lessons, including what I'd do differently. <a href={url('/about/')}>More about NeonKey →</a></p>
        <p style="margin-bottom:0">Losing track of inquiries or quotes? Tell us where they come in and we'll send a free written quote.</p>
        <div class="btn-row" style="margin-top:1rem">
          <a class="btn btn-primary" href={url('/contact/')} data-umami-event="contact-click" data-umami-event-location="home-final">Get a written quote</a>
          <a class="btn btn-ghost" href={INSTAGRAM_URL} rel="me noopener" target="_blank" data-umami-event="outbound-click" data-umami-event-item="instagram" data-umami-event-location="home-final">Follow {INSTAGRAM_HANDLE}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .home-offers > .card { display: flex; flex-direction: column; }
  .home-offers .price { margin-top: auto !important; font-size: 1.7rem; font-weight: 800; color: var(--text); }
  .home-offers .price small { display: block; font-size: .85rem; font-weight: 400; color: var(--muted); }
  .home-offers .home-offer-sub { margin: .6rem 0 .3rem; font-weight: 600; color: var(--text); }
  .home-offer-list { margin: 0 0 .8rem; padding-left: 1.15rem; display: grid; gap: .35rem; }
  .home-offer-note { font-size: .95rem; margin: 0; }
  .fop-strip { margin-top: 1.25rem; display: grid; grid-template-columns: 1fr auto; gap: 1rem 2rem; align-items: center; }
  .fop-strip-side { display: grid; gap: .6rem; justify-items: start; }
  .fop-strip .price small { display: block; font-size: .85rem; }
  @media (max-width: 760px) { .fop-strip { grid-template-columns: 1fr; } }
  .hero-proof { margin: .9rem 0 0; font-size: .92rem; color: var(--muted); }
  .hero-new { display: flex; width: fit-content; align-items: center; gap: .5rem; max-width: 100%; margin-bottom: .9rem; padding: .3rem .8rem .3rem .3rem; border: 1px solid var(--line); border-radius: 999px; background: var(--panel); font-size: .88rem; font-weight: 600; color: var(--text); text-decoration: none; }
  .hero-new:hover { border-color: var(--cyan); }
  .hero-new-tag { padding: .15rem .55rem; border-radius: 999px; background: var(--cyan); color: var(--bg); font-size: .75rem; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; }
  .hero-proof a { color: inherit; text-decoration: underline; }
  .who-card { display: grid; grid-template-columns: auto 1fr; gap: 1.25rem 1.5rem; align-items: start; }
  .who-card p + p { margin-top: .75rem; }
  .who-mark { flex-shrink: 0; filter: drop-shadow(0 0 12px rgba(167,139,250,.45)); }
  @media (max-width: 640px) { .who-card { grid-template-columns: 1fr; } }
</style>
