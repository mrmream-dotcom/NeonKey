---
import { url } from '../config';
import Base from '../layouts/Base.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import LaneDoors from '../components/LaneDoors.astro';
import HeroStage from '../components/HeroStage.astro';
import TrustLine from '../components/TrustLine.astro';
import Section from '../components/ui/Section.astro';
import { LANE_NAMES, LANE_HUBS } from '../lib/lanes';
import type { Lane } from '../lib/checkout-ref';
import { remoteIt, remoteSupportPlan, automationOffers, emailLockdown, setupGuide, followUpDesk, followUpDeskTrialDays, followUpDeskSaleLive, followUpDeskSale, frontOfficePackage as fop, usd } from '../data/services';
import { absoluteUrl, CONTACT_EMAIL, SOCIALS } from '../config';
const quickWin = automationOffers.find((o) => o.slug === 'quick-win')!;
// Homepage (full overhaul, Nov 14 2026): in five seconds, what NeonKey does, for whom, and the next step.
//   1. Hero + the three entrances (LaneDoors): Protect Yourself, Build Your Business, Run Your Business
//   2. Trust line
//   3. Prices up front: each lane's products and prices, from src/data/services.ts (no hard-coded prices)
//   4. How NeonKey works (three facts already stated across the site)
//   5. Who does the work (approved experience wording)
//   6. Newsletter: <NewsletterForm id="home-nl" /> unchanged
// The `motion` A/B test ended with this rebuild (src/data/experiments.json).
// The three lanes, for the JSON-LD ItemList below (same order as LaneDoors).
const lanes = [
  { title: `${LANE_NAMES.family}: free scam checker`, href: '/protect/' },
  { title: `${LANE_NAMES.founders}: Launch Preflight, ${emailLockdown.name} and ${setupGuide.name}`, href: '/founders/' },
  { title: `${LANE_NAMES.smb}: ${followUpDesk.name} and custom setups`, href: '/services/' },
];
// "Prices up front": one short list per lane. Desk price swaps at the founding-sale deadline (DeskSale script on the
// page via LaneDoors). Every link is a page that exists today.
const priceCols: { lane: Lane; items: { name: string; href: string; price: string; desk?: boolean }[] }[] = [
  { lane: 'family', items: [
    { name: 'Free scam checker', href: '/scam-checker/', price: 'Free' },
    { name: 'Practice with six examples', href: '/learn/is-this-a-scam/', price: 'Free' },
  ] },
  { lane: 'founders', items: [
    { name: 'Launch Preflight', href: '/founders/preflight/', price: 'Free' },
    { name: emailLockdown.name, href: '/services/email-lockdown/', price: `${usd(emailLockdown.from)} one-time` },
    { name: setupGuide.name, href: '/founders/guide/', price: `${usd(setupGuide.price)} one-time` },
  ] },
  { lane: 'smb', items: [
    { name: followUpDesk.name, href: followUpDesk.href!, price: '', desk: true },
    { name: fop.name, href: '/services/#front-office-package', price: `${usd(fop.from)}, written quote first` },
    { name: remoteIt.name, href: remoteIt.href!, price: `from ${usd(remoteIt.from)}` },
    { name: remoteSupportPlan.name, href: '/services/remote-it/#support-plan', price: `from ${usd(remoteSupportPlan.from)}/month` },
  ] },
];
// JSON-LD structured data (one @graph). Prices and service text come from src/data/services.ts.
const abs = (p: string) => absoluteUrl(p, Astro.site);
const home = abs('/');
const orgId = `${home}#organization`;
const usArea = { '@type': 'Country', name: 'United States' };
const serviceNode = (o: typeof remoteIt, offerPath: string, monthly = false) => ({
  '@type': 'Service',
  '@id': `${home}#service-${o.slug}`,
  name: o.name,
  description: o.for,
  url: abs(offerPath),
  provider: { '@id': orgId },
  areaServed: usArea,
  offers: {
    '@type': 'Offer',
    url: abs(offerPath),
    price: o.from,
    priceCurrency: 'USD',
    priceSpecification: {
      '@type': monthly ? 'UnitPriceSpecification' : 'PriceSpecification',
      price: o.from,
      minPrice: o.from,
      priceCurrency: 'USD',
      ...(monthly ? { unitCode: 'MON', unitText: 'month' } : {}),
      description: monthly ? 'Starting monthly price; final price agreed before you start' : 'Starting price; fixed written quote before work starts',
    },
  },
});
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${home}#website`,
      url: home,
      name: 'NeonKey',
      description: 'Practical AI automations, honest gear picks, hands-on tutorials, Lab builds and a weekly tech email for beginners and builders.',
      inLanguage: 'en',
      publisher: { '@id': orgId },
    },
    {
      '@type': 'Organization',
      '@id': orgId,
      name: 'NeonKey',
      url: home,
      logo: abs('/icon-512.png'),
      email: CONTACT_EMAIL,
      sameAs: SOCIALS.map((s) => s.url),
      description: 'NeonKey helps beginners and builders get more out of tech through practical AI automations, remote small-office IT services, honest gear picks, hands-on tutorials and a weekly email.',
      areaServed: usArea,
      knowsAbout: ['Lead follow-up systems', 'Speed to lead', 'Customer reactivation', 'AI automation', 'Small-office IT setup', 'Cybersecurity basics', 'Technology tutorials', 'Computer hardware and software'],
    },
    {
      '@type': 'WebPage',
      '@id': `${home}#webpage`,
      url: home,
      name: 'NeonKey | Scam Checks, Founder Tools, Business Follow-Up',
      headline: 'Practical tech help for you, your launch and your business.',
      description: 'Check a suspicious message for free, set up email that inboxes trust, or make sure every estimate gets a follow-up. A free scam checker, a free domain email check and The Founder Stack for founders, and the Follow-Up Desk for small businesses.',
      inLanguage: 'en',
      isPartOf: { '@id': `${home}#website` },
      about: { '@id': orgId },
      publisher: { '@id': orgId },
      mainEntity: { '@id': `${home}#sections` },
      potentialAction: [
        { '@type': 'SubscribeAction', target: abs('/newsletter/'), object: { '@id': `${home}#unlock-the-week` } },
      ],
    },
    {
      '@type': 'ItemList',
      '@id': `${home}#sections`,
      name: 'NeonKey: three ways in',
      itemListElement: lanes.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.title, url: abs(p.href) })),
    },
    {
      '@type': 'CreativeWorkSeries',
      '@id': `${home}#unlock-the-week`,
      name: 'Unlock the Week',
      url: abs('/newsletter/'),
      description: 'A free email every Wednesday with a one-minute fix for your tech or your customer follow-up, plus a free guide from Learn. Written with small businesses in mind and useful for anyone.',
      inLanguage: 'en',
      publisher: { '@id': orgId },
      isAccessibleForFree: true,
    },
    serviceNode(remoteIt, '/services/remote-it/'),
    serviceNode(remoteSupportPlan, '/services/remote-it/#support-plan', true),
    serviceNode(quickWin, '/services/#quick-win'),
    // AI Intake and Lead-Routing are sold inside the Front Office Package, not listed on their own (Nov 4 2026).
    serviceNode(fop, '/services/#front-office-package'),
    serviceNode(emailLockdown, '/services/email-lockdown/'),
    serviceNode(followUpDeskSaleLive ? { ...followUpDesk, from: followUpDeskSale.monthly } : followUpDesk, '/follow-up-desk/', true),
    {
      '@type': 'SoftwareApplication',
      '@id': `${home}#ai-inquiry-triage`,
      name: 'AI Inquiry Triage (demo)',
      url: abs('/lab/ai-inquiry-triage/'),
      description: 'A working AI demo that sorts a customer message, flags urgency, pulls out key details and drafts a reply for a human to review.',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web browser',
      creator: { '@id': orgId },
      offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD' },
    },
  ],
};
const jsonLdHtml = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
// Tutorials and reviews have no published posts yet (drafts live in src/_drafts/, see LAUNCH.md),
// so the home page shows one short teaser instead of empty grids. The Lab section returns on its own once a project is published.
---
<Base title="Home" description={`Practical tech help for you, your launch and your business: a free scam checker, a free domain email check with The Founder Stack, and the Follow-Up Desk with ${followUpDeskTrialDays} days free.`}>
  <script type="application/ld+json" is:inline set:html={jsonLdHtml}></script>
  <section class="home-hero" aria-labelledby="home-h">
    <div class="container">
      <div class="home-top">
        <div class="home-copy">
          <p class="home-kicker"><span class="kicker">NeonKey</span><span class="home-by">Fairbanks, Alaska</span></p>
          <h1 id="home-h">Practical tech help for you, your launch and your business.</h1>
          <p class="home-lede">Check a suspicious message, launch on email that inboxes trust, or make sure every estimate gets a follow-up. Each path starts with something free.</p>
        </div>
        <div class="home-stage"><HeroStage /></div>
      </div>
      <LaneDoors />
      <TrustLine location="home" class="home-trust" extra={['Written quote before any custom work', 'You keep every login']} />
    </div>
  </section>

  <Section id="prices" title="Prices, up front" intro="What each path costs. Custom work always starts with a fixed written quote." tone="raised">
    <div class="price-cols">
      {priceCols.map((c) => (
        <div class={`price-col lane-${c.lane}`}>
          <h3 class="price-col-h"><a href={url(LANE_HUBS[c.lane])} data-umami-event="nav-click" data-umami-event-target={c.lane} data-umami-event-location="home-prices"><span class="lane-dot" aria-hidden="true"></span>{LANE_NAMES[c.lane]}</a></h3>
          <ul>
            {c.items.map((it) => (
              <li>
                <a href={url(it.href)} data-umami-event="services-cta" data-umami-event-offer={it.name} data-umami-event-location="home-prices">{it.name}</a>
                {it.desk
                  ? (followUpDeskSaleLive
                    ? <span class="pc-price" data-sale-ends={followUpDeskSale.endsAt}><span data-sale>{followUpDeskTrialDays} days free, then {usd(followUpDeskSale.monthly)}/month (founding price until {followUpDeskSale.endsLabel})</span><span data-sale-after hidden>{followUpDeskTrialDays} days free, then {usd(followUpDesk.from)}/month</span></span>
                    : <span class="pc-price">{followUpDeskTrialDays} days free, then {usd(followUpDesk.from)}/month</span>)
                  : <span class="pc-price">{it.price}</span>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="price-foot">Smaller fixed-scope jobs, like website inquiry alerts from {usd(quickWin.from)}, are on the <a href={url('/services/#smaller')} data-umami-event="services-cta" data-umami-event-location="home-small-jobs">{LANE_NAMES.smb} page</a>. Results depend on your business and tools.</p>
  </Section>

  <Section id="how" title="How NeonKey works" size="sm">
    <ul class="how-grid">
      <li><strong>Free first.</strong> Every path starts with a free tool: the scam checker, the Launch Preflight, the Inbox Check or the Starter IT Kit.</li>
      <li><strong>Prices before you commit.</strong> Self-serve products show their price and terms on the page. Custom work gets a fixed written quote before anything starts.</li>
      <li><strong>You stay in control.</strong> You keep every login and admin account, and you can read the <a href={url('/refunds/')}>refund and cancellation policy</a> before you buy.</li>
    </ul>
  </Section>

  <Section id="who" size="sm" label="Who does the work">
    <article class="ds-card ds-card-md who-card">
      <svg class="who-mark" width="56" height="56" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id="who-grad" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#22d3ee" /><stop offset="0.55" stop-color="#a78bfa" /><stop offset="1" stop-color="#f472b6" />
          </linearGradient>
        </defs>
        <g fill="none" stroke="url(#who-grad)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="22" cy="32" r="11" />
          <path d="M33 32h22M47 32v9M54 32v6" />
        </g>
        <circle cx="22" cy="32" r="3.5" fill="#f472b6" />
      </svg>
      <div>
        <span class="kicker">Who does the work</span>
        <h2 id="who-h" class="who-h">One person, start to finish</h2>
        <p>I do the client work myself. I've worked in the IT industry for most of my adult career, setting up, maintaining and troubleshooting networks and communication systems. I'm now pursuing an Applied Bachelor's Degree in Cybersecurity, earning an associate degree in Computer Information Systems along the way.</p>
        <p class="who-more"><a href={url('/about/')}>More about me →</a></p>
      </div>
    </article>
  </Section>

  <Section id="newsletter" size="sm" label="Newsletter">
    <div class="nl-box">
      <span class="kicker">Newsletter · Every Wednesday</span>
      <h2 id="nl-h">Unlock the Week</h2>
      <p class="muted">One fix you can do in a few minutes, every Wednesday: keep your tech secure, or catch more of the customers who reach out. Plus a free Learn guide. For small businesses, new founders and anyone curious. No spam; unsubscribe anytime.</p>
      <NewsletterForm id="home-nl" />
    </div>
  </Section>
</Base>

<style>
  .home-hero { padding: clamp(1.25rem, 4vw, 3.5rem) 0 var(--section-y-sm); }
  .home-kicker { display: flex; align-items: center; gap: .6rem; margin: 0 0 var(--space-3); }
  .home-by { font-size: var(--text-sm); color: var(--color-text-muted); }
  .home-by::before { content: '·'; margin-right: .6rem; color: var(--color-text-subtle); }
  .home-top { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); align-items: center; gap: var(--space-6); margin-bottom: var(--space-10); }
  .home-stage { height: clamp(360px, 38vw, 500px); }
  .home-hero h1 { font-size: clamp(2.5rem, 5.4vw, 4.75rem); font-weight: 300; letter-spacing: -.05em; line-height: 1; max-width: 13ch; margin: 0 0 var(--space-6);
    background: linear-gradient(180deg, #fff 30%, #a9adc4); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .home-lede { font-size: var(--text-lg); color: var(--color-text-muted); max-width: 36rem; margin: 0; }
  @media (max-width: 900px) {
    .home-top { grid-template-columns: 1fr; position: relative; margin-bottom: var(--space-6); }
    .home-copy { position: relative; z-index: 1; }
    .home-stage { position: absolute; right: -20%; top: -10%; width: 80%; height: 260px; opacity: .45; z-index: 0; pointer-events: none; }
  }
  .home-hero :global(.home-trust) { margin-top: var(--space-5); max-width: 60rem; }
  @media (max-width: 640px) {
    .home-hero { padding-top: var(--space-5); }
    .home-hero h1 { font-size: 2.25rem; margin-bottom: var(--space-3); }
    .home-lede { font-size: .9375rem; line-height: 1.5; margin-bottom: var(--space-4); }
  }
  .price-cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); }
  @media (max-width: 860px) { .price-cols { grid-template-columns: 1fr; } }
  .price-col { padding: var(--space-5); background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); }
  .price-col-h { font-size: var(--text-md); margin: 0 0 var(--space-3); }
  .price-col-h a { display: inline-flex; align-items: center; gap: .5rem; min-height: var(--tap); color: var(--color-text); text-decoration: none; }
  .price-col-h a:hover { color: var(--color-primary-hover); }
  .price-col ul { list-style: none; margin: 0; padding: 0; }
  .price-col li { display: flex; flex-direction: column; gap: .1rem; padding: var(--space-3) 0; border-top: 1px solid var(--color-border); margin: 0; }
  .price-col li a { color: var(--color-text); font-weight: var(--weight-semibold); text-decoration: none; min-height: 28px; }
  .price-col li a:hover { color: var(--color-primary-hover); text-decoration: underline; }
  .pc-price { font-size: var(--text-sm); color: var(--color-text-muted); font-variant-numeric: tabular-nums; }
  .price-foot { margin: var(--space-5) 0 0; font-size: var(--text-sm); color: var(--color-text-muted); }
  .how-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); }
  @media (max-width: 860px) { .how-grid { grid-template-columns: 1fr; } }
  .how-grid li { margin: 0; color: var(--color-text-muted); }
  .how-grid strong { display: block; color: var(--color-text); font-size: var(--text-md); margin-bottom: var(--space-1); }
  .who-card { display: grid; grid-template-columns: auto 1fr; gap: var(--space-4) var(--space-6); align-items: start; }
  .who-card p { color: var(--color-text-muted); }
  .who-h { font-size: var(--text-xl); margin: var(--space-1) 0 var(--space-3); }
  .who-more { margin: 0; }
  @media (max-width: 640px) { .who-card { grid-template-columns: 1fr; } }
  .nl-box { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-xl); padding: clamp(1.5rem, 4vw, 2.5rem); }
  .nl-box h2 { margin: var(--space-2) 0 var(--space-3); }
</style>
