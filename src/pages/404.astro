---
import { url } from '../config';
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page doesn't exist on NeonKey." noindex>
  <div class="narrow page-head">
    <h1>This door is locked.</h1>
    <p>That page doesn't exist (yet), or it moved.</p>
    <div class="btn-row"><a class="btn btn-primary" href={url('/')}>Go home</a><a class="btn btn-ghost" href={url('/lab/')}>See the Lab</a><a class="btn btn-ghost" href={url('/learn/')}>Browse tutorials</a></div>
  </div>
</Base>
