---
import { url, NEWSLETTER } from '../config';
import Base from '../layouts/Base.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Unlock the Week" description="Unlock the Week by NeonKey: a free weekly email with one tech story explained simply, a practical skill tip, gear picks from NeonKey's reviews and something to learn. Short, skimmable, unsubscribe anytime.">
  <PageHeader eyebrow="Newsletter · Weekly" title="Unlock the Week" crumbs={[{ href: '/', label: 'Home' }, { label: 'Newsletter' }]} class="nl-head">
    <p class="lede">A short weekly email: one tech story in everyday language, one skill you can try, gear picks from NeonKey's reviews and something to learn. Skimmable, about a three-minute read, free.</p>
    <Fragment slot="meta">
      <li><span>One email a week</span></li>
      <li><span>About a three-minute read</span></li>
      <li><span>Free</span></li>
      <li><span>One-click unsubscribe</span></li>
    </Fragment>
    <div class="nl-box topline nl-subscribe" slot="after">
      <h2 style="font-size:1.4rem">Subscribe</h2>
      <NewsletterForm id="page-nl" />
    </div>
  </PageHeader>
  <section style="padding-top:1rem" aria-labelledby="get-h">
    <div class="container">
      <SectionHeading id="get-h" eyebrow="Inside every issue" title="What you get" />
      <div class="grid grid-2 nl-get">
        <div class="card topline accent-cyan"><div class="panel-head"><span class="icon-chip"><Icon name="spark" /></span><h3>Tech, explained</h3></div><p>One tech story worth knowing that week, with a jargon-free takeaway and a link to the original source.</p></div>
        <div class="card topline accent-magenta"><div class="panel-head"><span class="icon-chip"><Icon name="wrench" /></span><h3>Skills and gear</h3></div><p>A small tip you can try in a few minutes, plus gear picks from NeonKey's own reviews, with the honest downsides included.</p></div>
        <div class="card topline accent-violet"><div class="panel-head"><span class="icon-chip"><Icon name="clock" /></span><h3>Cadence</h3></div><p>One email a week. No daily blasts and no extra promo sends.</p></div>
        <div class="card topline accent-amber"><div class="panel-head"><span class="icon-chip"><Icon name="shield" /></span><h3>Privacy</h3></div><p>Your email is used only to send the newsletter. It's never sold. Every issue has a one-click unsubscribe. Signups are handled by Kit; see the <a href={url('/privacy/')}>privacy policy</a>.</p></div>
      </div>
    </div>
  </section>

  <section class="alt" aria-labelledby="format-h">
    <div class="container">
      <SectionHeading id="format-h" eyebrow="Issue format" title="What an issue looks like" />
      <article class="card issue-format topline">
        <header class="issue-masthead">
          <span class="issue-brand">Unlock the Week</span>
          <span class="kicker">Issue format</span>
        </header>
        <h3>Unlock the Week: one issue a week, numbered and dated</h3>
        <ol class="step-cards issue-sections">
          <li><strong>Welcome:</strong> a short intro to the issue.</li>
          <li><strong>Tech news:</strong> one story worth knowing, with a clear takeaway and a link to the source.</li>
          <li><strong>Skill tip:</strong> a short how-to you can try in a few minutes.</li>
          <li><strong>Deals &amp; gear:</strong> picks from NeonKey's reviews, with who they suit and the honest downsides.</li>
          <li><strong>Learn spotlight:</strong> a study guide or tutorial from the Learn hub.</li>
          <li><strong>Try it:</strong> a tool or demo you can use right away, like the services quiz or a Lab demo.</li>
          <li><strong>Hit reply:</strong> tell us what tech problem to cover next. Every reply gets read.</li>
        </ol>
        <p class="muted" style="margin:.6rem 0 0;font-size:.92rem">This shows the layout only. No issues have been sent yet{NEWSLETTER.mode === 'off' ? ' and signups open soon' : ''}.</p>
      </article>
    </div>
  </section>
</Base>
