---
import { url, NEWSLETTER } from '../config';
import Base from '../layouts/Base.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
---
<Base title="Unlock the Week" description="Unlock the Week by NeonKey: a free weekly email with one tech story in plain English, a practical skill tip, gear picks from NeonKey's reviews and something to learn. Short, skimmable, unsubscribe anytime.">
  <div class="narrow page-head">
    <span class="kicker">Newsletter · Weekly</span>
    <h1>Unlock the Week</h1>
    <p class="lead">A short weekly email: one tech story in plain English, one skill you can try, gear picks from NeonKey's reviews and something to learn. Skimmable, about a three-minute read, free.</p>
    <div class="nl-box" style="margin-top:1.5rem">
      <h2 style="font-size:1.4rem">Subscribe</h2>
      <NewsletterForm id="page-nl" />
    </div>
  </div>

  <section style="padding-top:1rem" aria-labelledby="get-h">
    <div class="narrow">
      <h2 id="get-h">What you get</h2>
      <div class="grid grid-2">
        <div class="card"><h3>Tech, explained</h3><p>One tech story worth knowing that week, with a plain-English takeaway and a link to the original source.</p></div>
        <div class="card"><h3>Skills and gear</h3><p>A small tip you can try in a few minutes, plus gear picks from NeonKey's own reviews, with the honest downsides included.</p></div>
        <div class="card"><h3>Cadence</h3><p>One email a week. No daily blasts and no extra promo sends.</p></div>
        <div class="card"><h3>Privacy</h3><p>Your email is used only to send the newsletter. It's never sold. Every issue has a one-click unsubscribe. Signups are handled by Kit; see the <a href={url('/privacy/')}>privacy policy</a>.</p></div>
      </div>
    </div>
  </section>

  <section class="alt" aria-labelledby="format-h">
    <div class="narrow">
      <h2 id="format-h">What an issue looks like</h2>
      <article class="card issue-format">
        <div class="card-top"><span class="kicker">Issue format</span></div>
        <h3>Unlock the Week: one issue a week, numbered and dated</h3>
        <ol>
          <li><strong>Welcome:</strong> a short intro to the issue.</li>
          <li><strong>Tech news:</strong> one story worth knowing, with a plain-English takeaway and a link to the source.</li>
          <li><strong>Skill tip:</strong> a short how-to you can try in a few minutes.</li>
          <li><strong>Deals &amp; gear:</strong> picks from NeonKey's reviews, with who they suit and the honest downsides.</li>
          <li><strong>Learn spotlight:</strong> a study guide or tutorial from the Learn hub.</li>
          <li><strong>Try it:</strong> a tool or demo you can use right away, like the services quiz or a Lab demo.</li>
          <li><strong>Hit reply:</strong> tell us what tech problem to cover next. Every reply gets read.</li>
        </ol>
        <p class="muted" style="margin:.6rem 0 0;font-size:.92rem">This shows the layout only. No issues have been sent yet{NEWSLETTER.mode === 'off' ? ' and signups open soon' : ''}.</p>
      </article>
    </div>
  </section>
</Base>
