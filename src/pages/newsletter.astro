---
import { url, NEWSLETTER } from '../config';
import Base from '../layouts/Base.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
---
<Base title="Unlock the Week" description="Unlock the Week by NeonKey: a free weekly email with curated tech and AI articles worth reading, plus one deal or tool pick. Short, skimmable, unsubscribe anytime.">
  <div class="narrow page-head">
    <span class="kicker">Newsletter · Weekly</span>
    <h1>Unlock the Week</h1>
    <p class="lead">A short weekly email with the tech and AI articles actually worth your time, plus one deal or tool pick. Curated, skimmable, free.</p>
    <div class="nl-box" style="margin-top:1.5rem">
      <h2 style="font-size:1.4rem">Subscribe</h2>
      <NewsletterForm id="page-nl" />
    </div>
  </div>

  <section style="padding-top:1rem" aria-labelledby="get-h">
    <div class="narrow">
      <h2 id="get-h">What you get</h2>
      <div class="grid grid-2">
        <div class="card"><h3>Curated reads</h3><p>A handful of tech and AI articles worth reading that week, each with a one- or two-line note on why it matters. Links go to the original source.</p></div>
        <div class="card"><h3>One pick</h3><p>A deal, tool or app worth knowing about. If a link is an affiliate link, the issue says so right next to it.</p></div>
        <div class="card"><h3>Cadence</h3><p>One email a week. No daily blasts and no extra promo sends.</p></div>
        <div class="card"><h3>Privacy</h3><p>Your email is used only to send the newsletter. It's never sold. Every issue has a one-click unsubscribe. Signups are handled by Kit; see the <a href={url('/privacy/')}>privacy policy</a>.</p></div>
      </div>
    </div>
  </section>

  <section class="alt" aria-labelledby="format-h">
    <div class="narrow">
      <h2 id="format-h">What an issue looks like</h2>
      <article class="card issue-format">
        <div class="card-top"><span class="kicker">Issue format</span></div>
        <h3>Unlock the Week: one issue a week, numbered and dated</h3>
        <ol>
          <li><strong>The quick take:</strong> two or three sentences on the week's theme.</li>
          <li><strong>Worth reading (3–5 links):</strong> each link names the article and where it's from, plus one line on why it's worth your time.</li>
          <li><strong>Pick of the week:</strong> one deal, tool or app, what it does and who it's for, with any affiliate link labeled.</li>
          <li><strong>One small tip:</strong> a short how-to you can try in a few minutes.</li>
        </ol>
        <p class="muted" style="margin:.6rem 0 0;font-size:.92rem">This shows the layout only. No issues have been sent yet{NEWSLETTER.mode === 'off' ? ' and signups open soon' : ''}.</p>
      </article>
    </div>
  </section>
</Base>
