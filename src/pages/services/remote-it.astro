---
import { url } from '../../config';
import ProductPage from '../../layouts/ProductPage.astro';
import PriceBox from '../../components/ui/PriceBox.astro';
import Section from '../../components/ui/Section.astro';
import OfferDetails from '../../components/OfferDetails.astro';
import { remoteIt, remoteSupportPlan, usd } from '../../data/services';
import { LANE_NAMES } from '../../lib/lanes';
// "Run Your Business" lane. Product template: src/layouts/ProductPage.astro (full overhaul, Nov 14 2026).
// Custom work, so no checkout: PriceBox asks for a written quote. #support-plan stays (services.ts links to it).
// Every fact here comes from src/data/services.ts (remoteIt, remoteSupportPlan) or the page as it was before.
const setup = [
  { h: 'Business email & domain', p: 'Set up Google Workspace or Microsoft 365 on your own domain: mailboxes, extra addresses like hello@ or billing@ that land in the same inbox (aliases), shared calendars and a clean admin account that you own.' },
  { h: 'Email security (authentication)', p: 'Publish the email security settings that make it harder for scammers to fake your address (SPF, DKIM and DMARC records), so your mail is more likely to land in inboxes. Start DMARC in report-only mode (monitor mode), then tighten it once reports look clean.' },
  { h: 'Wi-Fi & router security walkthrough', p: "A guided video session on your own router: router software (firmware) updates, strong admin and Wi-Fi passwords, modern Wi-Fi encryption (WPA2/WPA3), a separate guest network and turning off features you don't use." },
  { h: 'Backups', p: 'A simple 3-2-1 plan (three copies, on two kinds of storage, one kept off-site) for the files that matter: what gets backed up, where, how often, and a test restore so you know it works.' },
  { h: 'Password manager rollout', p: 'Pick a business password manager, set up shared password folders (vaults), turn on a second login step, like a code on your phone (2FA), for key accounts and give everyone a short how-to.' },
  { h: 'Device setup checklists', p: 'A written checklist for new and departing laptops and phones: updates, disk encryption, screen lock, accounts in and out. Yours to reuse.' },
];
const d = remoteIt.details!;
const faq = [
  { q: 'What affects the price?', a: `<ul>${d.priceFactors.map((f) => `<li>${f}</li>`).join('')}</ul><p>You get a fixed written quote before any work starts.</p>` },
  { q: 'Are software subscriptions included?', a: `<p>${d.note}</p>` },
  { q: 'What do I need to provide?', a: `<ul>${d.provide.map((f) => `<li>${f}</li>`).join('')}</ul>` },
  { q: 'How long does it take?', a: `<p>${d.turnaround}</p>` },
  { q: "What's not included?", a: '<ul><li>Onsite visits or hardware installs</li><li>Government systems or contracts</li><li>Regulated data handling or compliance work (for example health records under HIPAA or card payments under PCI)</li><li>24/7, emergency or after-hours response</li><li>Guarantees of security, uptime or deliverability</li></ul><p>If something\'s outside this scope, I\'ll say so before quoting and point you to a better fit.</p>' },
];
---
<ProductPage
  title={remoteIt.name}
  description="Remote small-office IT setup: business email, SPF/DKIM/DMARC, Wi-Fi hardening, backups, password managers and device checklists. Optional monthly support."
  lane="smb"
  crumbs={[{ href: '/', label: 'Home' }, { href: '/services/', label: LANE_NAMES.smb }, { label: 'Remote IT setup' }]}
  eyebrow={`${LANE_NAMES.smb} · Fully remote`}
  heading={remoteIt.name}
  lede="Business email, email security, Wi-Fi, backups and passwords set up right, without hiring an IT department. Everything happens remotely by video call, screen share and written notes, on accounts you own."
  who="Small offices and solo pros, roughly 1 to 10 people, whose email, passwords and backups grew up by accident."
  includes={d.included}
  after={d.steps}
  afterTitle="How a setup works"
  afterIntro="You get a fixed quote before any work starts."
  faq={faq}
  trustLocation="remote-it"
>
  <PriceBox slot="price" product="remote-it" lane="smb" location="remote-it-hero">
    <ul class="pb-links"><li>Want ongoing help after? See the <a href="#support-plan">monthly support plan</a>.</li></ul>
  </PriceBox>
  <Fragment slot="meta">
    <li>Roughly 1–10 people</li>
    <li>Video call, screen share, email</li>
    <li>Admin access stays with you</li>
  </Fragment>

  <Section id="setup" title="Pick what you need" intro="A scope menu. We agree what's in before the quote." size="sm">
    <ul class="ri-menu">{setup.map((s) => <li class="ds-card ds-card-sm"><h3>{s.h}</h3><p>{s.p}</p></li>)}</ul>
  </Section>

  <Section id="support-plan" title={remoteSupportPlan.name} eyebrow="Optional add-on" intro={`${remoteSupportPlan.for}.`} tone="raised" size="sm" headingId="plan-h">
    <div class="ri-plan">
      <ul class="ds-checklist">{remoteSupportPlan.items.map((i) => <li>{i}</li>)}</ul>
      <PriceBox product="support-plan" lane="smb" location="remote-it-support-plan" />
    </div>
    <details class="ri-more">
      <summary>How the plan works, in detail</summary>
      <OfferDetails offer={remoteSupportPlan} mode="open" headingLevel="h3" showIncluded={false} />
    </details>
  </Section>

  <p slot="end" class="container ri-back"><a href={url('/services/')}>← All of {LANE_NAMES.smb}</a> · Starting at {usd(remoteIt.from)} for a setup, {usd(remoteSupportPlan.from)}/month for the plan.</p>
</ProductPage>
<style>
  .ri-menu { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); gap: var(--space-4); }
  .ri-menu li { margin: 0; }
  .ri-menu h3 { font-size: var(--text-md); margin: 0 0 var(--space-2); }
  .ri-menu p { margin: 0; color: var(--color-text-muted); font-size: var(--text-sm); }
  .ri-plan { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: var(--space-6); align-items: start; }
  @media (max-width: 860px) { .ri-plan { grid-template-columns: 1fr; } }
  .ri-more { margin-top: var(--space-6); }
  .ri-more summary { cursor: pointer; min-height: var(--tap); display: flex; align-items: center; color: var(--color-primary); font-weight: var(--weight-semibold); }
  .ri-back { font-size: var(--text-sm); color: var(--color-text-muted); padding-bottom: var(--space-12); }
  .ri-back a { color: var(--color-primary); }
</style>
