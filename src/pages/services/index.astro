---
import OfferTitle from '../../components/OfferTitle.astro';
import OfferNameLabel from '../../components/OfferNameLabel.astro';
import { url } from '../../config';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { automationOffers, remoteIt, remoteSupportPlan, frontOfficePackage as fop, emailLockdown, automationMenu, introPricing, usd } from '../../data/services';
// Page layout (Nov 2026, after two outside reviews): lead with TWO remote offers, picked by the buyer's problem.
//   $999 Front Office Package for quote and inquiry follow-up, $299 Remote Small-Office IT Setup.
//   The site is remote-only (Michael, Nov 4 2026). The on-site $249 tune-up lives only on /local/, which is not linked
//   from the site; it is the landing page for the Fairbanks Google Ads campaign and direct local outreach. Don't delete it.
//   Every smaller job sits in one short "Need just one thing?" list further down.
// Keep the old anchors (#front-office-package, #support-plan, #quick-win, #ai-faq, #lead-routing,
// #email-lockdown, #remote-it, #automation-menu, #featured-h, #auto-h): other pages, the quiz and outreach links point to them.
// Set showValue to true to bring back the crossed-out "$2,000+ value" line on the package (Michael's call).
const showValue = false;
const quickWin = automationOffers.find((o) => o.slug === 'quick-win')!;
const aiFaq = automationOffers.find((o) => o.slug === 'ai-faq')!;
const leadRouting = automationOffers.find((o) => o.slug === 'lead-routing')!;
const smallJobs = [
  { o: emailLockdown, price: usd(emailLockdown.from), line: 'Make it harder for scammers to send email pretending to be you.', href: '/contact/?topic=remote-it', cta: 'Ask about it' },
  { o: quickWin, price: `from ${usd(quickWin.from)}`, line: 'One repetitive task taken off your plate with the tools you already have.', href: `/contact/?topic=${quickWin.slug}`, cta: 'Ask about it' },
  { o: aiFaq, price: `from ${usd(aiFaq.from)}`, line: 'Just the FAQ assistant: answers common questions from answers you approve, and hands the rest to a person.', href: `/contact/?topic=${aiFaq.slug}`, cta: 'Ask about it', demo: aiFaq.demo },
  { o: leadRouting, price: `from ${usd(leadRouting.from)}`, line: 'Just the tracker and follow-up reminders, without the assistant.', href: `/contact/?topic=${leadRouting.slug}`, cta: 'Ask about it' },
  { o: remoteSupportPlan, slug: 'support-plan', price: `from ${usd(remoteSupportPlan.from)}/mo`, line: 'Changes, questions and new features after any setup. Simple changes included; bigger work quoted first. Cancel anytime.', href: '/contact/?topic=support-plan', cta: 'Ask about it' },
];
---
<Base title="Services" description="Remote help for small businesses: quote and inquiry follow-up set up for $999, or your office email, Wi-Fi, backups and passwords set up right from $299. Written scope first, built after hours, in accounts you own.">
  <PageHeader eyebrow="Services" title="Losing track of quote requests, or need your office tech set up right?" crumbs={[{ href: '/', label: 'Home' }, { label: 'Services' }]}>
    <p class="lede">Pick the one that sounds like you. Either way you get a written scope and price before any work starts.</p>
  </PageHeader>

  <section style="padding-top:0;padding-bottom:1rem" aria-labelledby="pick-h">
    <div class="container">
      <h2 id="pick-h" class="sr-only">Two ways to start</h2>
      <div class="choices">
        <a class="card topline accent-magenta choice" href="#front-office-package" data-umami-event="services-cta" data-umami-event-location="services-choice-fop">
          <span class="kicker">Lead follow-up · remote</span>
          <strong>Track every quote request and follow-up</strong>
          <span class="muted">New requests land in one list, someone is assigned, and reminders go out until the customer answers.</span>
          <span class="choice-price">{usd(fop.from)} <small>setup + 3 months of support</small></span>
          <span class="choice-go">See the Front Office Package →</span>
        </a>
        <a class="card topline accent-cyan choice" href="#remote-it" data-umami-event="services-cta" data-umami-event-location="services-choice-remote-it">
          <span class="kicker">Office IT · remote</span>
          <strong>Get your office tech set up right</strong>
          <span class="muted">Business email on your own domain, safer Wi-Fi, tested backups and a password manager, all over screen share.</span>
          <span class="choice-price">from {usd(remoteIt.from)} <small>one-time setup</small></span>
          <span class="choice-go">See the Remote IT Setup →</span>
        </a>
      </div>
      <p class="muted small-note"><strong>{introPricing.label}:</strong> {introPricing.note}</p>
    </div>
  </section>

  <section class="alt" aria-labelledby="demo-h">
    <div class="container">
      <SectionHeading id="demo-h" eyebrow="See it first" title="What happens to a new quote request" intro="Sample data, from the clickable demo. This is the flow we'd set up in your own inbox and spreadsheet." />
      <ol class="flow">
        <li><span class="flow-n">1</span><strong>A request comes in</strong><span class="muted">From your website form, email or after-hours chat.</span></li>
        <li><span class="flow-n">2</span><strong>It lands on one list</strong><span class="muted">Everyone can see what's new, what's waiting and what's done.</span></li>
        <li><span class="flow-n">3</span><strong>The right person gets it</strong><span class="muted">With a reply drafted from your templates, ready to edit and send.</span></li>
        <li><span class="flow-n">4</span><strong>Follow-ups on day 1, 3 and 7</strong><span class="muted">They stop the moment the customer answers.</span></li>
      </ol>
      <div class="btn-row" style="margin-top:1.25rem">
        <a class="btn btn-primary" href={url('/lab/front-office/?type=home')} data-umami-event="demo-click" data-umami-event-offer={fop.name} data-umami-event-location="services-flow">Try a sample request</a>
        <a class="btn btn-ghost" href={url(`/contact/?topic=${fop.slug}`)} data-umami-event="contact-click" data-umami-event-offer={fop.name} data-umami-event-location="services-flow">Book a 15-minute fit call</a>
      </div>
    </div>
  </section>

  <section aria-labelledby="fop-h">
    <div class="container">
      <article class="card offer offer-featured topline accent-magenta" id={fop.slug}>
        <div class="offer-featured-grid">
          <div>
            <span class="kicker">Remote · fixed price after scoping</span>
            <h2 id="fop-h" class="offer-h2"><OfferTitle offer={fop} /></h2>
            <OfferNameLabel offer={fop} />
            <p class="offer-outcome">For owner-led businesses that get quote requests or questions by website form, email or phone messages, and lose some to slow replies or forgotten follow-ups.</p>
            <h3 class="incl-h">What the setup includes</h3>
            <ul>
              <li>Every new inquiry in one tracker, with who's handling it and when to follow up</li>
              <li>Follow-up reminders with reply drafts, sent by a person, that stop when the customer answers</li>
              <li>An FAQ assistant that only gives answers you approved, and hands everything else to a person</li>
              <li>Business email security set up (SPF, DKIM and DMARC), so it's harder to fake your address</li>
              <li>Three months of the Monthly Remote Support Plan, so small changes are covered while it beds in</li>
            </ul>
          </div>
          <div class="offer-featured-side">
            {showValue && <p class="fop-value"><s>{usd(fop.value)}+ value</s></p>}
            <p class="price">{usd(fop.from)}<small>{introPricing.label} · scoped first</small></p>
            <p class="muted side-note">Any software fees are listed in your written quote and billed to you by that provider. After the three months, support is optional from {usd(remoteSupportPlan.from)}/mo.</p>
            <div class="btn-row">
              <a class="btn btn-primary" href={url(`/contact/?topic=${fop.slug}`)} data-umami-event="contact-click" data-umami-event-offer={fop.name} data-umami-event-location="services-package">Book a 15-minute fit call</a>
              <a class="btn btn-ghost" href={url('/lab/front-office/')} data-umami-event="demo-click" data-umami-event-offer={fop.name} data-umami-event-location="services-package">Try the demo</a>
            </div>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="alt" aria-labelledby="featured-h">
    <div class="container">
      <article class="card offer offer-featured topline accent-cyan" id={remoteIt.slug}>
        <div class="offer-featured-grid">
          <div>
            <span class="kicker">Remote · anywhere in the US</span>
            <h2 id="featured-h" class="offer-h2"><OfferTitle offer={remoteIt} /></h2>
            <OfferNameLabel offer={remoteIt} />
            <p class="offer-outcome">Your office tech set up properly, done over video and screen share.</p>
            <ul>{remoteIt.items.map((i) => <li>{i}</li>)}</ul>
          </div>
          <div class="offer-featured-side">
            <p class="price">Starting at {usd(remoteIt.from)}<small>{introPricing.label} · scoped first</small></p>
            <p class="muted side-note">You keep every login, and you get notes on everything we changed. Ongoing help is optional from {usd(remoteSupportPlan.from)}/mo.</p>
            <div class="btn-row">
              <a class="btn btn-primary" href={url('/contact/?topic=remote-it')} data-umami-event="contact-click" data-umami-event-offer={remoteIt.name} data-umami-event-location="services-remote-it">Book a 15-minute fit call</a>
              <a class="btn btn-ghost" href={url(remoteIt.href!)} data-umami-event="services-cta" data-umami-event-offer={remoteIt.name} data-umami-event-location="services-remote-it">See what's included</a>
            </div>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section aria-labelledby="how-h">
    <div class="container">
      <SectionHeading id="how-h" eyebrow="How it works" title="You know what's changing before it goes live" />
      <ol class="step-cards">
        <li><strong>Written scope and price.</strong> A short call, then a fixed quote in writing. If a simple app you already have does the job, I'll tell you.</li>
        <li><strong>Built after hours.</strong> After 4 PM Alaska time or on weekends, tested with sample requests first, so nobody loses a working hour.</li>
        <li><strong>You approve going live.</strong> We run a test together, and nothing switches on until you say so.</li>
        <li><strong>Handoff.</strong> Everything lives in accounts you control, with a walkthrough and written notes.</li>
      </ol>
      <p class="muted founder-line">NeonKey is run by Michael Ream, who holds a Computer Installation and Repair Technician certificate from the California Institute of Applied Technology (CIAT).</p>
    </div>
  </section>

  <section class="alt" aria-labelledby="auto-h" id="smaller">
    <div class="container">
      <SectionHeading id="auto-h" eyebrow="Smaller jobs" title="Need just one thing?" intro="Fixed-scope jobs for when you know exactly what you want." />
      <ul class="jobs">
        {smallJobs.map((j) => (
          <li class="job" id={j.slug ?? j.o.slug}>
            <div class="job-main">
              <h3 id={j.headingId}><OfferTitle offer={j.o} /></h3>
              <OfferNameLabel offer={j.o} />
              <p class="muted">{j.line}{j.demo && <Fragment> <a href={url(j.demo.href)} data-umami-event="demo-click" data-umami-event-offer={j.o.name} data-umami-event-location="services-small">{j.demo.label}</a>.</Fragment>}</p>
            </div>
            <div class="job-side">
              <span class="job-price">{j.price}</span>
              <a class="btn btn-ghost btn-sm" href={url(j.href)} data-umami-event="services-cta" data-umami-event-offer={j.o.name} data-umami-event-location="services-small">{j.cta}</a>
            </div>
          </li>
        ))}
      </ul>
      <details class="offer-details menu-wrap" id="automation-menu">
        <summary>Ideas: everyday jobs we can automate</summary>
        <div class="grid grid-3 menu-grid">
          {automationMenu.map((g) => (
            <div id={`menu-${g.id}`}>
              <h4>{g.title}</h4>
              <ul class="menu-list">{g.items.map((it) => <li>{it}</li>)}</ul>
            </div>
          ))}
        </div>
        <p class="muted" style="font-size:.95rem">Examples, not a promise of results. Got your own idea? <a href={url('/contact/?topic=quick-win')} data-umami-event="services-cta" data-umami-event-location="automation-menu-own-idea">Tell us about it</a>.</p>
      </details>
    </div>
  </section>

  <section aria-labelledby="faq-h">
    <div class="container faq">
      <SectionHeading id="faq-h" eyebrow="Questions" title="A few things to know before booking" />
      <details class="offer-details faq-item">
        <summary>Does anything reply to my customers without me?</summary>
        <div class="offer-details-body">
          <p>Only the FAQ assistant, and only with answers you approved in advance, like hours or service area. Anything it isn't sure about goes to a person. Quote replies and follow-ups are drafted for you, and a person on your team sends them.</p>
        </div>
      </details>
      <details class="offer-details faq-item">
        <summary>Are there software costs on top?</summary>
        <div class="offer-details-body">
          <p>Where possible we build on tools you already pay for, like your email and a spreadsheet. If a setup needs a paid tool, its monthly fee is listed in your written quote before you decide, and the provider bills you directly.</p>
        </div>
      </details>
      <details class="offer-details faq-item">
        <summary>Why not just buy software?</summary>
        <div class="offer-details-body">
          <p>Sometimes you should. If an off-the-shelf app already does exactly what you need, use it, and I'm happy to help you set it up. A custom build makes sense when an app would make you change how you work. It fits the process you already have: your categories, your spreadsheet, your steps. It can also connect or replace subscriptions that overlap, and it plugs into the tools you already use. And you own it outright, so there are no surprise price hikes or features that disappear in an update. You control where your data goes. If you'd like, I can maintain it for you, or you can run it yourself.</p>
        </div>
      </details>
      <details class="offer-details faq-item">
        <summary>How do you handle my accounts and data?</summary>
        <div class="offer-details-body">
          <p>Your accounts stay yours. You keep every admin login, and where a tool allows it I work from a separate admin account or delegated access that you can switch off, rather than your own password. I only open the settings and files the job needs. At handoff we review who has access, and you can remove mine (I'll show you how). If you're on a support plan, my access stays only for the systems the plan covers. I don't keep copies of your files or passwords after the work is done. Questions about this are welcome on the scoping call.</p>
        </div>
      </details>
      <details class="offer-details faq-item">
        <summary>Can I start small and add more later?</summary>
        <div class="offer-details-body">
          <p>Yes, that's how most people start. Begin with one fix or one module. Anything you add later is built to fit what's already there, and on the monthly plan simple changes are part of the plan. Advanced features may cost extra, and you always get the price before any work starts.</p>
        </div>
      </details>
      <div class="btn-row" style="margin-top:1.5rem">
        <a class="btn btn-primary" href={url(`/contact/?topic=${fop.slug}`)} data-umami-event="contact-click" data-umami-event-offer={fop.name} data-umami-event-location="services-faq">Book a 15-minute fit call</a>
        <a class="btn btn-ghost" href={url('/contact/?topic=remote-it')} data-umami-event="contact-click" data-umami-event-offer={remoteIt.name} data-umami-event-location="services-faq">Ask about IT setup</a>
      </div>
      <p class="muted" style="margin-top:1.5rem;font-size:.95rem">Not ready for a project? Grab the <a href={url('/free-it-kit/')} data-umami-event="free-kit-cta" data-umami-event-location="services">free Starter IT Kit</a> to check your own accounts in 10 minutes, or take the <a href={url('/services/quiz/')} data-umami-event="quiz-cta" data-umami-event-location="services">2-minute quiz</a>.</p>
      <p class="muted" style="font-size:.9rem">Prices shown are starting points, not quotes. Outcomes depend on your business, your tools and your data; no specific results are promised.</p>
    </div>
  </section>
</Base>

<script is:inline>
  (() => {
    const open = () => { const h = location.hash.slice(1); const d = document.getElementById('automation-menu'); if (d && (h === 'automation-menu' || h.startsWith('menu-'))) { d.open = true; const t = document.getElementById(h); if (t) t.scrollIntoView(); } };
    open(); window.addEventListener('hashchange', open);
  })();
</script>

<style>
  .choices { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  @media (max-width: 760px) { .choices { grid-template-columns: 1fr; } }
  .choice { display: flex; flex-direction: column; gap: .4rem; text-decoration: none; color: inherit; height: 100%; }
  .choice strong { font-size: 1.3rem; color: var(--text); line-height: 1.25; }
  .choice .muted { font-size: .98rem; }
  .choice-price { font-size: 1.9rem; font-weight: 800; color: var(--text); margin-top: .3rem; font-variant-numeric: tabular-nums; }
  .choice-price small { font-size: .9rem; font-weight: 500; color: var(--muted); }
  .choice-go { margin-top: auto; color: var(--cyan); font-weight: 600; }
  .choice:hover .choice-go { text-decoration: underline; }
  .small-note { margin: 1rem 0 0; font-size: .92rem; }
  .flow { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .9rem; }
  @media (max-width: 900px) { .flow { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .flow { grid-template-columns: 1fr; } }
  .flow li { display: flex; flex-direction: column; gap: .3rem; padding: 1rem; border: 1px solid var(--line); border-radius: 12px; background: var(--bg-2); }
  .flow-n { font-weight: 800; color: var(--magenta, var(--cyan)); font-size: 1.2rem; }
  .flow .muted { font-size: .93rem; }
  .offer-h2 { font-size: 1.6rem; margin: .4rem 0 0; }
  .incl-h { font-size: 1.05rem; margin: 1rem 0 .3rem; }
  .side-note { font-size: .92rem; }
  .fop-value { margin: 0 0 -.4rem; color: var(--muted); font-weight: 600; }
  .offer[id], #smaller, .job { scroll-margin-top: 90px; }
  .founder-line { margin-top: 1.25rem; font-size: .95rem; max-width: 860px; }
  .jobs { list-style: none; margin: 0; padding: 0; display: grid; gap: .6rem; }
  .job { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: .9rem 1.1rem; border: 1px solid var(--line); border-radius: 12px; background: var(--bg-2); }
  .job h3 { font-size: 1.08rem; margin: 0; }
  .job p { margin: .2rem 0 0; font-size: .93rem; }
  .job-side { display: flex; align-items: center; gap: .9rem; flex-shrink: 0; }
  .job-price { font-weight: 700; white-space: nowrap; font-variant-numeric: tabular-nums; }
  @media (max-width: 640px) { .job { flex-direction: column; align-items: flex-start; } }
  .menu-wrap { margin-top: 1.5rem; }
  .menu-wrap > summary { color: var(--text); font-size: 1.05rem; }
  .menu-grid { margin-top: 1rem; }
  .menu-grid h4 { margin: 0 0 .5rem; font-size: 1rem; }
  .menu-list { margin: 0 0 .9rem; padding-left: 1.1rem; font-size: .93rem; }
  .menu-list li { margin-bottom: .35rem; }
  [id^="menu-"] { scroll-margin-top: 90px; }
  .faq .faq-item { max-width: 860px; }
  .step-cards > li strong:first-child { display: inline; font-size: inherit; }
  .faq-item { border-bottom: 1px solid var(--line); padding-bottom: .7rem; }
  .faq-item > summary { color: var(--text); font-size: 1.05rem; }
  .faq-item .offer-details-body { font-size: 1rem; margin-top: .6rem; }
</style>
