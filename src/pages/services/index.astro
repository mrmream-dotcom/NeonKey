---
import LockdownStrip from '../../components/LockdownStrip.astro';
import OfferTitle from '../../components/OfferTitle.astro';
import OfferNameLabel from '../../components/OfferNameLabel.astro';
import { url } from '../../config';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import DeskSale from '../../components/DeskSale.astro';
import { automationOffers, remoteIt, remoteSupportPlan, frontOfficePackage as fop, emailLockdown, followUpDesk, followUpDeskTrialDays, followUpDeskSale, followUpDeskSaleLive, automationMenu, introPricing, showPackageValue, usd } from '../../data/services';
// Page layout (Nov 2026, after two outside reviews): lead with TWO remote offers, picked by the buyer's problem.
//   $999 Front Office Package for quote and inquiry follow-up, $299 Remote Small-Office IT Setup.
//   The site is remote-only (Michael, Nov 4 2026). The on-site $249 tune-up lives only on /local/, which is not linked
//   from the site; it is the landing page for the Fairbanks Google Ads campaign and direct local outreach. Don't delete it.
//   Every smaller job sits in one short "Need just one thing?" list further down.
// Keep the old anchors (#front-office-package, #support-plan, #quick-win, #ai-faq, #lead-routing,
// #email-lockdown, #remote-it, #automation-menu, #featured-h, #auto-h): other pages, the quiz and outreach links point to them.
// The crossed-out "$2,000+ value" line is controlled site-wide by showPackageValue in src/data/services.ts.
// The $499 and $799 parts are not listed on their own (reviewers: it invites a $799 vs $999 comparison); they are
// downsells for calls and email. Their old anchors (#ai-faq, #lead-routing) now land on the package card.
const quickWin = automationOffers.find((o) => o.slug === 'quick-win')!;
const smallJobs = [
  { o: emailLockdown, price: `${usd(emailLockdown.from)} flat`, line: 'Make it harder for scammers to send email pretending to be you. Buy online and get the exact fixes by email, usually within minutes. No call or passwords needed.', href: emailLockdown.buyUrl!, cta: 'Buy now', buy: true, more: '/services/email-lockdown/' },
  { o: quickWin, price: `from ${usd(quickWin.from)}`, line: 'One website form connected to a shared list, with an alert to one person on each new request, so none sit unseen.', href: `/contact/?topic=${quickWin.slug}`, cta: 'Ask about it' },
  { o: remoteSupportPlan, slug: 'support-plan', price: `from ${usd(remoteSupportPlan.from)}/mo`, line: 'Changes, questions and new features after any setup. Simple changes included; bigger work quoted first. Cancel anytime.', href: '/contact/?topic=support-plan', cta: 'Ask about it' },
];
---
<Base title="Lead and Estimate Follow-Up Services" description="Stop losing customers to slow replies and quotes that go quiet: start the self-serve Follow-Up Desk with 14 days free, or have a custom follow-up system set up for you. Remote, anywhere in the US.">
  <PageHeader eyebrow="Services" title="Stop losing customers to slow replies and quiet quotes" crumbs={[{ href: '/', label: 'Home' }, { label: 'Services' }]}>
    <p class="lede">Two ways to start: have a custom system set up for you with a written scope and price first, or run the {followUpDesk.name} yourself with {followUpDeskTrialDays} days free. Need office IT instead? <a href="#remote-it">That's further down</a>.</p>
  </PageHeader>

  <section style="padding-top:0;padding-bottom:1rem" aria-labelledby="pick-h">
    <div class="container">
      <h2 id="pick-h" class="sr-only">Two ways to start</h2>
      <div class="choices">
        <div class="card topline accent-magenta choice">
          <span class="kicker">Done for you · custom setup · remote</span>
          <strong><OfferTitle offer={fop} /></strong>
          <span class="choice-name">{fop.name}</span>
          <span class="muted">Requests from your website form or shared inbox land on one list, and the right person gets an alert. Quotes that go quiet get a reminder on day 1, 3 and 7.</span>
          <span class="choice-price">{usd(fop.from)} <small>setup + 3 months of support</small></span>
          <div class="btn-row choice-btns">
            <a class="btn btn-primary btn-sm" href={url(`/contact/?topic=${fop.slug}`)} data-umami-event="contact-click" data-umami-event-offer={fop.name} data-umami-event-location="services-choice-fop">Get a written quote</a>
            <a class="btn btn-ghost btn-sm" href="#front-office-package" data-umami-event="services-cta" data-umami-event-location="services-choice-fop">What's included</a>
          </div>
        </div>
        <div class="card topline accent-violet choice" id={followUpDesk.slug}>
          <span class="kicker">Do it yourself · start today</span>
          <strong><OfferTitle offer={followUpDesk} /></strong>
          <span class="choice-name">{followUpDesk.name}</span>
          <span class="muted">Add the estimates you sent, or paste a list from QuickBooks. Polite follow-ups go out under your business name and stop the moment your customer replies.</span>
          {followUpDeskSaleLive
            ? <Fragment><DeskSale location="services-choice-fud" />
              <div class="btn-row choice-btns">
            <a class="btn btn-ghost btn-sm" href={url(followUpDesk.href)} data-umami-event="services-cta" data-umami-event-offer={followUpDesk.name} data-umami-event-location="services-choice-fud">How it works</a>
              </div></Fragment>
            : <Fragment><span class="choice-price">{usd(followUpDesk.from)} <small>a month</small></span>
              <span class="choice-trial">{followUpDeskTrialDays} days free. Card required, cancel anytime.</span>
              <div class="btn-row choice-btns">
            <a class="btn btn-primary btn-sm" href={followUpDesk.buyUrl} rel="noopener" data-umami-event="buy-click" data-umami-event-offer={followUpDesk.name} data-umami-event-location="services-choice-fud">Start free trial</a>
            <a class="btn btn-ghost btn-sm" href={url(followUpDesk.href)} data-umami-event="services-cta" data-umami-event-offer={followUpDesk.name} data-umami-event-location="services-choice-fud">How it works</a>
              </div></Fragment>}
        </div>
      </div>
      <LockdownStrip location="services-lockdown-strip" />
      <p class="muted small-note"><strong>{introPricing.label}:</strong> {introPricing.note}</p>
    </div>
  </section>

  {/* Audit Nov 7 2026 (A3): the two follow-up offers side by side, so a buyer can tell them apart without another page.
      Keep every cell true to the Desk page and the package card. The Desk price uses DeskSale's [data-sale-ends] swap
      (its script is on this page via the choice card), so it changes to the regular price at the deadline. */}
  <section aria-labelledby="compare-h" id="compare" style="padding-top:1rem">
    <div class="container">
      <SectionHeading id="compare-h" eyebrow="Compare" title={`${fop.name} or ${followUpDesk.name}?`} intro="Both stop quotes from going quiet. The difference is who sends the follow-ups and where it runs." />
      <div class="table-scroll">
        <table class="vlan-table compare">
          <thead><tr><th scope="col"><span class="sr-only">Question</span></th><th scope="col">{fop.name}</th><th scope="col">{followUpDesk.name}</th></tr></thead>
          <tbody>
            <tr><th scope="row">What it handles</th><td data-label={fop.name}>New requests from your website form and shared inbox, who handles each one, reply drafts, follow-up reminders, an FAQ assistant and email security</td><td data-label={followUpDesk.name}>Follow-ups on estimates you've already sent</td></tr>
            <tr><th scope="row">How work gets in</th><td data-label={fop.name}>Your website form and shared inbox feed one list on their own</td><td data-label={followUpDesk.name}>You add estimates, or paste a list from QuickBooks or a spreadsheet</td></tr>
            <tr><th scope="row">Who sends follow-ups</th><td data-label={fop.name}>A person on your team, from your own inbox. You get a reminder with a draft ready</td><td data-label={followUpDesk.name}>The Desk sends them on weekday mornings, from your business name at a NeonKey sending address. Replies go to your inbox and stop that job's follow-ups</td></tr>
            <tr><th scope="row">Where it runs</th><td data-label={fop.name}>In your own accounts and tools, set up for you</td><td data-label={followUpDesk.name}>On NeonKey's hosted service. You set it up yourself in about five minutes</td></tr>
            <tr><th scope="row">If you stop paying NeonKey</th><td data-label={fop.name}>What we built stays in your accounts. Any third-party software fees continue with that provider</td><td data-label={followUpDesk.name}>Follow-ups stop when your subscription ends, and your list is deleted 30 days later</td></tr>
            <tr><th scope="row">Getting started</th><td data-label={fop.name}>Written scope and fixed quote first. Nothing goes live until you approve it</td><td data-label={followUpDesk.name}>{followUpDeskTrialDays} days free, card required, no call</td></tr>
            <tr><th scope="row">Price</th><td data-label={fop.name}>{usd(fop.from)} setup + 3 months of support. Software fees, if any, listed in your quote</td><td data-label={followUpDesk.name}>{followUpDeskSaleLive
              ? <span data-sale-ends={followUpDeskSale.endsAt}><span data-sale>{usd(followUpDeskSale.monthly)}/month founding price if you start by {followUpDeskSale.endsLabel}, or {usd(followUpDeskSale.annualPerYear)}/year</span><span data-sale-after hidden>{usd(followUpDesk.from)}/month</span></span>
              : <Fragment>{usd(followUpDesk.from)}/month</Fragment>}</td></tr>
          </tbody>
        </table>
      </div>
      <div class="btn-row" style="margin-top:1rem">
        <a class="btn btn-ghost btn-sm" href={url(`/contact/?topic=${fop.slug}`)} data-umami-event="contact-click" data-umami-event-offer={fop.name} data-umami-event-location="services-compare">Get a written quote</a>
        <a class="btn btn-ghost btn-sm" href={url(followUpDesk.href)} data-umami-event="services-cta" data-umami-event-offer={followUpDesk.name} data-umami-event-location="services-compare">How the {followUpDesk.name} works</a>
      </div>
    </div>
  </section>

  <section class="alt" aria-labelledby="demo-h">
    <div class="container">
      <SectionHeading id="demo-h" eyebrow="See it first" title="What happens to a new quote request" intro="A sample request from the clickable demo (made-up business and customer). This is the flow we'd set up in your own inbox and spreadsheet." />
      <ol class="flow">
        <li><span class="flow-n">Tue 7:42 AM</span><strong>A website form comes in</strong><span class="muted">"Looking for a quote to replace two bathroom fans. Do you do free estimates?"</span></li>
        <li><span class="flow-n">Same minute</span><strong>It's added to your list</strong><span class="muted">Logged in your Google Sheet as "Needs reply · Today", so it can't get buried in the inbox.</span></li>
        <li><span class="flow-n">Assigned</span><strong>Dana gets it, with a draft</strong><span class="muted">Estimate requests go to the owner, with a reply drafted from approved templates. Nothing goes out until Dana sends it.</span></li>
        <li><span class="flow-n">Day 1, 3 and 7</span><strong>Follow-up reminders</strong><span class="muted">If the customer goes quiet, Dana gets a reminder with a draft ready. They stop the moment the customer replies.</span></li>
      </ol>
      <div class="btn-row" style="margin-top:1.25rem">
        <a class="btn btn-primary" href={url('/lab/front-office/?type=home')} data-umami-event="demo-click" data-umami-event-offer={fop.name} data-umami-event-location="services-flow">Try a sample request</a>
        <a class="btn btn-ghost" href={url(`/contact/?topic=${fop.slug}`)} data-umami-event="contact-click" data-umami-event-offer={fop.name} data-umami-event-location="services-flow">Get a written quote</a>
      </div>
    </div>
  </section>

  <section aria-labelledby="fop-h">
    <div class="container">
      <span id="ai-faq" class="anchor"></span><span id="lead-routing" class="anchor"></span>
      <article class="card offer offer-featured topline accent-magenta" id={fop.slug}>
        <div class="offer-featured-grid">
          <div>
            <span class="kicker">Remote · fixed written quote</span>
            <h2 id="fop-h" class="offer-h2"><OfferTitle offer={fop} /></h2>
            <OfferNameLabel offer={fop} />
            <p class="offer-outcome">Reply to new requests faster and stop quotes from going cold. For owner-led businesses that get requests by website form or email and lose some to slow replies or forgotten follow-ups.</p>
            <h3 class="incl-h">What the setup includes</h3>
            <ul>
              <li>Requests from your website form and shared inbox in one list, with who's handling each one and when to follow up</li>
              <li>Reply drafts from your approved templates, and follow-up reminders on day 1, 3 and 7 that stop when the customer replies. A person sends every quote reply and follow-up</li>
              <li>An FAQ assistant that only gives answers you approved, and hands everything else to a person</li>
              <li>Business email security set up (SPF, DKIM and DMARC), so it's harder to fake your address</li>
              <li>Three months of the Monthly Remote Support Plan, so small changes are covered while it beds in</li>
            </ul>
            <p class="muted side-note">Want to win back old quotes and past customers too? We can add a win-back follow-up list with drafts for you to send, included in your written quote if you want it.</p>
            <p class="muted side-note">Phone calls aren't part of this setup. They still need a person or a separate phone setup, which we can quote.</p>
          </div>
          <div class="offer-featured-side">
            {showPackageValue && <p class="fop-value"><s>{usd(fop.value)}+ value</s></p>}
            <p class="price">{usd(fop.from)}<small>{introPricing.label} · scoped first</small></p>
            <p class="muted side-note">Any software fees are listed in your written quote and billed to you by that provider. After the three months, support is optional from {usd(remoteSupportPlan.from)}/mo.</p>
            <div class="btn-row">
              <a class="btn btn-primary" href={url(`/contact/?topic=${fop.slug}`)} data-umami-event="contact-click" data-umami-event-offer={fop.name} data-umami-event-location="services-package">Get a written quote</a>
              <a class="btn btn-ghost" href={url('/lab/front-office/')} data-umami-event="demo-click" data-umami-event-offer={fop.name} data-umami-event-location="services-package">Try the demo</a>
            </div>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="alt" aria-labelledby="how-h">
    <div class="container">
      <SectionHeading id="how-h" eyebrow="How custom setups work" title="You know what's changing before it goes live" intro={`For the ${fop.name} and other custom work. The ${followUpDesk.name} is self-serve, so none of this is needed.`} />
      <ol class="step-cards">
        <li><strong>Written scope and price.</strong> Tell us what you need by message (or a short call, if you prefer), then get a fixed quote in writing. If a simple app you already have does the job, I'll tell you.</li>
        <li><strong>Built after hours.</strong> After business hours or on weekends, tested with sample requests first, so the setup work stays out of your business day.</li>
        <li><strong>You approve going live.</strong> We run a test together, and nothing switches on until you say so.</li>
        <li><strong>Handoff.</strong> Everything lives in accounts you control, with a walkthrough and written notes.</li>
      </ol>
      <p class="muted founder-line">NeonKey is run by Michael Ream, who has worked in the IT industry for most of his adult career.</p>
    </div>
  </section>

  <section aria-labelledby="auto-h" id="smaller">
    <div class="container">
      <SectionHeading id="auto-h" eyebrow="Smaller jobs" title="Need just one thing?" intro="Fixed-scope jobs for when you know exactly what you want." />
      <ul class="jobs">
        {smallJobs.map((j) => (
          <li class="job" id={j.slug ?? j.o.slug}>
            <div class="job-main">
              <h3 id={j.headingId}><OfferTitle offer={j.o} /></h3>
              <OfferNameLabel offer={j.o} />
              <p class="muted">{j.line}{j.demo && <Fragment> <a href={url(j.demo.href)} data-umami-event="demo-click" data-umami-event-offer={j.o.name} data-umami-event-location="services-small">{j.demo.label}</a>.</Fragment>}</p>
            </div>
            <div class="job-side">
              <span class="job-price">{j.price}</span>
              {j.more && <a class="btn btn-ghost btn-sm" href={url(j.more)} data-umami-event="services-cta" data-umami-event-offer={j.o.name} data-umami-event-location="services-small-details">Details</a>}
              {j.buy
                ? <a class="btn btn-primary btn-sm" href={j.href} rel="noopener" data-umami-event="buy-click" data-umami-event-offer={j.o.name} data-umami-event-location="services-small">{j.cta}</a>
                : <a class="btn btn-ghost btn-sm" href={url(j.href)} data-umami-event="services-cta" data-umami-event-offer={j.o.name} data-umami-event-location="services-small">{j.cta}</a>}
            </div>
          </li>
        ))}
      </ul>
      <details class="offer-details menu-wrap" id="automation-menu">
        <summary>Ideas: everyday jobs we can automate</summary>
        <div class="grid grid-3 menu-grid">
          {automationMenu.map((g) => (
            <div id={`menu-${g.id}`}>
              <h4>{g.title}</h4>
              <ul class="menu-list">{g.items.map((it) => <li>{it}</li>)}</ul>
            </div>
          ))}
        </div>
        <p class="muted" style="font-size:.95rem">Examples, not a promise of results. Got your own idea? <a href={url('/contact/?topic=quick-win')} data-umami-event="services-cta" data-umami-event-location="automation-menu-own-idea">Tell us about it</a>.</p>
      </details>
    </div>
  </section>

  <section class="alt" aria-labelledby="featured-h">
    <div class="container">
      <article class="card offer offer-featured topline accent-cyan" id={remoteIt.slug}>
        <div class="offer-featured-grid">
          <div>
            <span class="kicker">Remote · anywhere in the US</span>
            <h2 id="featured-h" class="offer-h2"><OfferTitle offer={remoteIt} /></h2>
            <OfferNameLabel offer={remoteIt} />
            <p class="offer-outcome">Your office tech set up properly, done over video and screen share.</p>
            <ul>{remoteIt.items.map((i) => <li>{i}</li>)}</ul>
          </div>
          <div class="offer-featured-side">
            <p class="price">Starting at {usd(remoteIt.from)}<small>{introPricing.label} · scoped first</small></p>
            <p class="muted side-note">You keep every login, and you get notes on everything we changed. Ongoing help is optional from {usd(remoteSupportPlan.from)}/mo.</p>
            <div class="btn-row">
              <a class="btn btn-primary" href={url('/contact/?topic=remote-it')} data-umami-event="contact-click" data-umami-event-offer={remoteIt.name} data-umami-event-location="services-remote-it">Get a written quote</a>
              <a class="btn btn-ghost" href={url(remoteIt.href!)} data-umami-event="services-cta" data-umami-event-offer={remoteIt.name} data-umami-event-location="services-remote-it">See what's included</a>
            </div>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section aria-labelledby="faq-h">
    <div class="container faq">
      <SectionHeading id="faq-h" eyebrow="Questions" title="A few things to know before you ask for a quote" />
      <details class="offer-details faq-item">
        <summary>How do I know if I'm losing leads?</summary>
        <div class="offer-details-body">
          <p>Look back at last month and check three things: how long it took to send the first reply to each new inquiry, how many quotes got no follow-up after the first message, and how many past customers you haven't contacted in a year. If any answer surprises you, that's the place to start. Tell us what you find and we'll suggest the smallest fix that helps.</p>
        </div>
      </details>
      <details class="offer-details faq-item">
        <summary>Does anything reply to my customers without me?</summary>
        <div class="offer-details-body">
          <p>It depends on which one you pick.</p>
          <p><strong>{fop.name}:</strong> only the FAQ assistant replies on its own, and only with answers you approved in advance, like hours or service area. Anything it isn't sure about goes to a person. Quote replies and follow-ups are drafted for you, and a person on your team sends them.</p>
          <p><strong>{followUpDesk.name}:</strong> yes, that's the point of it. Follow-ups on the estimates you add go out on their own, in wording you write and can edit, and they stop the moment the customer replies. You can send yourself a preview first and stop any job with one click. <a href="#compare">Compare the two</a>.</p>
        </div>
      </details>
      <details class="offer-details faq-item">
        <summary>Are there software costs on top?</summary>
        <div class="offer-details-body">
          <p>Where possible we build on tools you already pay for, like your email and a spreadsheet. If a setup needs a paid tool, its monthly fee is listed in your written quote before you decide, and the provider bills you directly.</p>
        </div>
      </details>
      <details class="offer-details faq-item">
        <summary>Why not just buy software?</summary>
        <div class="offer-details-body">
          <p>Sometimes you should. If an off-the-shelf app already does exactly what you need, use it, and I'm happy to help you set it up. A custom build makes sense when an app would make you change how you work. It fits the process you already have: your categories, your spreadsheet, your steps. It can also connect or replace subscriptions that overlap, and it plugs into the tools you already use. And you own it outright, so there are no surprise price hikes or features that disappear in an update. You control where your data goes. If you'd like, I can maintain it for you, or you can run it yourself.</p>
        </div>
      </details>
      <details class="offer-details faq-item">
        <summary>How do you handle my accounts and data?</summary>
        <div class="offer-details-body">
          <p>Your accounts stay yours. You keep every admin login, and where a tool allows it I work from a separate admin account or delegated access that you can switch off, rather than your own password. I only open the settings and files the job needs. At handoff we review who has access, and you can remove mine (I'll show you how). If you're on a support plan, my access stays only for the systems the plan covers. I don't keep copies of your files or passwords after the work is done. Questions about this are welcome anytime before you approve a quote.</p>
        </div>
      </details>
      <details class="offer-details faq-item">
        <summary>Can I start small and add more later?</summary>
        <div class="offer-details-body">
          <p>Yes, that's how most people start. Begin with one fix or one module. Anything you add later is built to fit what's already there, and on the monthly plan simple changes are part of the plan. Advanced features may cost extra, and you always get the price before any work starts.</p>
        </div>
      </details>
      <div class="btn-row" style="margin-top:1.5rem">
        <a class="btn btn-primary" href={url(`/contact/?topic=${fop.slug}`)} data-umami-event="contact-click" data-umami-event-offer={fop.name} data-umami-event-location="services-faq">Get a written quote</a>
        <a class="btn btn-ghost" href={url('/contact/?topic=remote-it')} data-umami-event="contact-click" data-umami-event-offer={remoteIt.name} data-umami-event-location="services-faq">Ask about IT setup</a>
      </div>
      <p class="muted" style="margin-top:1.5rem;font-size:.95rem">Not ready for a project? Grab the <a href={url('/free-it-kit/')} data-umami-event="free-kit-cta" data-umami-event-location="services">free Starter IT Kit</a> to check your own accounts in 10 minutes, or take the <a href={url('/services/quiz/')} data-umami-event="quiz-cta" data-umami-event-location="services">2-minute quiz</a>. Or get <a href={url('/newsletter/')} data-umami-event="newsletter-cta" data-umami-event-location="services">Unlock the Week</a>: one short fix every Wednesday for catching more customers and keeping your tech secure.</p>
      <p class="muted" style="font-size:.9rem">Prices shown are starting points, not quotes. Outcomes depend on your business, your tools and your data; no specific results are promised.</p>
    </div>
  </section>
</Base>

<script is:inline>
  (() => {
    const open = () => { const h = location.hash.slice(1); const d = document.getElementById('automation-menu'); if (d && (h === 'automation-menu' || h.startsWith('menu-'))) { d.open = true; const t = document.getElementById(h); if (t) t.scrollIntoView(); } };
    open(); window.addEventListener('hashchange', open);
  })();
</script>

<style>
  .choices { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  @media (max-width: 760px) { .choices { grid-template-columns: 1fr; } }
  .choice { display: flex; flex-direction: column; gap: .4rem; text-decoration: none; color: inherit; height: 100%; }
  .choice strong { font-size: 1.3rem; color: var(--text); line-height: 1.25; }
  .choice .muted { font-size: .98rem; }
  .choice-name { font-size: .85rem; font-weight: 600; color: var(--muted); margin-top: -.2rem; }
  .choice-price { font-size: 1.9rem; font-weight: 800; color: var(--text); margin-top: .3rem; font-variant-numeric: tabular-nums; }
  .choice-price small { font-size: .9rem; font-weight: 500; color: var(--muted); }
  .choice-btns { margin-top: auto; padding-top: .4rem; }
  .choice-trial { font-size: .92rem; font-weight: 600; color: var(--cyan); margin-top: -.3rem; }
