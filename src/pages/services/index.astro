---
import { url } from '../../config';
import Base from '../../layouts/Base.astro';
import OfferDetails from '../../components/OfferDetails.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { automationOffers, remoteIt, remoteSupportPlan, frontOfficePackage as fop, automationMenu, introPricing, usd } from '../../data/services';
const offerCount = automationOffers.length + 3;
const accents = ['accent-cyan', 'accent-magenta', 'accent-violet', 'accent-amber'];
---
<Base title="Services" description="NeonKey services for small businesses: remote small-office IT setup, a monthly support plan, an on-site Office Tech Tune-Up in Fairbanks and North Pole, practical AI automations and an all-inclusive Front Office Package. Scoped first, explained clearly.">
  <PageHeader eyebrow="Services · Unlock AI" title="Practical IT and automation for small businesses" crumbs={[{ href: '/', label: 'Home' }, { label: 'Services' }]}>
    <p class="lede">Office IT setup, a monthly support plan and small automations, explained in simple terms. Every project starts with a short scoping call so we agree on what "done" looks like before any work begins, and setup happens after 4 PM Alaska time or on weekends so your staff never lose a working hour.</p>
    <Fragment slot="meta">
      <li><span><strong>{offerCount}</strong> services</span></li>
      <li><span>Remote across the US · On-site in Fairbanks and North Pole</span></li>
      <li><span>Scoped before work begins</span></li>
      <li><span>You own every account</span></li>
    </Fragment>
  </PageHeader>

  <div class="container">
    <p class="intro-pricing" role="note"><strong>{introPricing.label}.</strong> {introPricing.note}</p>
  </div>

  <section style="padding-top:0;padding-bottom:1rem" aria-labelledby="pick-h">
    <div class="container">
      <SectionHeading id="pick-h" eyebrow="Start here" title="What do you need?" />
      <div class="grid grid-3 pick-grid">
        <a class="card topline accent-cyan pick-card" href={url('/local/')} data-umami-event="services-cta" data-umami-event-location="services-pick-local">
          <span class="kicker">On-site · Fairbanks and North Pole</span>
          <strong>Someone to come to my office</strong>
          <span class="muted">Office Tech Tune-Up, $249. Wi-Fi, backups, passwords, email security and printers in one visit.</span>
        </a>
        <a class="card topline accent-magenta pick-card" href="#featured-h" data-umami-event="services-cta" data-umami-event-location="services-pick-remote">
          <span class="kicker">Remote · Anywhere in the US</span>
          <strong>My office tech set up properly</strong>
          <span class="muted">Remote Small-Office IT Setup from {usd(remoteIt.from)}, with an optional monthly support plan.</span>
        </a>
        <a class="card topline accent-violet pick-card" href="#front-office-package" data-umami-event="services-cta" data-umami-event-location="services-pick-ai">
          <span class="kicker">AI and automation</span>
          <strong>A repetitive job taken off my plate</strong>
          <span class="muted">From a {usd(automationOffers[0].from)} Quick Win to the all-in-one Front Office Package.</span>
        </a>
      </div>
      <p class="muted" style="margin:1rem 0 0;font-size:.95rem">Not sure? <a href={url('/services/quiz/')} data-umami-event="quiz-cta" data-umami-event-location="services">Take the 2-minute quiz</a>: eight quick questions, no email needed.</p>
    </div>
  </section>

  <section style="padding-top:1rem;padding-bottom:1rem" aria-labelledby="fop-h">
    <div class="container">
      <p class="section-label"><span class="pulse" aria-hidden="true"></span>Start-Up Deal · All-inclusive package</p>
      <article class="card offer offer-featured topline accent-magenta" id={fop.slug}>
        <div class="offer-featured-grid">
          <div>
            <span class="kicker">{fop.kicker} · Everything in one project</span>
            <h2 id="fop-h" style="font-size:1.6rem;margin-top:.4rem">{fop.headline ?? fop.name}</h2>
            {fop.headline && <p class="offer-name">{fop.name}</p>}
            <p class="offer-outcome">{fop.outcome}.</p>
            <p class="muted">{fop.for}.</p>
            <ul>{fop.items.map((i) => <li>{i}</li>)}</ul>
            <OfferDetails offer={fop} />
          </div>
          <div class="offer-featured-side">
            <p class="fop-value"><s>{usd(fop.value)}+ value</s></p>
            <p class="price">{usd(fop.from)}<small>Start-Up Deal · founding-client rate · scoped first</small></p>
            <ul class="fop-parts" aria-label="What's bundled">
              {fop.parts.map((p) => <li><span>{p.name}</span> <span class="muted">{p.value}</span></li>)}
            </ul>
            <p class="muted" style="font-size:.95rem">The same four parts at standard rates come to {usd(fop.separately)}. As the Start-Up Deal, at the founding-client rate, they are planned and built as one system for {usd(fop.from)}.</p>
            <div class="btn-row">
              <a class="btn btn-primary" href={url(`/contact/?topic=${fop.slug}`)} data-umami-event="contact-click" data-umami-event-offer={fop.name} data-umami-event-location="services-package">Ask about the package</a>
              <a class="btn btn-ghost" href="#auto-h" data-umami-event="services-cta" data-umami-event-offer={fop.name} data-umami-event-location="services-package">See the parts</a>
            </div>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section style="padding-top:1rem" aria-labelledby="featured-h">
    <div class="container">
      <p class="section-label"><span class="pulse" aria-hidden="true"></span>Remote office IT</p>
      <article class="card offer offer-featured topline">
        <div class="offer-featured-grid">
          <div>
            <span class="kicker">Remote · Anywhere in the US</span>
            <h2 id="featured-h" style="font-size:1.6rem;margin-top:.4rem">{remoteIt.headline ?? remoteIt.name}</h2>
            {remoteIt.headline && <p class="offer-name">{remoteIt.name}</p>}
            <p class="offer-outcome">{remoteIt.outcome}.</p>
            <p class="muted">For small offices and solo pros. {remoteIt.for}.</p>
            <ul>{remoteIt.items.map((i) => <li>{i}</li>)}</ul>
            <OfferDetails offer={remoteIt} />
          </div>
          <div class="offer-featured-side">
            <p class="price">Starting at {usd(remoteIt.from)}<small>Scoped per project</small></p>
            <p class="muted" style="font-size:.95rem">Optional add-on: <a href="#support-plan">{remoteSupportPlan.name}</a>, starting at {usd(remoteSupportPlan.from)}/mo.</p>
            <div class="btn-row">
              <a class="btn btn-primary" href={url(remoteIt.href!)} data-umami-event="services-cta" data-umami-event-offer={remoteIt.name} data-umami-event-location="services-featured">See what's included</a>
              <a class="btn btn-ghost" href={url('/contact/?topic=remote-it')} data-umami-event="contact-click" data-umami-event-offer={remoteIt.name}>Get in touch</a>
            </div>
          </div>
        </div>
      </article>

      <article class="card offer support-card topline accent-violet" id="support-plan" style="margin-top:1.25rem">
        <div class="offer-featured-grid">
          <div>
            <span class="kicker">Optional add-on</span>
            <h3 style="font-size:1.3rem;margin-top:.4rem">{remoteSupportPlan.headline ?? remoteSupportPlan.name}</h3>
            {remoteSupportPlan.headline && <p class="offer-name">{remoteSupportPlan.name}</p>}
            <p class="offer-outcome">{remoteSupportPlan.outcome}.</p>
            <p class="muted">{remoteSupportPlan.for}.</p>
            <ul>{remoteSupportPlan.items.map((i) => <li>{i}</li>)}</ul>
            <OfferDetails offer={remoteSupportPlan} />
          </div>
          <div class="offer-featured-side">
            <p class="price">Starting at {usd(remoteSupportPlan.from)}/mo<small>Founding rate · standard rate from {usd(remoteSupportPlan.standard!)}/mo</small></p>
            <div class="btn-row">
              <a class="btn btn-ghost" href={url('/contact/?topic=support-plan')} data-umami-event="contact-click" data-umami-event-offer={remoteSupportPlan.name}>Get in touch</a>
            </div>
          </div>
        </div>
      </article>

      <article class="card offer topline accent-cyan local-card" id="local" style="margin-top:1.25rem">
        <div class="offer-featured-grid">
          <div>
            <span class="kicker">On-site · Fairbanks and North Pole, Alaska</span>
            <h3 style="font-size:1.3rem;margin-top:.4rem">Office Tech Tune-Up</h3>
            <p class="offer-outcome">Your office tech, checked and fixed in one visit.</p>
            <p class="muted">For small offices, shops and studios in Alaska's Interior. Wi-Fi and router, backups, 2-step sign-in, email security, printers and slow computers, plus a one-page report. Evening and Saturday times.</p>
          </div>
          <div class="offer-featured-side">
            <p class="price">$249<small>One visit, up to about 10 devices</small></p>
            <div class="btn-row">
              <a class="btn btn-primary" href={url('/local/')} data-umami-event="services-cta" data-umami-event-offer="Office Tech Tune-Up" data-umami-event-location="services-local">See the tune-up</a>
            </div>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section style="padding-top:0" aria-labelledby="auto-h">
    <div class="container">
      <SectionHeading id="auto-h" eyebrow="AI and automation" title="Automation services" count={`${automationOffers.length} services`} intro="Start small with a Quick Win + Tech Checkup, or take repetitive work off your plate with a bigger build." />
      <div class="grid grid-3">
        {automationOffers.map((o, i) => (
          <article class={`card offer topline ${accents[i % accents.length]}`} id={o.slug}>
            <span class="kicker">{o.kicker ?? 'Automation'}</span>
            <h3 style="font-size:1.3rem;margin-top:.4rem">{o.headline ?? o.name}</h3>
            {o.headline && <p class="offer-name">{o.name}</p>}
            {o.outcome && <p class="offer-outcome">{o.outcome}.</p>}
            <p class="price">Starting at {usd(o.from)}<small>{o.standard ? `Founding rate · standard rate from ${usd(o.standard)}` : 'Scoped per project'}</small></p>
            <p class="muted">{o.for}.</p>
            <ul>{o.items.map((i) => <li>{i}</li>)}</ul>
            <OfferDetails offer={o} />
            {o.demo && (
              <p class="offer-demo"><a href={url(o.demo.href)} data-umami-event="demo-click" data-umami-event-offer={o.name} data-umami-event-location="services">{o.demo.label} →</a>{o.demo.example && <span class="muted"> Example: {o.demo.example}</span>}</p>
            )}
            {o.upsell && (
              <p class="offer-upsell">{o.upsell.text} <a href={url(o.upsell.href)} data-umami-event="services-cta" data-umami-event-offer={o.name} data-umami-event-location="services-upsell">{o.upsell.linkText}</a></p>
            )}
            <a class="btn btn-primary" href={url(`/contact/?topic=${o.slug}`)} data-umami-event="services-cta" data-umami-event-offer={o.name}>Get in touch</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section style="padding-top:0" aria-label="More">
    <div class="container">
      <div class="callout" style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;margin-top:1.75rem">
        <span>Curious how these get built? The Lab documents hands-on builds, with the results and lessons, including what I'd do differently.</span>
        <a class="btn btn-ghost btn-sm" href={url('/lab/')} data-umami-event="lab-cta" data-umami-event-location="services">See the builds</a>
      </div>
      <div class="callout" style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;margin-top:1rem">
        <span><strong>Free:</strong> the NeonKey Starter IT Kit. A simple spreadsheet to list your accounts, spot the risky ones and run a 10-minute monthly checkup.</span>
        <a class="btn btn-ghost btn-sm" href={url('/free-it-kit/')} data-umami-event="free-kit-cta" data-umami-event-location="services">Get the free kit</a>
      </div>
      <p class="muted" style="margin-top:1.25rem;font-size:.95rem">Pricing shown is a starting point, not a quote. Outcomes depend on your business, your tools and your data; no specific results are promised.</p>
    </div>
  </section>
  <section class="alt" aria-labelledby="menu-h" id="automation-menu">
    <div class="container">
      <SectionHeading id="menu-h" eyebrow="Ideas" title="What can we automate?" intro="Everyday jobs small businesses hand off to an automation, grouped by the work they save. Pick the one that eats the most of your week and we'll scope it with you. If a simple app already does it, we'll tell you." />
      <div class="grid grid-3 menu-grid">
        {automationMenu.map((g, i) => (
          <article class={`card topline ${accents[i % accents.length]}`} id={`menu-${g.id}`}>
            <h3 style="font-size:1.12rem;margin:0 0 .6rem">{g.title}</h3>
            <ul class="menu-list">{g.items.map((it) => <li>{it}</li>)}</ul>
          </article>
        ))}
      </div>
      <div class="callout menu-own">
        <span><strong>This is just a starting list.</strong> If a task is repetitive, follows the same steps or lives in a spreadsheet, there's a good chance we can take it off your plate. Got an idea of your own? Bring it, even if it's half-formed. We're open to it.</span>
        <a class="btn btn-ghost btn-sm" href={url('/contact/?topic=quick-win')} data-umami-event="services-cta" data-umami-event-location="automation-menu-own-idea">Pitch us your idea</a>
      </div>
      <div class="btn-row" style="margin-top:1.5rem">
        <a class="btn btn-primary" href={url('/contact/?topic=quick-win')} data-umami-event="services-cta" data-umami-event-location="automation-menu">Tell us which one</a>
        <a class="btn btn-ghost" href={url('/lab/')} data-umami-event="lab-cta" data-umami-event-location="automation-menu">See real builds in the Lab</a>
      </div>
      <p class="muted" style="margin-top:1rem;font-size:.95rem">Examples, not a promise of results. What fits depends on your tools and how you work today.</p>
    </div>
  </section>

  <section aria-labelledby="how-h">
    <div class="container">
      <SectionHeading id="how-h" eyebrow="Process" title="How it works" />
      <ol class="step-cards">
        <li><strong>Scope:</strong> a short call to pick one problem worth solving.</li>
        <li><strong>Build:</strong> I set it up with the tools you already use where possible, after 4 PM Alaska time or on weekends so nobody loses a working hour.</li>
        <li><strong>Hand off:</strong> you get notes, a walkthrough and full ownership of every account.</li>
      </ol>
    </div>
  </section>

  <section class="alt" aria-labelledby="faq-h">
    <div class="container faq">
      <SectionHeading id="faq-h" eyebrow="Questions" title="FAQ" />
      <details class="offer-details faq-item">
        <summary>Why not just buy software?</summary>
        <div class="offer-details-body">
          <p>Sometimes you should. If an off-the-shelf app already does exactly what you need, use it, and I'm happy to help you set it up. A custom build makes sense when an app would make you change how you work. It fits the process you already have: your categories, your spreadsheet, your steps. It can also connect or replace subscriptions that overlap, and it plugs into the tools you already use. And you own it outright, so there are no surprise price hikes or features that disappear in an update. You control where your data goes. If you'd like, I can maintain it for you, or you can run it yourself.</p>
        </div>
      </details>
      <details class="offer-details faq-item">
        <summary>How do you handle my accounts and data?</summary>
        <div class="offer-details-body">
          <p>Your accounts stay yours. You keep every admin login, and where a tool allows it I work from a separate admin account or delegated access that you can switch off, rather than your own password. I only open the settings and files the job needs. At handoff we review who has access, and you can remove mine (I'll show you how). If you're on a support plan, my access stays only for the systems the plan covers. I don't keep copies of your files or passwords after the work is done. Questions about this are welcome on the scoping call.</p>
        </div>
      </details>
    </div>
  </section>
</Base>

<style>
  .pick-card { display: flex; flex-direction: column; gap: .4rem; text-decoration: none; color: inherit; }
  .pick-card strong { font-size: 1.1rem; color: var(--text); }
  .pick-card .muted { font-size: .95rem; }
  .pick-card:hover strong { text-decoration: underline; }
  .local-card .offer-featured-grid { align-items: start; }
  .offer[id] { scroll-margin-top: 90px; }
  .support-card .offer-featured-grid { align-items: start; }
  .fop-parts { list-style: none; padding: 0; margin: 0 0 .9rem; display: grid; gap: .45rem; font-size: .95rem; }
  .fop-parts li { display: flex; flex-direction: column; border-left: 3px solid var(--line); padding-left: .6rem; }
  .fop-parts .muted { font-size: .85rem; }
  .fop-value { margin: 0 0 -.4rem; color: var(--muted); font-weight: 600; }
  .support-card .btn { margin-top: 0; }
  .faq .faq-item { max-width: 860px; }
  .step-cards > li strong:first-child { display: inline; font-size: inherit; }
  .faq-item { border-bottom: 1px solid var(--line); padding-bottom: .7rem; }
  .faq-item > summary { color: var(--text); font-size: 1.05rem; }
  .faq-item .offer-details-body { font-size: 1rem; margin-top: .6rem; }
  .menu-list { margin: 0 0 .9rem; padding-left: 1.1rem; }
  .menu-list li { margin-bottom: .45rem; }
  .menu-own { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; margin-top: 1.5rem; }
  .menu-grid .card { display: flex; flex-direction: column; }
  .card[id^="menu-"] { scroll-margin-top: 90px; }
</style>
