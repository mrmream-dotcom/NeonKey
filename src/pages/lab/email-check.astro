---
import { url } from '../../config';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { labProjects } from '../../data/lab';
import { emailLockdown, usd } from '../../data/services';
const project = labProjects.find((p) => p.slug === 'email-check')!;
// Free email security check: runs in the browser against public DNS (Cloudflare DoH). Nothing is stored.
// Grade-based pitch: lower grades get a stronger push toward the $49 Email Lockdown, higher grades a lighter one.
---
<Base title={project.title} description="Free email security check: enter your business domain and get a letter grade across nine ratings (SPF, DKIM, DMARC, encryption and more) in seconds. Public records only, no sign-up.">
  <PageHeader eyebrow="Lab · Security · Free tool" crumbs={[{ href: '/', label: 'Home' }, { href: '/lab/', label: 'Lab' }, { label: 'Email security check' }]}>
    <Fragment slot="title">How easy is it to <span class="glow-c">fake your email?</span></Fragment>
    <p class="lede">Enter your business domain. In a few seconds you get a grade across nine ratings that decide whether scammers can send mail as you, and whether your real mail lands in inboxes. Public records only: no sign-up, no logins, nothing stored.</p>
  </PageHeader>

  <section style="padding-top:0" aria-labelledby="ec-h">
    <div class="container ec-wrap">
      <h2 id="ec-h" class="sr-only">Check a domain</h2>
      <form class="panel ec-form" id="ec-form" novalidate>
        <label for="ec-domain">Your business email domain</label>
        <div class="ec-row">
          <input id="ec-domain" name="domain" inputmode="url" autocomplete="url" maxlength="120" placeholder="yourbusiness.com" required />
          <button class="btn btn-primary" type="submit" id="ec-go" data-umami-event="email-check-run">Check my domain</button>
        </div>
        <p class="muted ec-note">The part after the @ in your work email. Lookups go from your browser to Cloudflare's public DNS, not to us.</p>
        <p class="ec-err" id="ec-err" role="alert" hidden></p>
      </form>

      <div id="ec-out" class="ec-out" hidden aria-live="polite">
        <div class="panel ec-hero">
          <div class="ec-grade" id="ec-grade"><span id="ec-letter">-</span><small id="ec-score">0/100</small></div>
          <div>
            <p class="ec-dom" id="ec-dom"></p>
            <p class="ec-sum" id="ec-sum"></p>
            <div class="ec-bar" aria-hidden="true"><span id="ec-bar"></span></div>
          </div>
        </div>

        <div class="ec-tiles" id="ec-tiles"></div>

        <div class="panel ec-pitch" id="ec-pitch">
          <p class="ec-pt" id="ec-pt"></p>
          <p class="ec-pb" id="ec-pb"></p>
          <div class="ec-actions">
            <a class="btn btn-primary" id="ec-cta" href={emailLockdown.buyUrl} rel="noopener" data-umami-event="buy-click" data-umami-event-offer={emailLockdown.name} data-umami-event-location="email-check">Fix it for {usd(emailLockdown.from)}</a>
            <a class="btn" href={url('/services/email-lockdown/')}>What's included</a>
          </div>
          <p class="muted ec-alt" id="ec-alt"></p>
          <p class="muted ec-fine">The {emailLockdown.name} reads your public records again, emails you the exact records for your email provider and domain host (usually within a few minutes), and rechecks until everything passes. No passwords needed.</p>
        </div>
      </div>

      <details class="panel ec-how">
        <summary>How the grade works</summary>
        <p>Nine ratings add up to 100 points: mail server (10), approved senders/SPF (15), SPF health (10), digital signature/DKIM (15), spoofing policy/DMARC (15), blocking fakes (15), spoofing reports (5), encrypted delivery (5) and tamper-proof DNS/DNSSEC (10). A is 90 or more, B 75, C 60, D 40, below that F.</p>
        <p>We check DKIM at the names most providers use. If yours uses a custom name, the DKIM rating may read low even when it's on. This page reads public DNS only and changes nothing.</p>
      </details>
    </div>
  </section>
</Base>

<style>
  .ec-wrap { display: grid; gap: 1rem; max-width: 860px; }
  .ec-form label { font-weight: 700; display: block; margin-bottom: .4rem; }
  .ec-row { display: flex; gap: .6rem; flex-wrap: wrap; }
  .ec-row input { flex: 1 1 240px; min-width: 0; font-size: 1.05rem; }
  .ec-note { font-size: .88rem; margin: .5rem 0 0; }
  .ec-err { color: var(--magenta); margin: .5rem 0 0; font-weight: 600; }
  .ec-out { display: grid; gap: 1rem; }
  .ec-hero { display: grid; grid-template-columns: auto 1fr; gap: 1.25rem; align-items: center; }
  .ec-grade { width: 104px; height: 104px; border-radius: 50%; display: grid; place-items: center; align-content: center; border: 6px solid var(--g, var(--cyan)); box-shadow: 0 0 24px color-mix(in srgb, var(--g, var(--cyan)) 35%, transparent); }
  .ec-grade span { font-size: 2.6rem; font-weight: 800; line-height: 1; color: var(--g, var(--cyan)); }
  .ec-grade small { font-size: .78rem; color: var(--muted); }
  .ec-dom { font-family: var(--mono); font-weight: 700; margin: 0; font-size: 1.15rem; word-break: break-all; }
  .ec-sum { margin: .2rem 0 .6rem; color: var(--muted); }
  .ec-bar { height: 8px; border-radius: 999px; background: rgba(255,255,255,.08); overflow: hidden; }
  .ec-bar span { display: block; height: 100%; width: 0; background: linear-gradient(90deg, var(--magenta), #fbbf24, #34d399); transition: width .6s ease; }
  .ec-tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .75rem; }
  @media (max-width: 760px) { .ec-tiles { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 480px) { .ec-tiles { grid-template-columns: 1fr; } .ec-hero { grid-template-columns: 1fr; justify-items: start; } }
  .ec-tiles :global(.ec-tile) { border: 1px solid var(--line); border-radius: 12px; padding: .7rem .8rem; background: rgba(255,255,255,.02); }
  .ec-tiles :global(.t1) { display: flex; justify-content: space-between; align-items: center; gap: .5rem; }
  .ec-tiles :global(.nm) { font-weight: 700; font-size: .95rem; }
  .ec-tiles :global(.pts) { font-family: var(--mono); font-size: .78rem; color: var(--muted); }
  .ec-tiles :global(.wh) { color: var(--muted); font-size: .82rem; margin: .2rem 0 .35rem; }
  .ec-tiles :global(.dt) { font-family: var(--mono); font-size: .76rem; word-break: break-all; color: var(--text); opacity: .85; }
  .ec-tiles :global(.pill) { font-size: .72rem; font-weight: 700; padding: .1rem .5rem; border-radius: 999px; border: 1px solid currentColor; white-space: nowrap; }
  .ec-tiles :global(.pill.pass) { color: #34d399; } .ec-tiles :global(.pill.partial) { color: #fbbf24; } .ec-tiles :global(.pill.fail) { color: var(--magenta); }
  .ec-pitch { border-left: 4px solid var(--p, var(--cyan)); }
  .ec-pitch.urgent { --p: var(--magenta); background: color-mix(in srgb, var(--magenta) 8%, transparent); }
  .ec-pitch.firm { --p: #fbbf24; }
  .ec-pitch.light { --p: var(--cyan); }
  .ec-pitch.soft { --p: #34d399; }
  .ec-pt { font-size: 1.25rem; font-weight: 800; margin: 0 0 .35rem; }
  .ec-pb { margin: 0 0 .9rem; }
  .ec-actions { display: flex; gap: .6rem; flex-wrap: wrap; }
  .ec-alt { margin: .8rem 0 0; font-size: .92rem; }
  .ec-fine { margin: .4rem 0 0; font-size: .82rem; }
  .ec-how summary { cursor: pointer; font-weight: 700; }
  .ec-how p { color: var(--muted); font-size: .92rem; }
</style>

<script>
  import { cleanDomain, gradeDomain, pitchFor } from '../../lib/email-grade.js';
  const $ = (id: string) => document.getElementById(id)!;
  const form = $('ec-form') as HTMLFormElement;
  const input = $('ec-domain') as HTMLInputElement;
  const go = $('ec-go') as HTMLButtonElement;
  const err = $('ec-err');
  const colors: Record<string, string> = { A: '#34d399', B: '#22d3ee', C: '#fbbf24', D: '#f472b6', F: '#f472b6' };
  const SUPPORT = '/services/remote-it/#support-plan';
  const PACKAGE = '/services/#front-office-package';
  const BUY = ($('ec-cta') as HTMLAnchorElement).href;
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  const params = new URLSearchParams(location.search);
  if (params.get('domain')) { input.value = params.get('domain')!; queueMicrotask(() => form.requestSubmit()); }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    err.hidden = true;
    const d = cleanDomain(input.value);
    if (!d) { err.textContent = "That doesn't look like a domain. Try something like yourbusiness.com."; err.hidden = false; return; }
    go.disabled = true; go.textContent = 'Checking…';
    try {
      const r: any = await gradeDomain(d);
      if (!r.exists) { err.textContent = `We couldn't find ${d}. Check the spelling?`; err.hidden = false; return; }
      if (r.freeMail) { err.textContent = `${d} is a personal email service, so its records belong to that company. Enter the domain of your business email instead.`; err.hidden = false; return; }
      render(r);
      history.replaceState(null, '', `?domain=${encodeURIComponent(d)}`);
      (window as any).umami?.track?.('email-check-grade', { grade: r.grade });
    } catch {
      err.textContent = 'The lookup didn\'t finish. Check your connection and try again.'; err.hidden = false;
    } finally {
      go.disabled = false; go.textContent = 'Check my domain';
    }
  });

  function render(r: any) {
    const c = colors[r.grade];
    $('ec-grade').style.setProperty('--g', c);
    $('ec-letter').textContent = r.grade;
    $('ec-score').textContent = `${r.score}/100`;
    $('ec-dom').textContent = r.domain;
    const passing = r.ratings.filter((x: any) => x.status === 'pass').length;
    $('ec-sum').textContent = `${passing} of ${r.ratings.length} ratings passing${r.provider ? ` · Email by ${r.provider}` : ''}`;
    ($('ec-bar') as HTMLElement).style.width = '0';
    requestAnimationFrame(() => { ($('ec-bar') as HTMLElement).style.width = `${r.score}%`; });
    const label: Record<string, string> = { pass: 'Passing', partial: 'Partial', fail: 'Missing' };
    const order: Record<string, number> = { fail: 0, partial: 1, pass: 2 };
    $('ec-tiles').innerHTML = [...r.ratings].sort((a: any, b: any) => order[a.status] - order[b.status]).map((x: any) =>
      `<div class="ec-tile"><div class="t1"><span class="nm">${esc(x.name)}</span><span class="pill ${x.status}">${label[x.status]}</span></div>` +
      `<div class="wh">${esc(x.what)}</div><div class="dt">${esc(x.detail)}</div><div class="pts">${x.points}/${x.max} pts</div></div>`).join('');
    const p = pitchFor(r);
    const box = $('ec-pitch');
    box.className = `panel ec-pitch ${p.tone}`;
    $('ec-pt').textContent = p.title;
    $('ec-pb').textContent = p.body;
    const cta = $('ec-cta') as HTMLAnchorElement;
    cta.textContent = p.cta;
    cta.href = r.grade === 'A' ? SUPPORT : BUY;
    cta.dataset.umamiEventLocation = `email-check-${r.grade}`;
    const alt = $('ec-alt');
    alt.innerHTML = r.grade === 'F' ? `${esc(p.alt.replace(' See the Front Office Package.', ''))} <a href="${PACKAGE}">See the Front Office Package</a>.`
      : r.grade === 'B' ? `Already handled? <a href="${SUPPORT}">The Monthly Remote Support Plan</a> keeps it that way.`
      : r.grade === 'A' ? `Know someone whose domain needs this? <a href="${BUY}">The Email Lockdown is $49</a>.`
      : esc(p.alt);
    $('ec-out').hidden = false;
    $('ec-out').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
</script>
