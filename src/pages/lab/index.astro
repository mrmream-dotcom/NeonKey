---
import { url } from '../../config';
import Base from '../../layouts/Base.astro';
import EmptyState from '../../components/EmptyState.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import LabCard from '../../components/LabCard.astro';
import { publishedLabProjects as projects, labTags } from '../../data/lab';
// Only published projects are listed. Drafts (draft: true in src/data/lab.ts, pages in src/_drafts/lab/) stay hidden.
---
<Base title="Lab" description="The NeonKey Lab: real builds, documented. What I built, why, what broke and what I learned.">
  <PageHeader eyebrow="The Lab · Hands-on builds" crumbs={[{ href: '/', label: 'Home' }, { label: 'Lab' }]}>
    <Fragment slot="title">Real builds, <span class="glow-c">documented.</span></Fragment>
    <p class="lede">What I built, why, what broke, and what I learned. The Lab is my project portfolio: homelab, automation, networking, security and AI builds written up as honest case studies, mistakes included.</p>
    {projects.length > 0 && (
      <Fragment slot="meta">
        <li><span><strong>{projects.length}</strong> published {projects.length === 1 ? 'build' : 'builds'}</span></li>
        <li><span>Working demos you can try</span></li>
        <li><span>Limitations written up</span></li>
      </Fragment>
    )}
  </PageHeader>

  <section class="ed-section" aria-labelledby="lab-grid-h">
    <div class="container">
      <SectionHeading id="lab-grid-h" eyebrow="Portfolio" title="Projects" count={`${projects.length} ${projects.length === 1 ? 'build' : 'builds'}`} intro="Filter by topic. Every card opens the full write-up." />
      {projects.length === 0 ? (
        <EmptyState what="Lab builds" location="lab-empty" />
      ) : (<>
      <div class="lab-filters" role="group" aria-label="Filter projects by tag">
        <button type="button" class="filter-chip" data-filter="all" aria-pressed="true" data-umami-event="lab-filter" data-umami-event-tag="All">All</button>
        {labTags.map((t) => (
          <button type="button" class="filter-chip" data-filter={t} aria-pressed="false" data-umami-event="lab-filter" data-umami-event-tag={t}>{t}</button>
        ))}
      </div>
      <div class="article-grid lab-grid">
        {projects.map((p) => <LabCard project={p} filterable />)}
      </div>
      <p class="filter-empty muted" hidden>No builds with that tag yet.</p>
      </>)}
    </div>
  </section>

  <section class="alt" aria-labelledby="lab-how-h">
    <div class="container">
      <SectionHeading id="lab-how-h" eyebrow="Format" title="How every build is written up" />
      <ol class="step-cards lab-format">
        <li><strong>Overview</strong></li><li><strong>Goal</strong></li><li><strong>Stack &amp; tools</strong></li><li><strong>Build steps</strong></li><li><strong>What broke &amp; the fix</strong></li><li><strong>What I learned</strong></li><li><strong>Related service</strong></li>
      </ol>
    </div>
  </section>

  <section aria-labelledby="lab-cta-h">
    <div class="container">
      <div class="nl-box lab-cta topline">
        <div>
          <span class="kicker">Unlock AI</span>
          <h2 id="lab-cta-h">Want something like this for your business?</h2>
          <p class="muted" style="margin:0">The same kind of builds, scoped for your tools: intake forms, FAQ assistants, lead routing. Clear handoff notes included.</p>
        </div>
        <a class="btn btn-primary" href={url('/services/')} data-umami-event="services-cta" data-umami-event-location="lab">See services</a>
      </div>
    </div>
  </section>
</Base>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
  const cards = document.querySelectorAll<HTMLElement>('.lab-card');
  const empty = document.querySelector<HTMLElement>('.filter-empty');
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const f = chip.dataset.filter || 'all';
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      let shown = 0;
      cards.forEach((card) => {
        const tags = (card.dataset.tags || '').split(',');
        const show = f === 'all' || tags.includes(f);
        card.hidden = !show;
        if (show && !tags.includes('all')) shown++;
      });
      if (empty) empty.hidden = shown > 0;
    });
  });
</script>
