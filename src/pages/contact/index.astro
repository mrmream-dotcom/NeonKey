---
import { url, CONTACT_EMAIL , INSTAGRAM_URL, INSTAGRAM_HANDLE } from '../../config';
import SocialLinks from '../../components/SocialLinks.astro';
import Base from '../../layouts/Base.astro';
import Bridge from '../../components/Bridge.astro';

import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
---
<Base title="Contact" description="Contact NeonKey about remote small-office IT setup, automation services, a tutorial, a review or the Unlock the Week newsletter.">
  <PageHeader eyebrow="Contact" title="Contact" crumbs={[{ href: '/', label: 'Home' }, { label: 'Contact' }]}>
    <p class="lede">Questions about services, a tutorial or a review? Email <a href={`mailto:${CONTACT_EMAIL}`} data-umami-event="contact-click" data-umami-event-location="contact-email">{CONTACT_EMAIL}</a>.</p>
    <Fragment slot="meta">
      <li><span>Replies by email</span></li>
      <li><span>Services · Tutorials · Reviews · Newsletter</span></li>
    </Fragment>
  </PageHeader>
  <div class="container split contact-split">
    <div class="contact-form-col">
      <p class="section-label"><span class="pulse" aria-hidden="true"></span>Send a message</p>
    <form class="panel" action="https://api.web3forms.com/submit" method="post">
      <input type="hidden" name="access_key" value="52c99f86-4c5d-4a75-b20d-63c66d18dcaf" />
      <input type="hidden" name="subject" value="New NeonKey contact form message" />
      <input type="hidden" name="from_name" value="NeonKey website" />
      <input type="hidden" name="redirect" value="https://neonkey.tech/contact/thanks/" />
      <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />
      <div class="field"><label for="c-name">Name</label><input id="c-name" name="name" autocomplete="name" required /></div>
      <div class="field"><label for="c-email">Email</label><input id="c-email" name="email" type="email" autocomplete="email" required /></div>
      <div class="field"><label for="c-topic">Topic</label>
        <select id="c-topic" name="topic"><option>Remote small-office IT setup</option><option>Email Lockdown ($49)</option><option>Monthly remote support plan</option><option>Automation services</option><option>Front Office Package (all-inclusive)</option><option>Tutorials or reviews</option><option>Newsletter</option><option>I was referred by a client</option><option>Something else</option></select>
      </div>
      <div class="field"><label for="c-ref">Referred by <span class="muted">(optional)</span></label><input id="c-ref" name="referred_by" maxlength="80" placeholder="Name or code, like NK-SMITH" /></div>
      <div class="field"><label for="c-msg">Message</label><textarea id="c-msg" name="message" rows="5" required></textarea></div>
      <button class="btn btn-primary" type="submit" data-umami-event="contact-submit">Send message</button>
      <p class="form-note">Your message goes straight to {CONTACT_EMAIL}. See the <a href={url('/privacy/')}>privacy page</a> for how form messages are handled.</p>
    </form>
    </div>
    <aside class="sticky-side" aria-label="Before you write">
      <div class="panel topline">
        <div class="panel-head"><span class="icon-chip"><Icon name="wrench" /></span><h2 class="panel-title">IT help</h2></div>
    <p class="muted" style="margin:0">Looking for IT help? See <a href={url('/services/remote-it/')}>Remote Small-Office IT Setup</a> for what's in and out of scope.</p>
      </div>
      <div class="panel topline accent-violet">
        <div class="panel-head"><span class="icon-chip"><Icon name="chat" /></span><h2 class="panel-title">What happens next</h2></div>
        <p class="muted" style="margin:0">Michael Ream reads every message and will reply by email. We aim to reply within 1 business day. Remote, anywhere in the US.</p>
      </div>
      <div class="panel topline accent-magenta">
        <div class="panel-head"><span class="icon-chip"><Icon name="chat" /></span><h2 class="panel-title">Follow along</h2></div>
        <p class="muted" style="margin:0 0 .5rem">Quick tech tips, Lab builds and The Fix videos on Instagram (<a href={INSTAGRAM_URL} rel="me noopener" target="_blank" data-umami-event="outbound-click" data-umami-event-item="instagram" data-umami-event-location="contact">{INSTAGRAM_HANDLE}</a>), YouTube and Facebook. You can message us on Instagram too.</p>
        <SocialLinks location="contact" />
      </div>
    </aside>
  </div>
  <Bridge location="contact" text="Not sure what to ask for yet? The services page lists every option with starting prices, and the quiz narrows it down in two minutes." links={[{ href: '/services/', label: 'Services and prices', event: 'services-cta' }, { href: '/services/quiz/', label: 'Take the 2-minute quiz', event: 'quiz-cta' }]} />
</Base>

<script>
  // Preselect the topic from ?topic= (links on Services and the quiz). Whitelisted values only;
  // when coming from the quiz, also suggest a starter message if the box is still empty.
  const TOPICS: Record<string, [string, string]> = {
    'front-office-package': ['Front Office Package (all-inclusive)', 'the Front Office Package'],
    // tune-up: only reached from /local/ (Fairbanks ad landing page); the option is added on the fly so the
    // remote-only site never lists it.
    'tune-up': ['Office Tech Tune-Up (Fairbanks / North Pole)', 'an on-site Office Tech Tune-Up'],
    'email-lockdown': ['Email Lockdown ($49)', 'the $49 Email Lockdown'],
    'remote-it': ['Remote small-office IT setup', 'the Remote Small-Office IT Setup'],
    'support-plan': ['Monthly remote support plan', 'the Monthly Remote Support Plan'],
    'quick-win': ['Automation services', 'a Quick Win + Tech Checkup'],
    'ai-faq': ['Automation services', 'an AI Intake & FAQ Assistant'],
    'lead-routing': ['Automation services', 'a Lead-Routing & Follow-Up System'],
    'referral': ['I was referred by a client', ''],
  };
  const qp = new URLSearchParams(location.search);
  const t = TOPICS[qp.get('topic') || ''];
  const sel = document.getElementById('c-topic') as HTMLSelectElement | null;
  const msg = document.getElementById('c-msg') as HTMLTextAreaElement | null;
  if (t && sel && !Array.from(sel.options).some((o) => o.text === t[0])) sel.add(new Option(t[0]), 1);
  if (t && sel) {
    const opt = Array.from(sel.options).find((o) => o.text === t[0]);
    if (opt) sel.value = opt.value;
  }
  // Referral links (/refer/?code=NK-SMITH or /contact/?ref=NK-SMITH) prefill "Referred by".
  const ref = (qp.get('ref') || qp.get('code') || '').replace(/[^A-Za-z0-9 .'-]/g, '').slice(0, 80);
  const refInput = document.getElementById('c-ref') as HTMLInputElement | null;
  if (ref && refInput && !refInput.value) {
    refInput.value = ref;
    if (!t && sel) {
      const opt = Array.from(sel.options).find((o) => o.text === 'I was referred by a client');
      if (opt) sel.value = opt.value;
    }
  }
  if (qp.get('from') === 'quiz' && msg && !msg.value) {
    msg.value = t
      ? `Hi Michael, I took the service quiz on neonkey.tech and it suggested ${t[1]}. I'd like to ask about it.\n\n`
      : "Hi Michael, I took the service quiz on neonkey.tech and I'd like to talk it through.\n\n";
  }
</script>
