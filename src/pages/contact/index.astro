---
import { url, CONTACT_EMAIL } from '../../config';
import Base from '../../layouts/Base.astro';
---
<Base title="Contact" description="Contact NeonKey about remote small-office IT setup, automation services, a tutorial, a review or the Unlock the Week newsletter.">
  <div class="narrow page-head">
    <span class="kicker">Contact</span>
    <h1>Contact</h1>
    <p>Questions about services, a tutorial or a review? Email <a href={`mailto:${CONTACT_EMAIL}`} data-umami-event="contact-click" data-umami-event-location="contact-email">{CONTACT_EMAIL}</a>.</p>
    <p class="muted" style="font-size:.95rem">Looking for IT help? See <a href={url('/services/remote-it/')}>Remote Small-Office IT Setup</a> for what's in and out of scope.</p>
    <form class="panel" action="https://api.web3forms.com/submit" method="post">
      <input type="hidden" name="access_key" value="52c99f86-4c5d-4a75-b20d-63c66d18dcaf" />
      <input type="hidden" name="subject" value="New NeonKey contact form message" />
      <input type="hidden" name="from_name" value="NeonKey website" />
      <input type="hidden" name="redirect" value="https://neonkey.tech/contact/thanks/" />
      <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />
      <div class="field"><label for="c-name">Name</label><input id="c-name" name="name" autocomplete="name" required /></div>
      <div class="field"><label for="c-email">Email</label><input id="c-email" name="email" type="email" autocomplete="email" required /></div>
      <div class="field"><label for="c-topic">Topic</label>
        <select id="c-topic" name="topic"><option>Remote small-office IT setup</option><option>Monthly remote support plan</option><option>Automation services</option><option>Tutorials or reviews</option><option>Newsletter</option><option>Something else</option></select>
      </div>
      <div class="field"><label for="c-msg">Message</label><textarea id="c-msg" name="message" rows="5" required></textarea></div>
      <button class="btn btn-primary" type="submit" data-umami-event="contact-submit">Send message</button>
      <p class="form-note">Your message goes straight to {CONTACT_EMAIL}. See the <a href={url('/privacy/')}>privacy page</a> for how form messages are handled.</p>
    </form>
  </div>
</Base>

<script>
  // Preselect the topic from ?topic= (links on Services and the quiz). Whitelisted values only;
  // when coming from the quiz, also suggest a starter message if the box is still empty.
  const TOPICS: Record<string, [string, string]> = {
    'remote-it': ['Remote small-office IT setup', 'the Remote Small-Office IT Setup'],
    'support-plan': ['Monthly remote support plan', 'the Monthly Remote Support Plan'],
    'quick-win': ['Automation services', 'a One-Workflow Quick Win'],
    'ai-faq': ['Automation services', 'an AI Intake & FAQ Assistant'],
    'lead-routing': ['Automation services', 'a Lead-Routing & Follow-Up System'],
  };
  const qp = new URLSearchParams(location.search);
  const t = TOPICS[qp.get('topic') || ''];
  const sel = document.getElementById('c-topic') as HTMLSelectElement | null;
  const msg = document.getElementById('c-msg') as HTMLTextAreaElement | null;
  if (t && sel) {
    const opt = Array.from(sel.options).find((o) => o.text === t[0]);
    if (opt) sel.value = opt.value;
  }
  if (qp.get('from') === 'quiz' && msg && !msg.value) {
    msg.value = t
      ? `Hi Michael, I took the service quiz on neonkey.tech and it suggested ${t[1]}. I'd like to ask about it.\n\n`
      : "Hi Michael, I took the service quiz on neonkey.tech and I'd like to talk it through.\n\n";
  }
</script>
