---
import { url, CONTACT_EMAIL } from '../../config';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
---
<Base title="Message sent" description="Thanks for contacting NeonKey." noindex>
  <PageHeader width="narrow" align="center" eyebrow="Contact · Message sent" crumbs={[{ href: '/', label: 'Home' }, { href: '/contact/', label: 'Contact' }, { label: 'Thanks' }]} class="status-head">
    <span class="status-mark" slot="title-before"><Icon name="check" /></span>
    <Fragment slot="title">Thanks, your message is on its way.</Fragment>
    <p class="lede">Michael Ream reads every message and will reply by email. If you need to add anything, email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.</p>
  </PageHeader>
  <div class="narrow status-body">
    <p class="status-actions"><a class="btn btn-primary" href={url('/')}>Back to NeonKey</a> <a class="btn" href={url('/services/')}>See services</a></p>
  </div>
</Base>
