---
import Base from '../layouts/Base.astro';
const offers = [
  { name: 'One-Workflow Quick Win', from: 75, range: '$75–$150', for: 'Automate one repetitive task', items: ['One workflow, scoped together first', 'Connects tools you already use', 'Short walkthrough video and notes', 'Handoff so you own it'] },
  { name: 'AI Intake & FAQ Assistant', from: 250, range: '$250–$500', for: 'Answer common questions and capture inquiries', items: ['Trained on your own FAQ content', 'Captures name, contact and request details', 'Clear handoff to a human', 'Review and tuning session'] },
  { name: 'Lead-Routing & Follow-Up System', from: 400, range: '$400–$900', for: 'Send new leads to the right place and follow up on time', items: ['Form, email or chat intake', 'Routing rules to the right person or sheet', 'Follow-up reminders and templates', 'Simple tracking view'] },
];
---
<Base title="Services" description="Unlock AI: small, practical automation services for small businesses.">
  <div class="container page-head">
    <span class="kicker">Unlock AI</span>
    <h1>Automation services for small businesses</h1>
    <p>Practical AI and automation, explained in plain English. Every project starts with a short scoping call so we agree on what "done" looks like before any work begins.</p>
  </div>
  <section style="padding-top:1rem">
    <div class="container">
      <div class="grid grid-3">
        {offers.map((o) => (
          <article class="card offer">
            <span class="kicker">Module 1</span>
            <h2 style="font-size:1.3rem;margin-top:.4rem">{o.name}</h2>
            <p class="price">Starting at ${o.from}<small>Typical range {o.range}, scoped per project</small></p>
            <p class="muted">{o.for}.</p>
            <ul>{o.items.map((i) => <li>{i}</li>)}</ul>
            <a class="btn btn-primary" href="/contact/">Ask about this</a>
          </article>
        ))}
      </div>
      <p class="muted" style="margin-top:1.25rem;font-size:.95rem">Pricing shown is a starting point, not a quote. Outcomes depend on your business, your tools and your data; no specific results are promised.</p>
    </div>
  </section>
  <section class="alt">
    <div class="container">
      <h2>How it works</h2>
      <ol class="steps">
        <li><strong>Scope:</strong> a short call to pick one problem worth solving.</li>
        <li><strong>Build:</strong> I set it up with the tools you already use where possible.</li>
        <li><strong>Hand off:</strong> you get notes, a walkthrough and full ownership.</li>
      </ol>
    </div>
  </section>
  <section>
    <div class="container">
      <div class="section-head"><h2>Coming later</h2><p>Not offered yet. Planned as skills and certifications progress.</p></div>
      <div class="coming">
        <span class="chip">Security hygiene check-ups</span>
        <span class="chip">Managed IT for small offices</span>
        <span class="chip">Cloud setup &amp; cleanup</span>
      </div>
    </div>
  </section>
</Base>
