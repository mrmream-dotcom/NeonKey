---
import { url, CONTACT_EMAIL } from '../../../config';
import Base from '../../../layouts/Base.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Icon from '../../../components/Icon.astro';
import { setupGuide, emailLockdown, usd } from '../../../data/services';
// Where the Founder Stack Payment Link sends buyers after paying. noindex and in DRAFT_PAGES (out of the sitemap).
// Delivery is automatic: the payments Worker (workers/payments/src/deliver.js) emails the buyer the PDF from private
// Workers KV. The PDF is never in this repo or at any public URL. Google Ads (conv-founder.js) and Meta and Reddit Purchase events fire here via /js/ad-pixels.js only with offer=founder-stack and a cs_ session id.
---
<Base title="Thanks for buying the guide" description={`Thanks for buying ${setupGuide.name}.`} noindex>
  <PageHeader width="narrow" align="center" eyebrow="Guide · Thank you" crumbs={[{ href: '/', label: 'Home' }, { href: '/founders/', label: 'Founders' }, { label: 'Thank you' }]} class="status-head">
    <span class="status-mark" slot="title-before"><Icon name="check" /></span>
    <Fragment slot="title">Thanks, your payment went through.</Fragment>
    <p class="lede">Your copy of {setupGuide.name} is on its way to your inbox now, from {CONTACT_EMAIL}, with the PDF attached. It usually arrives within a few minutes, and Stripe sends your receipt separately. If it hasn't arrived within an hour, check spam, then email us.</p>
  </PageHeader>
  <div class="narrow status-body">
    <div class="callout" style="margin-bottom:1.25rem"><strong>Your included Email Authentication Setup</strong> ({usd(emailLockdown.from)} on its own): if you entered your domain at checkout, your report arrives within one business day. If not, reply to the email your guide arrives in with your domain. Want a head start? Run the free <a href={url('/founders/preflight/')} data-umami-event="founders-nav" data-umami-event-target="preflight-thanks" data-umami-event-track="founders">Launch Preflight</a> now.</div>
    <p class="status-actions"><a class="btn btn-primary" href={url('/founders/')}>Back to Founders</a> <a class="btn" href={`mailto:${CONTACT_EMAIL}`}>Email us</a></p>
  </div>
  <!-- Google Ads "Founder guide purchase" conversion. External file: no inline scripts. -->
  <script is:inline src={url('/js/conv-founder.js')}></script>
  <!-- Meta and Reddit ad pixels (PageView; Purchase only on a real Stripe checkout redirect). External file: no inline scripts. -->
  <script is:inline src={url('/js/ad-pixels.js')}></script>
</Base>
