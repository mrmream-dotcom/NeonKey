---
import { url } from '../../config';
import Base from '../../layouts/Base.astro';
import LaneHero from '../../components/ui/LaneHero.astro';
import Section from '../../components/ui/Section.astro';
import Button from '../../components/ui/Button.astro';
import DomainCheck from '../../components/DomainCheck.astro';
import WatchdogCta from '../../components/WatchdogCta.astro';
import TrustLine from '../../components/TrustLine.astro';
import { setupGuide, emailLockdown, usd } from '../../data/services';
import { buyAttrs } from '../../lib/checkout-ref';
import { LANE_NAMES } from '../../lib/lanes';
import { tutorialCards } from '../../data/learn-guides';
import { isLearnPathLive } from '../../lib/schedule.mjs';
// "Build Your Business" lane hub (full overhaul, Nov 14 2026). URL unchanged (/founders/).
// Order: the free domain check in the first screen (#check: the header button on founders pages points here), then
// the primary product, Email Authentication Setup ("just the email fix"), and the bigger option, The Founder Stack
// (the whole backend, includes one setup). Watchdog is only the "next" step, through WatchdogCta (a waitlist; nothing
// to buy). Umami events carry track=founders. Prices come from src/data/services.ts; buy buttons carry the checkout
// ref (src/lib/checkout-ref.ts), lane=founders.
const guides = ['/learn/emails-going-to-spam/', '/learn/dmarc-google-workspace/', '/learn/spf-dkim-dmarc-microsoft-365/']
  .map((h) => tutorialCards.find((c) => c.href === h)).filter((c): c is (typeof tutorialCards)[number] => Boolean(c) && isLearnPathLive(c!.href));
---
<Base title={`${LANE_NAMES.founders}: tools for founders`} lane="founders" description="Launching something? Check free that inboxes will trust your domain's email, then fix just the email records or set up the lean, automated backend NeonKey runs on with The Founder Stack.">
  <LaneHero lane="founders" crumbs={[{ href: '/', label: 'Home' }, { label: LANE_NAMES.founders }]} title="Launch on a domain inboxes trust." lede="Before your launch email or first outreach goes out, check your domain free. Then fix just the email records, or set up the whole backend NeonKey runs on.">
    <div class="fh-check" id="check">
      <DomainCheck placeholder="yourstartup.com" track="founders">
        <div slot="next" class="panel topline accent-magenta fd-next">
          <h2 class="fd-next-h">What to do next</h2>
          <p>Something to fix? Pick <a href="#fix" data-umami-event="founders-nav" data-umami-event-target="hub-fix" data-umami-event-track="founders">just the email fix or the whole backend</a> below.</p>
          <WatchdogCta from="founders-hub" lead="Everything passing?" />
        </div>
      </DomainCheck>
      <p class="fh-small">Free, no signup, about 30 seconds. Want the full write-up of each record? Open the <a href={url('/founders/preflight/')} data-umami-event="founders-nav" data-umami-event-target="preflight" data-umami-event-track="founders">Launch Preflight page</a>.</p>
    </div>
  </LaneHero>

  <Section id="fix" title="Two ways to fix it" intro="Start with the email records, or set up everything around them. Both are one-time, both are bought online with no call." size="sm">
    <div class="offer-grid">
      <article class="ds-card ds-card-md offer-card is-primary lane-founders">
        <span class="oc-badge">Just the email fix</span>
        <h3>{emailLockdown.name}</h3>
        <p class="oc-line">Your SPF, DKIM and DMARC records checked, then the exact records to add for your provider, or added for you if you invite NeonKey to your DNS.</p>
        <p class="oc-price">{usd(emailLockdown.from)}<small>one-time, one domain</small></p>
        <div class="btn-row">
          <Button {...buyAttrs(emailLockdown.buyUrl, { lane: 'founders', sku: 'email-auth-29', location: 'founders-hub-email-auth' })} rel="noopener" data-umami-event="buy-click" data-umami-event-offer={emailLockdown.name} data-umami-event-location="founders-hub-email-auth" data-umami-event-track="founders">Buy now · {usd(emailLockdown.from)}</Button>
          <Button href="/services/email-lockdown/" variant="ghost" data-umami-event="founders-nav" data-umami-event-target="email-auth" data-umami-event-track="founders">Details</Button>
        </div>
      </article>
      <article class="ds-card ds-card-md offer-card">
        <span class="oc-badge">The whole backend</span>
        <h3>{setupGuide.name}</h3>
        <p class="oc-line">{setupGuide.subtitle}, step by step: domain and email, website, Stripe, a self-delivering product, outreach and lead tracking. Includes one {emailLockdown.name}.</p>
        <p class="oc-price">{usd(setupGuide.price)}<small>one-time · PDF guide</small></p>
        <div class="btn-row">
          <Button {...buyAttrs(setupGuide.buyUrl, { lane: 'founders', sku: 'founder-stack-29', location: 'founders-hub' })} variant="secondary" rel="noopener" data-umami-event="buy-click" data-umami-event-offer={setupGuide.name} data-umami-event-location="founders-hub" data-umami-event-track="founders">Buy the guide · {usd(setupGuide.price)}</Button>
          <Button href="/founders/guide/" variant="ghost" data-umami-event="founders-nav" data-umami-event-target="guide" data-umami-event-track="founders">See what's inside</Button>
        </div>
      </article>
    </div>
  </Section>

  <Section id="next" title="Next: keep it working" size="sm">
    <div class="fh-next"><WatchdogCta from="founders-hub" variant="panel" /></div>
  </Section>

  {guides.length > 0 && (
    <Section id="guides" title="Rather do it yourself?" intro="Free step-by-step guides for the same records." size="sm">
      <ul class="link-grid">{guides.map((c) => <li><a href={url(c.href)}>{c.title}<span>{c.text}</span></a></li>)}</ul>
    </Section>
  )}

  <div class="container fh-end">
    <TrustLine location="founders-hub" />
    <p class="fh-cross">Run a small business rather than a startup? Start at <a href={url('/services/')}>{LANE_NAMES.smb}</a> instead.</p>
  </div>
</Base>
<style>
  .fh-check { margin-top: var(--space-6); max-width: 48rem; scroll-margin-top: 80px; }
  .fh-small { font-size: var(--text-sm); color: var(--color-text-muted); margin: var(--space-3) 0 0; }
  .fh-small a, .fh-cross a { color: var(--color-primary); }
  .fd-next p { margin: .4rem 0; }
  .fd-next-h { font-size: var(--text-lg); margin: 0 0 .4rem; }
  .fh-next { max-width: 40rem; }
  .fh-end { padding: var(--space-4) 0 var(--space-12); }
  .fh-cross { font-size: var(--text-sm); color: var(--color-text-muted); margin: var(--space-3) 0 0; }
</style>
