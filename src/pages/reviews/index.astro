---
import { url } from '../../config';
import Base from '../../layouts/Base.astro';
import EmptyState from '../../components/EmptyState.astro';
import CategoryBadge from '../../components/CategoryBadge.astro';
import { articlesIn } from '../../data/articles';
// Published reviews are articles with category 'reviews' in src/data/articles.ts (pages in src/pages/articles/).
// Unpublished drafts live in src/_drafts/reviews/ (see LAUNCH.md "Hidden drafts").
const reviews = articlesIn('reviews');
---
<Base title="Reviews" description="NeonKey reviews: honest takes on gear and software, with clear affiliate disclosure.">
  <div class="container page-head">
    <span class="kicker">Unlock Deals</span>
    <h1>Reviews</h1>
    <p>Who a product is for, what's good, what isn't, and a plain verdict. Some links are affiliate links. That never changes the verdict. <a href={url('/disclosure/')}>Read the disclosure</a>.</p>
  </div>
  <div class="container">
    {reviews.length === 0 ? (
      <EmptyState what="reviews" location="reviews-empty" />
    ) : (
      <ul class="article-list">
        {reviews.map((a) => (
          <li class="article-card">
            <div class="article-card-tags">
              <CategoryBadge category={a.category} />
              {a.topic && <span class="tag">{a.topic}</span>}
            </div>
            <h2><a href={url(a.href)}>{a.title}</a></h2>
            <p>{a.description}</p>
            <span class="article-cta" aria-hidden="true">Read review <span class="arrow">→</span></span>
          </li>
        ))}
      </ul>
    )}
  </div>
</Base>
