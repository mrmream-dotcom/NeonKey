---
import '@fontsource-variable/geist/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/editorial.css';
import '../styles/components.css';
import '../styles/cinematic.css';
import Logo from '../components/Logo.astro';
import { IS_DEMO, SITE_NAME, DEFAULT_DESCRIPTION, UMAMI, CONTACT_EMAIL, url, absoluteUrl } from '../config';
import SocialLinks from '../components/SocialLinks.astro';
import { abTests } from '../data/ab-tests';
import { articles } from '../data/articles';
import { emailLockdown, setupGuide, followUpDesk, frontOfficePackage, remoteIt, remoteSupportPlan, usd } from '../data/services';
import { LANE_NAMES } from '../lib/lanes';
import { existsSync } from 'node:fs';
import type { Lane } from '../lib/checkout-ref';
interface Props {
  title: string;
  description?: string;
  /** Path of the social image relative to the site base. */
  image?: string;
  /** Force noindex for this page even in live mode (e.g. 404). */
  noindex?: boolean;
  type?: 'website' | 'article';
  /** Set false when the page prints its own JSON-LD (home, /local/). */
  schema?: boolean;
  /**
   * Which of the three lanes the page belongs to; picks the header button. Values match the Lane type in
   * src/lib/checkout-ref.ts. Left out, it follows the path: /founders/* is 'founders', /protect/ and /scam-checker/
   * are 'family', everything else 'smb' (Run Your Business, the default).
   */
  lane?: Lane;
}
const { title, description = DEFAULT_DESCRIPTION, image: imageProp, noindex = false, type = 'website', schema = true, lane: laneProp } = Astro.props;

// Current path relative to the base, e.g. "/lab/" for /NeonKey/lab/.
const baseNoSlash = import.meta.env.BASE_URL.replace(/\/$/, '');
const relPath = (Astro.url.pathname.startsWith(baseNoSlash) ? Astro.url.pathname.slice(baseNoSlash.length) : Astro.url.pathname) || '/';
const path = relPath.replace(/\/$/, '') || '/';
// Three entrances (Michael, Nov 14 2026 full overhaul): Protect Yourself, Build Your Business, Run Your Business,
// plus Learn. Names come from src/lib/lanes.ts. Lab, Articles and Newsletter live in the footer; no URL changed.
// `also` lists other paths that light up the same nav item (product pages that belong to the lane).
const nav = [
  { href: '/protect/', label: LANE_NAMES.family, lane: 'family', also: ['/scam-checker'] },
  { href: '/founders/', label: LANE_NAMES.founders, lane: 'founders', also: [] },
  { href: '/services/', label: LANE_NAMES.smb, lane: 'smb', also: ['/follow-up-desk', '/contact', '/free-it-kit'] },
  { href: '/learn/', label: 'Learn', lane: '', also: [] },
];
const under = (p: string) => path === p || path.startsWith(p + '/');
const isActive = (item: (typeof nav)[number]) => under(item.href.replace(/\/$/, '')) || item.also.some(under);
const lane: Lane = laneProp ?? (/^\/founders(\/|$)/.test(path) ? 'founders' : /^\/(scam-checker|protect)(\/|$)/.test(path) ? 'family' : 'smb');
// Header button follows the lane. Business (the default) keeps the original quote button and its Umami event.
const laneCta = {
  smb: { href: '/contact/', label: 'Get a written quote', event: 'contact-click' },
  founders: { href: '/founders/#check', label: 'Check my domain free', event: 'lane-cta' },
  family: { href: '/scam-checker/#check', label: 'Check a message', event: 'lane-cta' },
}[lane];
// Search results cut titles at about 60 characters, so long page titles drop the " | NeonKey" suffix.
const fullTitle = title === 'Home' ? 'NeonKey | Scam Checks, Founder Tools, Business Follow-Up' : `${title} | NeonKey`.length > 60 ? title : `${title} | NeonKey`;
const canonicalPath = relPath === '/' ? '/' : relPath.replace(/\/?$/, '/');
const canonical = absoluteUrl(canonicalPath, Astro.site);
// Link-preview image: the page's own image, else its branded card from public/og/ (npm run og), else the default.
const ogSlug = canonicalPath.replace(/^\/|\/$/g, '').replace(/\//g, '--') || 'home';
const ogCard = `/og/${ogSlug}.jpg`;
const hasOgCard = !imageProp && existsSync(`${process.cwd()}/public${ogCard}`); // builds run from the repo root
const image = imageProp || (hasOgCard ? ogCard : '/og-default.png');
const ogImage = absoluteUrl(image, Astro.site);
const abIds = abTests.map((t) => t.id);
const robots = IS_DEMO || noindex ? 'noindex, nofollow' : 'index, follow';

// Structured data (schema.org JSON-LD) for every indexable page: a WebPage (or Article) linked to the
// Organization and WebSite defined on the home page, plus a breadcrumb trail built from the URL.
const home = absoluteUrl('/', Astro.site);
const orgId = `${home}#organization`;
const crumbLabels: Record<string, string> = { 'security-plus': 'Security+ guide', lab: 'Lab', learn: 'Learn', articles: 'Articles', services: LANE_NAMES.smb, newsletter: 'Newsletter', contact: 'Contact', pay: 'Pay', founders: LANE_NAMES.founders, 'scam-checker': 'Free scam checker', protect: LANE_NAMES.family };
const segs = canonicalPath.split('/').filter(Boolean);
const crumbs = [{ name: 'Home', item: home }, ...segs.map((seg, i) => ({
  name: i === segs.length - 1 ? title : crumbLabels[seg] || seg.replace(/-/g, ' ').replace(/^./, (c) => c.toUpperCase()),
  item: absoluteUrl('/' + segs.slice(0, i + 1).join('/') + '/', Astro.site),
}))];
const article = type === 'article' ? articles.find((a) => canonicalPath === `/articles/${a.slug}/`) : undefined;
const pageNode: Record<string, unknown> = {
  '@type': type === 'article' ? 'Article' : 'WebPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: title,
  description,
  inLanguage: 'en',
  isPartOf: { '@id': `${home}#website` },
  publisher: { '@id': orgId },
  primaryImageOfPage: { '@type': 'ImageObject', url: ogImage },
  breadcrumb: { '@id': `${canonical}#breadcrumb` },
};
if (type === 'article') {
  pageNode.headline = title.length > 110 ? title.slice(0, 107) + '...' : title;
  pageNode.image = ogImage;
  pageNode.mainEntityOfPage = canonical;
  pageNode.author = article?.author && article.author !== 'NeonKey' ? { '@type': 'Person', name: article.author, url: absoluteUrl('/about/', Astro.site) } : { '@id': orgId };
  if (article?.date) { pageNode.datePublished = article.date; pageNode.dateModified = article.date; }
}
const pageJsonLd = schema && !noindex && !IS_DEMO && canonicalPath !== '/'
  ? JSON.stringify({ '@context': 'https://schema.org', '@graph': [
      pageNode,
      { '@type': 'BreadcrumbList', '@id': `${canonical}#breadcrumb`, itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.item })) },
    ] }).replace(/</g, '\\u003c')
  : '';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- Hides the page headline for the split-text intro only when motion will run (motion.ts reveals it; CSS shows it after 2.5s if the script never arrives). Hashed into the CSP by csp-meta. -->
    <script is:inline>if(!matchMedia('(prefers-reduced-motion: reduce)').matches)document.documentElement.classList.add('motion-pending');</script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {abIds.length > 0 && (
      // A/B split (src/data/ab-tests.ts). Runs before paint so the other variant never flashes.
      <script is:inline define:vars={{ abIds }}>
        (function () {
          var d = document.documentElement, k = 'nk-ab', s = {}, v = {};
          try { s = JSON.parse(localStorage.getItem(k) || '{}') || {}; } catch (e) {}
          var q = {};
          (new URLSearchParams(location.search).get('ab') || '').split(',').forEach(function (p) {
            var x = p.split(':'); if (x[1] === 'a' || x[1] === 'b') q[x[0]] = x[1];
          });
          abIds.forEach(function (id) {
            if (s[id] !== 'a' && s[id] !== 'b') s[id] = Math.random() < 0.5 ? 'a' : 'b';
            v[id] = q[id] || s[id];
            d.setAttribute('data-ab-' + id, v[id]);
          });
          try { localStorage.setItem(k, JSON.stringify(s)); } catch (e) {}
          if (Object.keys(q).length) return; // previews are not counted
          document.addEventListener('DOMContentLoaded', function () {
            // seen = tests shown on this page; tag = every test this visitor has ever been shown, so a
            // later contact-form submit or pay click on another page still counts toward its variant.
            var seen = {}, tag = {}, ek = 'nk-ab-seen', ever = {};
            try { ever = JSON.parse(localStorage.getItem(ek) || '{}') || {}; } catch (e) {}
            abIds.forEach(function (id) {
              if (document.querySelector('[data-ab^="' + id + ':"]')) { seen[id] = v[id]; ever[id] = 1; }
              if (ever[id]) tag[id] = v[id];
            });
            try { localStorage.setItem(ek, JSON.stringify(ever)); } catch (e) {}
            document.querySelectorAll('[data-umami-event], [data-umami-submit]').forEach(function (el) {
              Object.keys(tag).forEach(function (id) { el.setAttribute('data-umami-event-ab-' + id, tag[id]); });
            });
            if (!Object.keys(seen).length) return;
            var tries = 0;
            (function send() {
              if (window.umami && window.umami.track) return window.umami.track('ab-view', seen);
              if (++tries < 20) setTimeout(send, 250);
            })();
          });
        })();
      </script>
    )}
    <meta name="robots" content={robots} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#0b0d17" />
    <meta name="impact-site-verification" value="e2d6ea6f-5c85-4a57-9433-4af8c38c571a" />
    <!-- Google tag (gtag.js): Google Ads AW-18547389944. Config lives in public/js/gtag-init.js (CSP blocks inline scripts). -->
    <!-- First-touch source for lead forms: where this visit started (page, utm tags, outside referrer).
         Kept in sessionStorage for this tab only; the contact form copies it into hidden fields. -->
    <script is:inline>try{if(!sessionStorage.getItem('nk_src')){var q=new URLSearchParams(location.search),r=document.referrer,x='';try{if(r&&new URL(r).host!==location.host)x=r.slice(0,200)}catch(e){}sessionStorage.setItem('nk_src',JSON.stringify({l:location.pathname.slice(0,120),u:['utm_source','utm_medium','utm_campaign'].map(function(n){return(q.get(n)||'').slice(0,60)}).join(' / '),r:x}))}}catch(e){}</script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-18547389944"></script>
    <script is:inline src={url('/js/gtag-init.js')}></script>
    <!-- Checkout attribution: first-touch UTMs, client_reference_id src on Stripe buy links, GA4 begin_checkout. External file (CSP). -->
    <script is:inline defer src={url('/js/checkout-attr.js')}></script>
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('/favicon-32x32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} sizes="180x180" />
    <link rel="manifest" href={url('/site.webmanifest')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={hasOgCard ? `${title === 'Home' ? 'Practical tech help' : title}, from NeonKey` : 'NeonKey: Unlock tech, whatever your level.'} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {pageJsonLd && <script type="application/ld+json" is:inline set:html={pageJsonLd}></script>}

    {UMAMI.websiteId && (
      <script is:inline defer src={UMAMI.src} data-website-id={UMAMI.websiteId} data-domains={UMAMI.domains || undefined}></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {/* No visible demo banner in any mode. PUBLIC_SITE_MODE=demo still means noindex + robots.txt Disallow. */}
    <header class="site-header">
      <div class="container header-inner">
        <a href={url('/')} class="brand" aria-label="NeonKey home"><Logo /></a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
          <span class="sr-only">Menu</span><span class="bars" aria-hidden="true"></span>
        </button>
        <nav id="site-nav" class="site-nav" aria-label="Main">
          <ul>
            {nav.map((item) => (
              <li><a href={url(item.href)} class={item.lane ? `lane-${item.lane}` : undefined} aria-current={isActive(item) ? 'page' : undefined} data-umami-event="nav-click" data-umami-event-target={item.lane || 'learn'}>{item.lane && <span class="nav-dot" aria-hidden="true"></span>}{item.label}</a></li>
            ))}
          </ul>
          <a href={url(laneCta.href)} class="btn btn-primary btn-sm nav-cta" data-umami-event={laneCta.event} data-umami-event-location="header" data-umami-event-lane={lane}>{laneCta.label}</a>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <Logo size={30} />
          <p>Practical tech help for families, founders and small businesses. Unlock tech, whatever your level.</p>
          <SocialLinks location="footer" />
        </div>
        <nav class="footer-col lane-family" aria-labelledby="ft-family">
          <h2 id="ft-family"><span class="lane-dot" aria-hidden="true"></span>{LANE_NAMES.family}</h2>
          <ul>
            <li><a href={url('/scam-checker/')} data-umami-event="lane-cta" data-umami-event-location="footer" data-umami-event-lane="family">Free scam checker</a></li>
            <li><a href={url('/protect/')} data-umami-event="nav-click" data-umami-event-target="family" data-umami-event-location="footer">Scam guides and checkups</a></li>
            <li><a href={url('/learn/is-this-a-scam/')}>Practice spotting scams</a></li>
          </ul>
        </nav>
        <nav class="footer-col lane-founders" aria-labelledby="ft-founders">
          <h2 id="ft-founders"><span class="lane-dot" aria-hidden="true"></span>{LANE_NAMES.founders}</h2>
          <ul>
            <li><a href={url('/founders/preflight/')} data-umami-event="founders-nav" data-umami-event-target="footer-preflight" data-umami-event-track="founders">Launch Preflight (free)</a></li>
            <li><a href={url('/founders/guide/')} data-umami-event="founders-nav" data-umami-event-target="footer-guide" data-umami-event-track="founders">{setupGuide.name} ({usd(setupGuide.price)})</a></li>
            <li><a href={url('/founders/')} data-umami-event="founders-nav" data-umami-event-target="footer" data-umami-event-track="founders">All founder tools</a></li>
          </ul>
        </nav>
        <nav class="footer-col lane-smb" aria-labelledby="ft-smb">
          <h2 id="ft-smb"><span class="lane-dot" aria-hidden="true"></span>{LANE_NAMES.smb}</h2>
          <ul>
            <li><a href={url('/follow-up-desk/')} data-umami-event="services-cta" data-umami-event-location="footer-follow-up-desk">{followUpDesk.name}</a></li>
            <li><a href={url('/services/email-lockdown/')} data-umami-event="services-cta" data-umami-event-location="footer-lockdown">{emailLockdown.name} ({usd(emailLockdown.from)})</a></li>
            <li><a href={url('/services/#front-office-package')} data-umami-event="services-cta" data-umami-event-location="footer-front-office">{frontOfficePackage.name}</a></li>
            <li><a href={url('/services/remote-it/')} data-umami-event="services-cta" data-umami-event-location="footer-remote-it">{remoteIt.name}</a></li>
            <li><a href={url('/services/remote-it/#support-plan')} data-umami-event="services-cta" data-umami-event-location="footer-support-plan">{remoteSupportPlan.name}</a></li>
            <li><a href={url('/free-it-kit/')} data-umami-event="free-kit-cta" data-umami-event-location="footer">Free Starter IT Kit</a></li>
          </ul>
        </nav>
        <nav class="footer-col" aria-labelledby="ft-co">
          <h2 id="ft-co">NeonKey</h2>
          <ul>
            <li><a href={url('/about/')}>About</a></li>
            <li><a href={url('/learn/')}>Learn</a></li>
            <li><a href={url('/lab/')}>Lab</a></li>
            <li><a href={url('/articles/')}>Articles</a></li>
            <li><a href={url('/newsletter/')} data-umami-event="newsletter-cta" data-umami-event-location="footer">Newsletter</a></li>
            <li><a href={url('/reviews/')}>Reviews</a></li>
            <li><a href={url('/refer/')}>Refer a business</a></li>
            <li><a href={url('/contact/')} data-umami-event="contact-click" data-umami-event-location="footer">Contact</a></li>
            <li><a href={`mailto:${CONTACT_EMAIL}`} data-umami-event="contact-click" data-umami-event-location="footer-email">{CONTACT_EMAIL}</a></li>
          </ul>
        </nav>
        <div class="footer-fine">
          <span>&copy; {new Date().getFullYear()} NeonKey. Reviews are never paid placements; see the <a href={url('/disclosure/')}>disclosure</a>.</span>
          <span><a href={url('/privacy/')}>Privacy</a> · <a href={url('/terms/')}>Terms</a> · <a href={url('/refunds/')}>Refunds and cancellations</a> · <a href={url('/disclosure/')}>Disclosure</a></span>
        </div>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector('.nav-toggle');
      const nav = document.getElementById('site-nav');
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        nav?.classList.toggle('open', !open);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && nav?.classList.contains('open')) {
          nav.classList.remove('open');
          toggle?.setAttribute('aria-expanded', 'false');
          (toggle as HTMLElement | null)?.focus();
        }
      });
      document.querySelectorAll('form[data-offline-form]').forEach((form) => {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const note = form.querySelector('.form-note');
          if (note) note.textContent = 'This form is not connected yet, so nothing was sent. Please email instead.';
        });
      });
      // GA4 copy of a real lead submit (generate_lead), sent to GA4 only (not the Ads tag). The lane comes from a
      // data-umami-event-lane prop if the button has one, else from the page path. No form field values are sent.
      const laneFor = (p: string) => (/^\/founders(\/|$)/.test(p) ? 'founders' : /^\/(scam-checker|protect|learn)(\/|$)/.test(p) ? 'family' : 'smb');
      const gaLead = (form: string, lane?: string) => {
        try { (window as any).gtag?.('event', 'generate_lead', { send_to: 'G-425106TVS2', form, lane: lane || laneFor(location.pathname) }); } catch {}
      };
      // Lead forms: a submit button marked data-umami-submit="<event>" is counted when the form is actually
      // submitted (the browser has already checked the required fields), not on every click. A click on an
      // empty form used to count as a submit. Extra data-umami-event-* attributes (like the A/B tags) go along.
      document.addEventListener('submit', (e) => {
        const btn = ((e as SubmitEvent).submitter || (e.target as HTMLElement | null)?.querySelector('[data-umami-submit]')) as HTMLElement | null;
        const name = btn?.dataset.umamiSubmit;
        if (!btn || !name) return;
        const props: Record<string, string> = {};
        for (const a of Array.from(btn.attributes)) {
          if (a.name.startsWith('data-umami-event-')) props[a.name.slice('data-umami-event-'.length)] = a.value;
        }
        (window as any).umami?.track?.(name, props);
        gaLead(name, props.lane);
      }, true);
      // Newsletter (Kit): count a "newsletter-signup" only when a signup form is actually submitted
      // (the browser has already validated the email). Works for our own form and for Kit's JS embed,
      // which renders a form.formkit-form inside [data-nl-embed]. Confirmed subscribers are counted in Kit.
      document.addEventListener('submit', (e) => {
        const form = e.target as HTMLElement | null;
        const host = form?.closest('[data-nl-form], [data-nl-embed]') as HTMLElement | null;
        if (!host) return;
        (window as any).umami?.track?.('newsletter-signup', { form: host.dataset.form || '', provider: 'kit' });
        gaLead('newsletter-signup');
        // Mark this tab as having just submitted a signup. /js/conv-newsletter.js on /newsletter/thanks/ fires the
        // Google Ads conversion only when this mark exists (Kit redirects there only after it accepts the email),
        // then clears it, so a direct visit or a reload of the thanks page never counts.
        try {
          const rnd = (crypto as any)?.randomUUID?.() || String(Date.now()) + Math.random().toString(36).slice(2);
          sessionStorage.setItem('nk_nl_submit', JSON.stringify({ id: 'nl-' + rnd, t: Date.now() }));
        } catch {}
      }, true);
      // Contact form (Web3Forms): mark this tab when a contact form is actually submitted. Web3Forms redirects to
      // /contact/thanks/ only after it accepts the message, and /js/conv-contact.js there counts one confirmed
      // inquiry only when this mark exists, then clears it. So a submit attempt ("contact-submit"), a direct visit
      // and a reload of the thanks page never count as an accepted inquiry (audit Nov 7 2026, A5).
      document.addEventListener('submit', (e) => {
        const form = e.target as HTMLFormElement | null;
        const redirect = form?.querySelector<HTMLInputElement>('input[name="redirect"]')?.value || '';
        if (!form || !/\/contact\/thanks\/?$/.test(redirect)) return;
        try {
          const rnd = (crypto as any)?.randomUUID?.() || String(Date.now()) + Math.random().toString(36).slice(2);
          const topic = form.querySelector<HTMLSelectElement | HTMLInputElement>('[name="topic"]')?.value || '';
          sessionStorage.setItem('nk_contact_submit', JSON.stringify({ id: 'ct-' + rnd, t: Date.now(), topic: topic.slice(0, 60) }));
        } catch {}
      }, true);
    </script>
    <div class="grain" aria-hidden="true"></div>
    <script>import '../scripts/motion';</script>
  </body>
</html>
